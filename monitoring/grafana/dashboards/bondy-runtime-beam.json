{
  "uid": "bondy-runtime-beam",
  "title": "Bondy \u2014 Runtime / BEAM",
  "description": "Per-node BEAM VM runtime: schedulers, run-queue, memory, processes/ports, GC and I/O.",
  "tags": [
    "bondy",
    "runtime",
    "beam"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "bondy-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"bondy\"}, node)",
          "refId": "var-node"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "hide": 0,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "links": [
    {
      "title": "Cluster Overview",
      "type": "link",
      "url": "/d/bondy-cluster-overview",
      "icon": "dashboard",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Node detail \u2014 db / oplog / MST",
      "type": "link",
      "url": "/d/bondy-db-oplog-mst",
      "icon": "dashboard",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Router / WAMP",
      "type": "link",
      "url": "/d/bondy-router-wamp",
      "icon": "dashboard",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    }
  ],
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 115,
      "type": "row",
      "title": "BEAM VM",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 116,
      "type": "timeseries",
      "title": "VM memory (per node)",
      "datasource": {
        "type": "prometheus",
        "uid": "bondy-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (erlang_vm_memory_bytes{node=~\"$node\"})",
          "legendFormat": "{{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": true,
            "gradientMode": "none",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 117,
      "type": "timeseries",
      "title": "Scheduler time by state (msacc)",
      "datasource": {
        "type": "prometheus",
        "uid": "bondy-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "sum(rate(erlang_vm_msacc_emulator_seconds_total{node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "emulator",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "sum(rate(erlang_vm_msacc_gc_seconds_total{node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "gc",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "sum(rate(erlang_vm_msacc_check_io_seconds_total{node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "check_io",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "sum(rate(erlang_vm_msacc_port_seconds_total{node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "port",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "sum(rate(erlang_vm_msacc_aux_seconds_total{node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "aux",
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "sum(rate(erlang_vm_msacc_other_seconds_total{node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "other",
          "refId": "F"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "sum(rate(erlang_vm_msacc_sleep_seconds_total{node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "sleep",
          "refId": "G"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": true,
            "gradientMode": "none",
            "stacking": {
              "mode": "percent"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "BEAM scheduler wall-time share by microstate-accounting state. One query per state metric (multi-name rate() selectors collide after __name__ is dropped).",
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "erlang_vm_msacc_(.+)_seconds_total",
            "renamePattern": "$1"
          }
        }
      ]
    },
