{
  "uid": "bondy-mcp",
  "title": "Bondy \u2014 MCP Gateway",
  "description": "The MCP overlay: session handshakes, dispatched tools and resources, upstream calls, manifest builds, and the refusals (RBAC, version, drift) that stop a request before it runs.",
  "tags": [
    "bondy",
    "mcp",
    "gateway"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "bondy-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"bondy\"}, node)",
          "refId": "var-node"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "hide": 0,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "links": [
    {
      "title": "Cluster Overview",
      "type": "link",
      "url": "/d/bondy-cluster-overview",
      "icon": "dashboard",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Router / WAMP",
      "type": "link",
      "url": "/d/bondy-router-wamp",
      "icon": "dashboard",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Sessions",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active MCP sessions",
      "datasource": {
        "type": "prometheus",
        "uid": "bondy-prometheus"
      },
      "description": "Handshake-era sessions alive now: opened minus closed, reset by a node restart.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "sum(bondy_mcp_active_sessions{node=~\"$node\"}) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "In-flight calls",
      "datasource": {
        "type": "prometheus",
        "uid": "bondy-prometheus"
      },
      "description": "Dispatched MCP calls currently outstanding across realms and listeners.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "sum(bondy_mcp_inflight_calls{node=~\"$node\"}) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Session churn",
      "datasource": {
        "type": "prometheus",
        "uid": "bondy-prometheus"
      },
      "description": "Handshakes completed against terminations. Closes tracking opens with a flat active count is a reconnect loop.",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "sum(rate(bondy_mcp_session_opened_total{node=~\"$node\"}[5m]))",
          "legendFormat": "opened",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "sum by (reason) (rate(bondy_mcp_session_closed_total{node=~\"$node\"}[5m]))",
          "legendFormat": "closed {{reason}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "Dispatch \u2014 tools, resources & requests",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Dispatch rate",
      "datasource": {
        "type": "prometheus",
        "uid": "bondy-prometheus"
      },
      "description": "Tool calls, resource reads and resource subscribes, by realm. Status is carried on the tool and resource series, so a failing tool separates from a busy one.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "sum by (realm) (rate(bondy_mcp_tool_calls_total{node=~\"$node\"}[5m]))",
          "legendFormat": "tool calls {{realm}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "sum by (realm) (rate(bondy_mcp_resource_reads_total{node=~\"$node\"}[5m]))",
          "legendFormat": "resource reads {{realm}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "sum by (realm) (rate(bondy_mcp_resource_subscribes_total{node=~\"$node\"}[5m]))",
          "legendFormat": "subscribes {{realm}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Dispatch latency p95",
      "datasource": {
        "type": "prometheus",
        "uid": "bondy-prometheus"
      },
      "description": "Where a request's time goes: the whole request, the tool call inside it, and the resource read inside it. Request p95 well above both means the overhead is in the gateway, not the work.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "\u00b5s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, method) (rate(bondy_mcp_request_duration_microseconds_bucket{node=~\"$node\"}[5m])))",
          "legendFormat": "request {{method}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(bondy_mcp_tool_call_duration_microseconds_bucket{node=~\"$node\"}[5m])))",
          "legendFormat": "tool call",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(bondy_mcp_resource_read_duration_microseconds_bucket{node=~\"$node\"}[5m])))",
          "legendFormat": "resource read",
          "refId": "C"
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "Upstream",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Upstream calls & drift",
      "datasource": {
        "type": "prometheus",
        "uid": "bondy-prometheus"
      },
      "description": "Calls the gateway forwarded upstream, by status, against calls it refused because the upstream drifted from the manifest it was registered with.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "sum by (upstream, status) (rate(bondy_mcp_upstream_calls_total{node=~\"$node\"}[5m]))",
          "legendFormat": "{{upstream}} {{status}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "sum by (upstream) (rate(bondy_mcp_upstream_drift_blocked_total{node=~\"$node\"}[5m]))",
          "legendFormat": "drift blocked {{upstream}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Upstream call latency p95",
      "datasource": {
        "type": "prometheus",
        "uid": "bondy-prometheus"
      },
      "description": "Time spent in the upstream itself, per upstream. Subtract this from request p95 to see the gateway's own cost.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "\u00b5s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, upstream) (rate(bondy_mcp_upstream_call_duration_microseconds_bucket{node=~\"$node\"}[5m])))",
          "legendFormat": "p95 {{upstream}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "Manifest & refusals",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Manifest builds",
      "datasource": {
        "type": "prometheus",
        "uid": "bondy-prometheus"
      },
      "description": "Rebuild rate by what triggered it, the p95 cost of a rebuild, and the entries the current manifest holds. Rebuilds climbing with flat entries means churn producing the same manifest.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "sum by (trigger) (rate(bondy_mcp_manifest_rebuilds_total{node=~\"$node\"}[5m]))",
          "legendFormat": "rebuilds {{trigger}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(bondy_mcp_manifest_rebuild_duration_microseconds_bucket{node=~\"$node\"}[5m])))",
          "legendFormat": "rebuild p95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "sum by (kind) (bondy_mcp_manifest_entries{node=~\"$node\"})",
          "legendFormat": "entries {{kind}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Refusals & notifications",
      "datasource": {
        "type": "prometheus",
        "uid": "bondy-prometheus"
      },
      "description": "Requests stopped before they ran - RBAC denials by surface, refused protocol versions, and manifest name collisions - alongside notifications emitted. A collision has its own alarm; this is the rate behind it.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "sum by (surface) (rate(bondy_mcp_rbac_denied_total{node=~\"$node\"}[5m]))",
          "legendFormat": "rbac denied {{surface}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "sum by (version) (rate(bondy_mcp_version_refused_total{node=~\"$node\"}[5m]))",
          "legendFormat": "version refused {{version}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "sum by (kind) (rate(bondy_mcp_manifest_collisions_total{node=~\"$node\"}[5m]))",
          "legendFormat": "collisions {{kind}}",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "sum by (type) (rate(bondy_mcp_notifications_emitted_total{node=~\"$node\"}[5m]))",
          "legendFormat": "notifications {{type}}",
          "refId": "D"
        }
      ]
    }
  ]
}