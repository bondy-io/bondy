{
  "uid": "bondy-mail",
  "title": "Bondy \u2014 Mail",
  "description": "Outbound email: relay health, send RED metrics, failure nature, backpressure and retries. A relay that stops answering degrades mail only; routing is unaffected.",
  "tags": [
    "bondy",
    "mail",
    "egress"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Cluster Overview",
      "type": "link",
      "url": "/d/bondy-cluster-overview",
      "icon": "dashboard",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Router / WAMP",
      "type": "link",
      "url": "/d/bondy-router-wamp",
      "icon": "dashboard",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "bondy-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"bondy\"}, node)",
          "refId": "var-node"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "hide": 0,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 2,
      "type": "row",
      "title": "Relays",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Relays down",
      "datasource": {
        "type": "prometheus",
        "uid": "bondy-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(bondy_mail_relay_up{node=~\"$node\"} == 0) or vector(0)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "description": "Relays whose recent deliveries are failing. Set by consecutive TRANSIENT failures only: a rejected recipient does not mark a relay down.",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 1
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active relay alarms",
      "datasource": {
        "type": "prometheus",
        "uid": "bondy-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(bondy_alarm_active{node=~\"$node\", alarm_id=~\".*mail_relay_down.*\"}) or vector(0)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "description": "Raised after health.failure_threshold consecutive transient failures. Clears after health.success_threshold successes, which may lag recovery: delivery resumes on the first success.",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 4,
        "y": 1
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Relay status",
      "datasource": {
        "type": "prometheus",
        "uid": "bondy-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bondy_mail_relay_up{node=~\"$node\"}",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "color-background"
            }
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "description": "1 = recent deliveries succeeding, 0 = marked down.",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 1
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Queue depth by relay",
      "datasource": {
        "type": "prometheus",
        "uid": "bondy-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bondy_mail_queue_depth{node=~\"$node\"}",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "color-background"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "description": "Messages queued and not yet taken by a worker. A depth that does not return to zero means the relay cannot keep up with what is being sent to it.",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 1
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Send",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Accepted and sent",
      "datasource": {
        "type": "prometheus",
        "uid": "bondy-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(bondy_mail_accepted_total{node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "accepted",
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(bondy_mail_sent_total{node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "sent",
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "sum(rate(bondy_mail_failed_total{node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "failed",
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Accepted means validated, authorized and queued. The gap between accepted and sent+failed is what is still in flight.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Accepted by surface",
      "datasource": {
        "type": "prometheus",
        "uid": "bondy-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (surface) (rate(bondy_mail_accepted_total{node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "{{surface}}",
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "rpc = a client called bondy.mail.send. bridge = an event triggered it.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Send duration (quantiles)",
      "datasource": {
        "type": "prometheus",
        "uid": "bondy-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(bondy_mail_send_duration_milliseconds_bucket{node=~\"$node\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(bondy_mail_send_duration_milliseconds_bucket{node=~\"$node\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(bondy_mail_send_duration_milliseconds_bucket{node=~\"$node\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "The SMTP conversation only, including retries and the backoff between them. Time spent queued is the separate queue-wait panel.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      }
    },
