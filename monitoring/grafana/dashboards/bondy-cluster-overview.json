        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "sum(rate(bondy_oplog_sync_sessions_total{outcome=\"error\"}[5m])) or vector(0)",
          "refId": "A"
        }
      ]
    },
