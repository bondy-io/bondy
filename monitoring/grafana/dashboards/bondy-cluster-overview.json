    {
      "id": 6,
      "type": "stat",
      "title": "Instances DIVERGED",
      "description": "Instances whose frontier hash differs across nodes.",
      "datasource": {
        "type": "prometheus",
        "uid": "bondy-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
