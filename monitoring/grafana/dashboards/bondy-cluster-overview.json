        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "sum(increase(bondy_oplog_bootstrap_sessions_total{outcome=\"error\"}[15m])) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 27,
      "type": "stat",
      "title": "Sync error rate (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "bondy-prometheus"
      },
      "description": "Current AE sync failure rate. Decays to green within ~5m of the last error \u2014 persistent amber/red means sessions are failing NOW.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "links": [
            {
              "title": "Cluster Sync / AAE \u2014 drill down",
              "url": "/d/bondy-cluster-sync?${__url_time_range}"
            }
