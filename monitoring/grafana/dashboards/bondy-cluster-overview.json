        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "sum(increase(bondy_oplog_sync_oversized_item_total[15m])) or vector(0)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 24,
      "type": "row",
      "title": "AE / sync health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 25,
      "type": "stat",
      "title": "Standing frontier gaps",
      "datasource": {
        "type": "prometheus",
        "uid": "bondy-prometheus"
      },
      "description": "Gap verdicts in the last 15m WHILE the cluster is currently diverged \u2014 a standing gap that has not healed. A verdict that already healed (re-bootstrap completed, frontiers converged) reads 0 here; the recent-event history lives on the Cluster Sync / AAE dashboard. Non-zero = the system is telling you it could not self-heal \u2014 drill in.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "links": [
            {
              "title": "Cluster Sync / AAE \u2014 drill down",
              "url": "/d/bondy-cluster-sync?${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "sum(increase(bondy_oplog_frontier_gap_verdicts_total[15m])) and on() (count(count by (instance_id)(count_values by (instance_id)(\"h\", bondy_oplog_instance_frontier_hash) > 0) > 1) > 0) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 26,
      "type": "stat",
      "title": "Re-bootstraps failing (15m)",
      "datasource": {
        "type": "prometheus",
        "uid": "bondy-prometheus"
      },
      "description": "Catalogue (re-)bootstrap sessions that FAILED in the last 15m. Scheduled re-bootstraps that completed ok are the system healing itself (e.g. a stale rejoin) and stay green here \u2014 see Cluster Sync / AAE for the full scheduled/ok/error history.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "links": [
            {
              "title": "Cluster Sync / AAE \u2014 drill down",
              "url": "/d/bondy-cluster-sync?${__url_time_range}"
            }
