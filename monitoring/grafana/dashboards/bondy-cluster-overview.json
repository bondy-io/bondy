{
  "uid": "bondy-cluster-overview",
  "title": "Bondy \u2014 Cluster Overview",
  "description": "Cluster-wide health at a glance: node up/down, Partisan connectivity, convergence, alarms, and per-node vital signs. Click any node/series to drill into its detail dashboard.",
  "tags": [
    "bondy",
    "cluster",
    "overview"
  ],
  "timezone": "",
  "schemaVersion": 39,
  "version": 9,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "bondy-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"bondy\"}, node)",
          "refId": "node"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "links": [
    {
      "title": "Cluster Sync / AAE",
      "url": "/d/bondy-cluster-sync",
      "type": "link",
      "icon": "external link",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "asDropdown": false
    },
    {
      "title": "Node detail \u2014 db / oplog / MST",
      "type": "link",
      "tags": [],
      "url": "/d/bondy-db-oplog-mst",
      "icon": "external link",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Router / WAMP",
      "type": "link",
      "url": "/d/bondy-router-wamp",
      "icon": "dashboard",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Cluster Graph (topology)",
      "type": "link",
      "url": "/d/bondy-cluster-graph",
      "icon": "dashboard",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Runtime / BEAM",
      "type": "link",
      "url": "/d/bondy-runtime-beam",
      "icon": "dashboard",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "HTTP Connector",
      "type": "link",
      "url": "/d/bondy-http-connector",
      "icon": "dashboard",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    }
  ],
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Cluster state",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Nodes up",
      "description": "Scrape targets currently up.",
      "datasource": {
        "type": "prometheus",
        "uid": "bondy-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "count(up{job=\"bondy\",node=~\"$node\"} == 1) or vector(0)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Fully connected",
      "description": "Every member sees every other member (min across nodes).",
      "datasource": {
        "type": "prometheus",
        "uid": "bondy-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NO",
                  "color": "red"
                },
                "1": {
                  "text": "YES",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "bondy-prometheus"
          },
          "expr": "min(bondy_cluster_all_members_connected{node=~\"$node\"}) or vector(0)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Nodes ready",
      "description": "Nodes that finished boot and are serving.",
      "datasource": {
        "type": "prometheus",
        "uid": "bondy-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
