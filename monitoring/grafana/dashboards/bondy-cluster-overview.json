          "expr": "count(count by (instance_id) (count_values by (instance_id) (\"fh\", bondy_oplog_instance_frontier_hash{node=~\"$node\"})) > 1) or vector(0)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Oversized sync (15m)",
      "description": "AAE sync items too large to replicate. Raise cluster.max_message_size.",
      "datasource": {
        "type": "prometheus",
        "uid": "bondy-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
