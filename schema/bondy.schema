%% In addition to JSON and Msgpack, Bondy supports Erlang External Term Format
%% ("erl") and BERT ("bert") serializations.
%%
%% The WAMP v2 Raw Socket protocol defines a code (integer from 1..15) for each
%% serializer, and specifies json and msgpack to be assigned to slots 1 and 2
%% respectively, leaving the remaining 13 slots for future assignment.
%%
%% Because some clients might be hardcoded to expect certain serializers in
%% certain slots, we need to make the slots assigned to "erl" and "bert"
%% configurable.
%%
%% For example, in order to assign the erl serializer to a slot 15 and bert
%% to slot 4 we write the following configuration line:
%%
%% wamp.serializers.erl = 15
%% wamp.serializers.bert = 4
{mapping, "wamp.serializers.erl",
"bondy_router.wamp_serializers.erl", [
  {datatype, integer},
  {default, 15}
]}.

{mapping, "wamp.serializers.bert",
"bondy_router.wamp_serializers.bert", [
  {datatype, integer},
  {default, 4}
]}.

% {translation,
% "bondy_router.wamp_serializers",
% fun(Conf0) ->
%     Conf1 = cuttlefish_variable:filter_by_prefix(
%       "wamp.serializers", Conf0),
%     Fun = fun ({[_, _, _, Key], Value}, Acc) ->
%       case lists:member(Key, ["erl", "bert"]) of
%         true when is_integer(Value) andalso (Value >= 3 orelse Value =< 15) ->
%           [{Value, list_to_atom(Key)} | Acc];
%         true ->
%           cuttlefish:invalid("value should be an integer between 3 and 15");
%         false ->
%           cuttlefish:invalid("key should be one of 'erl' or 'bert'")
%       end
%     end,
%     lists:foldl(Fun, [], Conf1)
% end}.


%% =============================================================================
%% WAMP WEBSOCKET
%% =============================================================================

%% @doc Defines if Websockets PING control message functionality is
%% enabled or not.
%% This option affects server (Bondy) initiated pings only. Some clients
%% might also initiate ping requests and Bondy will always respond to those
%% even if this option is turned off.
%% This feature is useful to keep a connection alive and validate the
%% connection is healthy.
%% Enabling this feature implies having an additional timer per connection and
%% this can be a considerable cost for servers that need to handle large
%% numbers of connections. A better solution in most cases is to let the client
%% handle pings. However, notice web browsers will typically kill websocket
%% connections after 60s and will not initiate PINGs.
{mapping, "wamp.websocket.ping.enabled",
"bondy_router.wamp_websocket.ping.enabled", [
  {default, on},
  {datatype, {flag, on, off}}
]}.

%% @doc If wamp.websocket.ping.enabled is 'on', this parameter controls the
%% maximum time interval that is permitted to elapse between the point at which
%% the Client finishes transmitting a message and the point it starts sending
%% the next.
%% Notice this is not the same as wamp.websocket.idle_timeout.
{mapping, "wamp.websocket.ping.idle_timeout",
"bondy_router.wamp_websocket.ping.idle_timeout", [
  {default, "20s"},
  {datatype, {duration, ms}}
]}.

%% @doc If wamp.websocket.ping.enabled is 'on', this parameter controls the
%% amount of time Bondy waits for a ping response from the client.
%% Once that time has passed this counts as a fail attempt
%% (see wamp.websocket.ping.max_attempts).
{mapping, "wamp.websocket.ping.timeout",
"bondy_router.wamp_websocket.ping.timeout", [
  {default, "10s"},
  {datatype, {duration, ms}}
]}.

%% @doc If wamp.websocket.ping.enabled is 'on', this parameter controls how many
%% missed pings are allowed to timeout before Bondy closes the connection.
{mapping, "wamp.websocket.ping.max_attempts",
"bondy_router.wamp_websocket.ping.max_attempts",
  [
    {default, 2},
    {datatype, integer},
    {validators, ["pos_integer"]}
  ]
}.

%% @doc Drops the connection after a period of inactivity. This option does not
%% take effect when wamp.websocket.ping.enabled is 'on' and wamp.websocket.ping.
%% interval times wamp.websocket.ping.max_attempts results in a value higher
%% than this option.
%% Notice that for some clients using this option alone is not enough to keep
%% a connection alive as the client will drop the connection due to inactivity.
%% If the client supports Websocket PING control messages, enabled them,
%% otherwise e.g. web browsers set wamp.websocket.ping.enabled to on.
{mapping, "wamp.websocket.idle_timeout",
"bondy_router.wamp_websocket.idle_timeout", [
  {default, "8h"},
  {datatype, [{duration, ms}, {atom, infinity}]}
]}.


%% Maximum frame size allowed by this Websocket handler. Cowboy will close the
%% connection when a client attempts to send a frame that goes over this limit.
%% For fragmented frames this applies to the size of the reconstituted frame.
%%
%% A value of zero means un unbounded size (internally translated to 'infinity')
{mapping, "wamp.websocket.max_frame_size",
"bondy_router.wamp_websocket.max_frame_size", [
  {default, "4MB"},
  {datatype, bytesize}
]}.


%% Has NO effect since Cowboy 2.13: a WebSocket connection always inherits
%% the dynamic buffer of the LISTENER it arrived on (Cowboy overrides any
%% handler-supplied value), so configure the listener's buffer options
%% instead (e.g. api_gateway.http.buffer.min/max). The mappings are kept so
%% existing configuration files still parse.
{mapping, "wamp.websocket.buffer.min",
"bondy_router.wamp_websocket.protocol_opts.dynamic_buffer.min", [
  {datatype, bytesize}
]}.

{mapping, "wamp.websocket.buffer.max",
"bondy_router.wamp_websocket.protocol_opts.dynamic_buffer.max", [
  {datatype, bytesize}
]}.



% {translation, "bondy_router.wamp_websocket.max_frame_size",
%  fun(Conf) ->
%   TheLimit = cuttlefish:conf_get("wamp.websocket.max_frame_size", Conf),
%   case TheLimit of
%       0 -> infinite;
%       Int when is_integer(Int) andalso Int > 0 -> Int;
%       _ ->
%           %% This would have been caught earlier in datatype validation
%           cuttlefish:invalid("should be a non negative integer")
%   end
%  end
% }.


%% Defines if Websocket compression (permessage-deflate extension) is enabled
%% or not. If enabled it will be negotiated with supporting clients.
{mapping, "wamp.websocket.compression_enabled",
"bondy_router.wamp_websocket.compress", [
  {default, off},
  {datatype, {flag, on, off}}
]}.


%% Compression level to use. A value between 0 and 9
%% * 0 (none), gives no compression
%% * 1 (best_speed) gives best speed
%% * 9 (best_compression) gives best compression
{mapping, "wamp.websocket.deflate.level",
"bondy_router.wamp_websocket.deflate_opts.level", [
  {default, 5},
  {datatype, integer}
]}.

{translation, "bondy_router.wamp_websocket.deflate_opts.level",
 fun(Conf) ->
  case cuttlefish:conf_get("wamp.websocket.deflate.level", Conf) of
      Int when is_integer(Int) andalso Int >= 0 andalso Int =< 9 -> Int;
      _ ->
          %% This would have been caught earlier in datatype validation
          cuttlefish:invalid(
            "should be an integer between 0 and 9")
  end
 end
}.

%% Specifies how much memory is to be allocated for the internal compression
%% state. An integer between 1 and 9, where 1 uses minimum memory but is slow
%% and reduces compression ratio while 9 uses maximum memory for optimal speed.
{mapping, "wamp.websocket.deflate.mem_level",
"bondy_router.wamp_websocket.deflate_opts.mem_level", [
  {default, 8},
  {datatype, integer}
]}.

{translation, "bondy_router.wamp_websocket.deflate_opts.mem_level",
 fun(Conf) ->
  case cuttlefish:conf_get("wamp.websocket.deflate.mem_level", Conf) of
      Int when is_integer(Int) andalso Int >= 1 andalso Int =< 9 -> Int;
      _ ->
          %% This would have been caught earlier in datatype validation
          cuttlefish:invalid(
            "should be an integer between 1 and 9")
  end
 end
}.

%% Tunes the compression algorithm. Use the following values:
%%  -   default for normal data
%%  -   filtered for data produced by a filter (or predictor)
%%  -   huffman_only to force Huffman encoding only (no string match)
%%  -   rle to limit match distances to one (run-length encoding)
%%
%% Filtered data consists mostly of small values with a somewhat random
%% distribution. In this case, the compression algorithm is tuned to compress
%% them better. The effect of filtered is to force more Huffman coding and less
%% string matching; it is somewhat intermediate between default and
%% huffman_only. rle is designed to be almost as fast as huffman_only, but
%% gives better compression for PNG image data.
%%
%% Strategy affects only the compression ratio, but not the correctness of the
%% compressed output even if it is not set appropriately.
{mapping, "wamp.websocket.deflate.strategy",
"bondy_router.wamp_websocket.deflate_opts.strategy", [
  {default, default},
  {datatype, {enum, [default, filtered, huffman_only, rle]}}
]}.

%%  Using no_takeover can severely limit the usefulness of compression.
{mapping, "wamp.websocket.deflate.server_context_takeover",
"bondy_router.wamp_websocket.deflate_opts.server_context_takeover", [
  {default, takeover},
  {datatype, {enum, [takeover, no_takeover]}}
]}.

%%  Using no_takeover can severely limit the usefulness of compression.
{mapping, "wamp.websocket.deflate.client_context_takeover",
"bondy_router.wamp_websocket.deflate_opts.client_context_takeover", [
  {default, takeover},
  {datatype, {enum, [takeover, no_takeover]}}
]}.

%% The base two logarithm of the window size (the size of the history buffer).
%% It is to be in the range 8 through 15. Larger values result in better
%% compression at the expense of memory usage.
{mapping, "wamp.websocket.deflate.server_max_window_bits",
"bondy_router.wamp_websocket.deflate_opts.server_max_window_bits", [
  {default, 11},
  {datatype, integer}
]}.

{translation, "bondy_router.wamp_websocket.deflate_opts.server_max_window_bits",
 fun(Conf) ->
  case cuttlefish:conf_get("wamp.websocket.deflate.server_max_window_bits", Conf) of
      Int when is_integer(Int) andalso Int >= 8 andalso Int =< 15 -> Int;
      _ ->
          cuttlefish:invalid(
            "should be an integer between 8 and 15")
  end
 end
}.

%% The base two logarithm of the window size (the size of the history buffer).
%% It is to be in the range 8 through 15. Larger values result in better
%% compression at the expense of memory usage.
{mapping, "wamp.websocket.deflate.client_max_window_bits",
"bondy_router.wamp_websocket.deflate_opts.client_max_window_bits", [
  {default, 11},
  {datatype, integer}
]}.

{translation, "bondy_router.wamp_websocket.deflate_opts.client_max_window_bits",
 fun(Conf) ->
  case cuttlefish:conf_get("wamp.websocket.deflate.client_max_window_bits", Conf) of
      Int when is_integer(Int) andalso Int >= 8 andalso Int =< 15 -> Int;
      _ ->
          cuttlefish:invalid(
            "should be an integer between 8 and 15")
  end
 end
}.

%% Max queued messages per transport
{mapping, "wamp.transport_queue.max_messages",
"bondy_router.transport_queue.max_messages", [
    {default, 1000},
    {datatype, integer},
    {validators, ["pos_integer"]}
]}.

%% Max queued bytes per transport
{mapping, "wamp.transport_queue.max_bytes",
"bondy_router.transport_queue.max_bytes", [
    {default, "10MB"},
    {datatype, bytesize}
]}.

%% TTL for individual messages
{mapping, "wamp.transport_queue.message_ttl",
"bondy_router.transport_queue.message_ttl", [
  {default, "5m"},
  {datatype, {duration, ms}}
]}.

%% Session idle timeout — auto-closes the transport session if no HTTP request
%% touches it within this window
{mapping, "wamp.transport_queue.transport_ttl",
"bondy_router.transport_queue.transport_ttl", [
  {default, "1h"},
  {datatype, {duration, ms}}
]}.

%% How often the TTL eviction sweep runs
{mapping, "wamp.transport_queue.eviction_interval",
"bondy_router.transport_queue.eviction_interval", [
  {default, "5s"},
  {datatype, {duration, ms}}
]}.

%% How often the TTL eviction sweep runs
{mapping, "wamp.transport_queue.partitions",
"bondy_router.transport_queue.partitions", [
    {datatype, integer},
    {validators, ["pos_integer"]}
]}.

%% What to do when queue limits are exceeded
{mapping, "wamp.transport_queue.overflow_strategy",
"bondy_router.transport_queue.overflow_strategy", [
  {default, drop_oldest},
  {datatype, {enum, [drop_oldest]}}
]}.

%% =============================================================================
%% WAMP LONGPOLL
%% =============================================================================

%% How long a `/wamp/longpoll/:transport_id/receive` request blocks waiting for
%% messages before returning an empty 204. This MUST be strictly less than
%% `wamp.longpoll.idle_timeout`, otherwise Cowboy may close the connection
%% before the longpoll reply is sent, stripping the response (including CORS
%% headers) that browser clients depend on.
{mapping, "wamp.longpoll.poll_timeout",
"bondy_router.wamp_longpoll.poll_timeout", [
  {default, "30s"},
  {datatype, {duration, ms}}
]}.

%% Cowboy HTTP connection idle timeout for `/wamp/longpoll/\*` endpoints. It
%% MUST be strictly greater than `wamp.longpoll.poll_timeout` so the server has
%% time to reply before the connection is torn down for inactivity.
{mapping, "wamp.longpoll.idle_timeout",
"bondy_router.wamp_longpoll.idle_timeout", [
  {default, "10m"},
  {datatype, {duration, ms}}
]}.

{mapping, "wamp.longpoll.reset_idle_timeout_on_send",
"bondy_router.wamp_longpoll.reset_idle_timeout_on_send", [
  {default, on},
  {datatype, {flag, on, off}}
]}.

%% =============================================================================
%% WAMP SSE
%% =============================================================================

{mapping, "wamp.sse.ping.enabled",
"bondy_router.wamp_sse.ping.enabled", [
  {default, on},
  {datatype, {flag, on, off}}
]}.

%% Interval between SSE keepalive comments (`:keepalive\n\n`) sent to prevent
%% intermediary timeouts
{mapping, "wamp.sse.ping.interval",
"bondy_router.wamp_sse.ping.interval", [
  {default, "20s"},
  {datatype, {duration, ms}}
]}.

{mapping, "wamp.sse.idle_timeout",
"bondy_router.wamp_sse.idle_timeout", [
  {default, "10m"},
  {datatype, {duration, ms}}
]}.

{mapping, "wamp.sse.reset_idle_timeout_on_send",
"bondy_router.wamp_sse.reset_idle_timeout_on_send", [
  {default, on},
  {datatype, {flag, on, off}}
]}.



%% =============================================================================
%% WAMP RAW SOCKET
%% =============================================================================



{mapping, "wamp.tcp.enabled",
"bondy_router.wamp_tcp.enabled", [
  {default, on},
  {datatype, {flag, on, off}}
]}.

%% @doc wamp.tcp.port is the TCP port that Bondy uses for
%% exposing the WAMP raw socket transport
{mapping, "wamp.tcp.port",
"bondy_router.wamp_tcp.transport_opts.socket_opts.port", [
  {default, 18082},
  {validators, ["port_number"]},
  {datatype, integer}
]}.

%% @doc wamp.tcp.ip is the IP address that Bondy uses for
%% exposing the WAMP raw socket transport. When the host has many network
%% interfaces, this option specifies which one to listen on.
{mapping, "wamp.tcp.ip",
"bondy_router.wamp_tcp.transport_opts.ip", [
  {datatype, string},
  {validators, ["ip_address"]}
]}.

%% @doc The IP version to use. Either 4 or 6.
{mapping, "wamp.tcp.ip_version",
"bondy_router.wamp_tcp.transport_opts.socket_opts.ip_version", [
  {default, "4"},
  {datatype, string}
]}.

{translation, "bondy_router.wamp_tcp.transport_opts.socket_opts.ip_version",
  fun(Conf) ->
    Value =  cuttlefish:conf_get("wamp.tcp.ip_version", Conf),
      try
        case string:strip(Value) of
          "4" -> 'inet';
          "6" -> 'inet6';
          _ -> throw(invalid_version)
        end
      catch
        throw:invalid_version ->
          cuttlefish:invalid(
            "Invalid IP version: "
            ++ Value
            ++ " . Value should be 4 or 6."
          )
      end
  end
}.

%% The ranch acceptors_pool_size for the WAMP raw socket tcp listener
{mapping, "wamp.tcp.acceptors_pool_size",
"bondy_router.wamp_tcp.transport_opts.num_acceptors", [
  {datatype, integer},
  {validators, ["pos_integer"]},
  {default, 200}
]}.

%% The ranch max number of connections for the WAMP raw socket tcp listener
{mapping, "wamp.tcp.max_connections",
"bondy_router.wamp_tcp.transport_opts.max_connections", [
  {datatype, integer},
  {validators, ["pos_integer"]},
  {default, 100000}
]}.

%% The maximum length that the queue of pending connections can grow to.
{mapping, "wamp.tcp.backlog",
"bondy_router.wamp_tcp.transport_opts.socket_opts.backlog", [
  {datatype, integer},
  {validators, ["pos_integer"]},
  {default, 1024}
]}.

%% TCP SOCKET OPTS

%% Enables/disables periodic transmission on a connected socket when no other
%% data is exchanged. If the other end does not respond, the connection is
%% considered broken and an error message is sent to the controlling process.
{mapping, "wamp.tcp.keepalive",
"bondy_router.wamp_tcp.transport_opts.socket_opts.keepalive", [
  {datatype, {flag, on, off}},
  {default, on}
]}.

{mapping, "wamp.tcp.linger.timeout",
"bondy_router.wamp_tcp.transport_opts.socket_opts.linger_timeout", [
  {default, "1s"},
  {validators, ["duration or -1..0"]},
  {datatype, [{duration, ms}, integer]}
]}.

%% If Boolean == true, option TCP_NODELAY is turned on for the socket, which
%% means that also small amounts of data are sent immediately.
{mapping, "wamp.tcp.nodelay",
"bondy_router.wamp_tcp.transport_opts.socket_opts.nodelay", [
  {datatype, {flag, on, off}},
  {default, on}
]}.


%% {mapping, "wamp.tcp.reuseaddr",
%% "bondy_router.wamp_tcp.transport_opts.socket_opts.reuseaddr", [
%%   {datatype, {flag, on, off}},
%%   {default, on}
%% ]}.

{mapping, "wamp.tcp.reuseport",
"bondy_router.wamp_tcp.transport_opts.socket_opts.reuseport", [
  {datatype, {flag, on, off}},
  {default, off}
]}.

%% The minimum size of the send buffer to use for the socket.
{mapping, "wamp.tcp.sndbuf",
"bondy_router.wamp_tcp.transport_opts.socket_opts.sndbuf", [
  {datatype, bytesize}
]}.

%% The minimum size of the receive buffer to use for the socket.
{mapping, "wamp.tcp.recbuf",
"bondy_router.wamp_tcp.transport_opts.socket_opts.recbuf", [
  {datatype, bytesize}
]}.

%% The size of the user-level software buffer used by the driver.
%% Not to be confused with options sndbuf and recbuf, which correspond to the
%% Kernel socket buffers.
%% It is recommended to have val(buffer) >= max(val(sndbuf),val(recbuf)) to
%% avoid performance issues because of unnecessary copying.
%% val(buffer) is automatically set to the above maximum when values sndbuf or
%% recbuf are set.
{mapping, "wamp.tcp.buffer",
"bondy_router.wamp_tcp.transport_opts.socket_opts.buffer", [
  {datatype, bytesize}
]}.


%% @doc Defines if PING control message functionality is enabled or
%% not.
%% This option affects server (Bondy) initiated pings only. Some clients
%% might also initiate ping requests and Bondy will always respond to those
%% even if this option is turned off.
%% This feature is useful to keep a connection alive and validate the
%% connection is healthy.
%% Enabling this feature implies having an additional timer per connection and
%% this can be a considerable cost for servers that need to handle large
%% numbers of connections. A better solution in most cases is to let the client
%% handle pings.
{mapping, "wamp.tcp.ping.enabled",
"bondy_router.wamp_tcp.ping.enabled", [
{default, on},
{datatype, {flag, on, off}}
]}.

%% @doc If wamp.tcp.ping.enabled is 'on', this parameter controls the
%% maximum time interval that is permitted to elapse between the point at which
%% the Client finishes transmitting a message and the point it starts sending
%% the next.
%% Notice this is not the same as wamp.tcp.idle_timeout.
{mapping, "wamp.tcp.ping.idle_timeout",
"bondy_router.wamp_tcp.ping.idle_timeout", [
{default, "20s"},
{datatype, {duration, ms}}
]}.

%% @doc If wamp.tcp.ping.enabled is 'on', this parameter controls the
%% amount of time Bondy waits for a ping response from the client.
%% Once that time has passed this counts as a fail attempt
%% (see wamp.tcp.ping.max_attempts).
{mapping, "wamp.tcp.ping.timeout",
"bondy_router.wamp_tcp.ping.timeout", [
{default, "10s"},
{datatype, {duration, ms}}
]}.

%% @doc If wamp.tcp.ping.enabled is 'on', this parameter controls how many
%% missed pings are considered a timeout. Thus, after this number of attempts
%% Bondy will drop the connection.
{mapping, "wamp.tcp.ping.max_attempts",
"bondy_router.wamp_tcp.ping.max_attempts",
[
  {default, 2},
  {datatype, integer},
  {validators, ["pos_integer"]}
]
}.

%% @doc Drops the connection after a period of inactivity. This option does not
%% take effect when wamp.tcp.ping.enabled is 'on' and wamp.tcp.ping.
%% interval times wamp.tcp.ping.max_attempts results in a value higher
%% than this option.
%% Notice that for some clients using this option alone is not enough to keep
%% a connection alive as the client will drop the connection due to inactivity.
%% If the client supports tcp PING control messages, enabled them,
%% otherwise e.g. web browsers set wamp.tcp.ping.enabled to on.
{mapping, "wamp.tcp.idle_timeout",
"bondy_router.wamp_tcp.idle_timeout", [
{default, "8h"},
{datatype, [{duration, ms}, {atom, infinity}]}
]}.

%% @doc Enables or disables the TCP Proxy Protocol. This is used to capture
%% the source IP address which will be used for matching against RBAC Source
%% assignments.
{mapping, "wamp.tcp.proxy_protocol",
"bondy_router.wamp_tcp.proxy_protocol.enabled", [
  {datatype, {flag, on, off}},
  {default, off}
]}.

%% @doc Defines the mode in which Bondy operates when wamp.tcp.proxy_protocol is
%% enabled. If 'strict' a connection that is not using the Proxy Protocol or
%% with invalid headers will be dropped. If 'relaxed' the connection is
%% always accepted and Bondy will log when there is not Proxy Procotol header
%% or if it is invalid.
{mapping, "wamp.tcp.proxy_protocol.mode",
"bondy_router.wamp_tcp.proxy_protocol.mode", [
  {datatype, {enum, [strict, relaxed]}},
  {default, relaxed}
]}.





%% =============================================================================
%% WAMP RAWSOCKET TLS
%% =============================================================================



{mapping, "wamp.tls.enabled",
"bondy_router.wamp_tls.enabled", [
  {default, off},
  {datatype, {flag, on, off}}
]}.


%% @doc api_gateway.ssl.port is the TCP port that Bondy uses for
%% exposing the WAMP raw socket transport
{mapping, "wamp.tls.port",
"bondy_router.wamp_tls.transport_opts.socket_opts.port", [
  {default, 18085},
  {validators, ["port_number"]},
  {datatype, integer}
]}.

%% @doc wamp.tls.ip is the IP address that Bondy uses for
%% exposing the WAMP raw socket transport. When the host has many network
%% interfaces, this option specifies which one to listen on.
{mapping, "wamp.tls.ip",
"bondy_router.wamp_tls.transport_opts.ip", [
  {datatype, string},
  {validators, ["ip_address"]}
]}.

%% @doc The IP version to use. Either 4 or 6.
{mapping, "wamp.tls.ip_version",
"bondy_router.wamp_tls.transport_opts.socket_opts.ip_version", [
  {default, "4"},
  {datatype, string}
]}.

{translation, "bondy_router.wamp_tls.transport_opts.socket_opts.ip_version",
  fun(Conf) ->
    Value =  cuttlefish:conf_get("wamp.tls.ip_version", Conf),
      try
        case string:strip(Value) of
          "4" -> 'inet';
          "6" -> 'inet6';
          _ -> throw(invalid_version)
        end
      catch
        throw:invalid_version ->
          cuttlefish:invalid(
            "Invalid IP version: "
            ++ Value
            ++ " . Value should be 4 or 6."
          )
      end
  end
}.

%% The ranch acceptors_pool_size for the WAMP raw socket tcp listener
{mapping, "wamp.tls.acceptors_pool_size",
"bondy_router.wamp_tls.transport_opts.num_acceptors", [
  {datatype, integer},
  {default, 200}
]}.

%% The ranch max number of connections for the WAMP raw socket tcp listener
{mapping, "wamp.tls.max_connections",
"bondy_router.wamp_tls.transport_opts.max_connections", [
  {datatype, integer},
  {default, 100000}
]}.

%% The maximum length that the queue of pending connections can grow to.
{mapping, "wamp.tls.backlog",
"bondy_router.wamp_tls.transport_opts.socket_opts.backlog", [
  {datatype, integer},
  {default, 1024}
]}.


%% SOCKET OPTS

%% Enables/disables periodic transmission on a connected socket when no other
%% data is exchanged. If the other end does not respond, the connection is
%% considered broken and an error message is sent to the controlling process.
{mapping, "wamp.tls.keepalive",
"bondy_router.wamp_tls.transport_opts.socket_opts.keepalive", [
  {datatype, {flag, on, off}},
  {default, on}
]}.


{mapping, "wamp.tls.linger.timeout",
"bondy_router.wamp_tls.transport_opts.socket_opts.linger_timeout", [
  {default, "1s"},
  {validators, ["duration or -1..0"]},
  {datatype, [{duration, ms}, integer]}
]}.

%% If Boolean == true, option TCP_NODELAY is turned on for the socket, which
%% means that also small amounts of data are sent immediately.
{mapping, "wamp.tls.nodelay",
"bondy_router.wamp_tls.transport_opts.socket_opts.nodelay", [
  {datatype, {flag, on, off}},
  {default, on}
]}.


%% {mapping, "wamp.tls.reuseaddr",
%% "bondy_router.wamp_tls.transport_opts.socket_opts.reuseaddr", [
%%   {datatype, {flag, on, off}},
%%   {default, on}
%% ]}.

{mapping, "wamp.tls.reuseport",
"bondy_router.wamp_tls.transport_opts.socket_opts.reuseport", [
  {datatype, {flag, on, off}},
  {default, off}
]}.
%% The minimum size of the send buffer to use for the socket.
{mapping, "wamp.tls.sndbuf",
"bondy_router.wamp_tls.transport_opts.socket_opts.sndbuf", [
  {datatype, bytesize}
]}.

%% The minimum size of the receive buffer to use for the socket.
{mapping, "wamp.tls.recbuf",
"bondy_router.wamp_tls.transport_opts.socket_opts.recbuf", [
  {datatype, bytesize}
]}.

%% The size of the user-level software buffer used by the driver.
%% Not to be confused with options sndbuf and recbuf, which correspond to the
%% Kernel socket buffers.
%% It is recommended to have val(buffer) >= max(val(sndbuf),val(recbuf)) to
%% avoid performance issues because of unnecessary copying.
%% val(buffer) is automatically set to the above maximum when values sndbuf or
%% recbuf are set.
{mapping, "wamp.tls.buffer",
"bondy_router.wamp_tls.transport_opts.socket_opts.buffer", [
  {datatype, bytesize}
]}.


%% @doc Defines if PING control message functionality is enabled or
%% not. This option affects server (Bondy) initiated pings only. Some clients
%% might also initiate ping requests and Bondy will always respond to those
%% even if this option is turned off.
%% This feature is useful to keep a connection alive and validate the
%% connection is healthy.
%% Enabling this feature implies having an additional timer per connection and
%% this can be a considerable cost for servers that need to handle large
%% numbers of connections. A better solution in most cases is to let the client
%% handle pings.
{mapping, "wamp.tls.ping.enabled",
"bondy_router.wamp_tls.ping.enabled", [
{default, on},
{datatype, {flag, on, off}}
]}.

%% @doc If wamp.tls.ping.enabled is 'on', this parameter controls the interval
%% in which Bondy sends WebSockets PING control messages.
{mapping, "wamp.tls.ping.interval",
"bondy_router.wamp_tls.ping.interval", [
{default, "30s"},
{datatype, {duration, ms}}
]}.

%% @doc If wamp.tls.ping.enabled is 'on', this parameter controls the time
%% Bondy will wait for a ping response. Once that time has passed this counts
%% as a fail attempt (see max_attempts).
{mapping, "wamp.tls.ping.timeout",
"bondy_router.wamp_tls.ping.timeout", [
{default, "10s"},
{datatype, {duration, ms}}
]}.

%% @doc If wamp.tls.ping.enabled is 'on', this parameter controls how many
%% missed pings are considered a timeout. Thus, after this number of attempts
%% Bondy will drop the connection.
%% If the value is 'infinity' Bondy will never timeout based on missed pings.
{mapping,
"wamp.tls.ping.max_attempts",
"bondy_router.wamp_tls.ping.max_attempts",
[
  {default, 3},
  {datatype, [integer, {atom, infinity}]}
]
}.

%% @doc Drops the connection after a period of inactivity. This option does not
%% take effect when wamp.tls.ping.enabled is 'on' and wamp.tls.ping.
%% interval times wamp.tls.ping.max_attempts results in a value higher
%% than this option.
%% Notice that for some clients using this option alone is not enough to keep
%% a connection alive as the client will drop the connection due to inactivity.
%% If the client supports tls PING control messages, enabled them,
%% otherwise e.g. web browsers set wamp.tls.ping.enabled to on.
{mapping, "wamp.tls.idle_timeout",
"bondy_router.wamp_tls.idle_timeout", [
{default, "8h"},
{datatype, [{duration, ms}, {atom, infinity}]}
]}.

%% @doc Default cert location for https can be overridden
%% with the wamp.tls config variable, for example:
{mapping, "wamp.tls.certfile",
"bondy_router.wamp_tls.transport_opts.socket_opts.certfile", [
  {datatype, file},
  {default, "{{platform_etc_dir}}/keycert.pem"}
]}.

%% @doc Default key location for https can be overridden with the
%%wamp.tls config variable, for example:
{mapping, "wamp.tls.keyfile",
"bondy_router.wamp_tls.transport_opts.socket_opts.keyfile", [
  {datatype, file},
  {default, "{{platform_etc_dir}}/key.pem"}
]}.

%% @doc Default signing authority location for https can be overridden
%% with the wamp.tls config variable, for example:
{mapping, "wamp.tls.cacertfile",
"bondy_router.wamp_tls.transport_opts.socket_opts.cacertfile", [
  {datatype, file},
  {default, "{{platform_etc_dir}}/cacert.pem"}
]}.

%% @doc A comma separate list of TLS protocol versions that will be supported
%% At the moment Bondy only supports versions 1.2 and 1.3
{mapping, "wamp.tls.versions",
"bondy_router.wamp_tls.transport_opts.socket_opts.versions", [
  {datatype, string},
  {default, "1.3"}
]}.


{translation, "bondy_router.wamp_tls.transport_opts.socket_opts.versions",
  fun(Conf) ->
    case cuttlefish:conf_get("wamp.tls.versions", Conf) of
        Value when is_list(Value) ->
          try
            [
              begin
                case string:strip(Version) of
                  "1.2" -> 'tlsv1.2';
                  "1.3" -> 'tlsv1.3';
                  _ -> throw({invalid_version, Version})
                end
              end || Version <- string:split(Value, ",")
            ]
          catch
            throw:{invalid_version, Version} ->
              cuttlefish:invalid("invalid TLS version " ++ Version)
          end;
        _ ->
            cuttlefish:invalid(
              "value should be string containing valid comma separated version numbers e.g. \"1.2, 1.3\""
            )
    end
  end
}.

%% @doc SSL verification mode for WAMP TLS connections
{mapping, "wamp.tls.verify",
"bondy_router.wamp_tls.transport_opts.socket_opts.verify", [
  {datatype, {enum, [verify_peer, verify_none]}},
  {default, verify_none}
]}.

%% @doc Whether to reject connections where the client does not provide a
%% certificate when verify is set to verify_peer.
{mapping, "wamp.tls.fail_if_no_peer_cert",
"bondy_router.wamp_tls.transport_opts.socket_opts.fail_if_no_peer_cert", [
  {datatype, {flag, on, off}},
  {default, off}
]}.

%% @doc Enables or disables the TCP Proxy Protocol. This is used to capture
%% the source IP address which will be used for matching against RBAC Source
%% assignments.
{mapping, "wamp.tls.proxy_protocol",
"bondy_router.wamp_tls.proxy_protocol.enabled", [
  {datatype, {flag, on, off}},
  {default, off}
]}.

%% @doc Defines the mode in which Bondy operates when wamp.tls.proxy_protocol is
%% enabled. If 'strict' a connection that is not using the Proxy Protocol or
%% with invalid headers will be dropped. If 'relaxed' the connection is
%% always accepted and Bondy will log when there is not Proxy Procotol header
%% or if it is invalid.
{mapping, "wamp.tls.proxy_protocol.mode",
"bondy_router.wamp_tls.proxy_protocol.mode", [
  {datatype, {enum, [strict, relaxed]}},
  {default, relaxed}
]}.


%% =============================================================================
%% CLUSTERING
%% =============================================================================



%% @doc Defines whether a Bondy node should perform a cluster leave operation
%% automatically when it is being shutdown.
{mapping, "cluster.automatic_leave",
"bondy_router.automatic_leave", [
  {default, off},
  {datatype, flag}
]}.

%% @doc Defines a list of ip_address:port this node will use to listen for
%% incoming cluster connections. The value accepts the following input formats
%% - 192.168.50.174:18086
%% - [192.168.50.174:18086]
%% - 192.168.50.174:18086, 192.168.50.180:18086
%% - [192.168.50.174:18086, 192.168.50.180:18086]
%%
%% If this option is provided Partisan will ignore 'cluster.peer_port' but notice that the value for peer port is still required for some discovery strategies used by partisan_peer_discovery_agent e.g. dns discovery which
{mapping, "cluster.listen_addresses",
"partisan.listen_addrs", [
  {datatype, string}
]}.


{translation,

  "partisan.listen_addrs",
  fun(Conf0) ->
      Conf = cuttlefish_variable:filter_by_prefix(
        "cluster.listen_addresses", Conf0
      ),

      Parse = fun(Val, ForceList) ->
         case string:split(Val, ",") of
            [Val] when ForceList == true ->
              [list_to_binary(Val)];
            [Val] when ForceList == false ->
              list_to_binary(Val);
            L when is_list(L) ->
              [list_to_binary(E) || E <- L]
          end
      end,

      lists:foldl(
          fun
            ({["cluster", "listen_addresses"], Value0}, Acc) ->
              %% Remove empty spaces
              Value1 = unicode:characters_to_list(
                string:replace(Value0, " ", "", all)
              ),
              %% parse list
              case string:trim(Value1, both, "[]") of
                Value1 ->
                  %% No list, but maybe list without [ ]
                  [Parse(Value1, false) | Acc];
                Trimmed ->
                  %% A list
                  [Parse(Trimmed, true) | Acc]
              end;

            ({["cluster", "listen_addresses"], Value}, Acc) ->
              [list_to_binary(Value) | Acc]

          end,
          [],
          Conf
      )
  end
}.

%% @doc Defines the port to use for the cluster TCP connection
{mapping, "cluster.peer_ip",
"partisan.peer_ip", [
  {datatype, string},
  {validators, ["ip_address"]}
]}.

%% @doc Defines the port to use for the cluster TCP connection
{mapping, "cluster.peer_port",
"partisan.peer_port", [
  {default, 18086},
  {datatype, integer}
]}.

%% @doc Defines the default number of TCP connections for the cluster TCP stack
{mapping, "cluster.parallelism",
"partisan.parallelism", [
  {default, 1},
  {datatype, integer}
]}.

%% @doc Maximum size of an inter-node (Partisan peer) message. It bounds the
%% length-prefixed framing on both the connect and accept paths, so an oversized
%% frame is rejected before it is assembled or decoded — closing a
%% pre-authentication memory-exhaustion / decompression-bomb vector. A peer that
%% sends a frame over this cap has its connection closed (the socket reports
%% 'emsgsize') and is dropped from the active view until it reconnects. Raise it
%% only if the cluster legitimately exchanges peer messages larger than the
%% default, for example very large application broadcasts or anti-entropy deltas.
{mapping, "cluster.max_message_size",
"partisan.max_message_size", [
  {default, "64MB"},
  {datatype, bytesize}
]}.

{mapping, "cluster.channels.default.parallelism",
"bondy_router.channels.undefined.parallelism", [
  {default, 1},
  {datatype, integer}
]}.

{mapping, "cluster.channels.default.compression",
"bondy_router.channels.undefined.compression", [
  {default, off},
  {datatype, [flag, integer]}
]}.


{mapping, "cluster.channels.data.parallelism",
"bondy_router.channels.data.parallelism", [
  {default, 2},
  {datatype, integer}
]}.

{mapping, "cluster.channels.data.compression",
"bondy_router.channels.data.compression", [
  {default, off},
  {datatype, [flag, integer]}
]}.


{mapping, "cluster.channels.control_plane.parallelism",
"bondy_router.channels.partisan_membership.parallelism", [
  {default, 1},
  {datatype, integer}
]}.

{mapping, "cluster.channels.control_plane.compression",
"bondy_router.channels.partisan_membership.compression", [
  {default, on},
  {datatype, [flag, integer]}
]}.


{mapping, "cluster.channels.wamp_relay.parallelism",
"bondy_router.channels.wamp_relay.parallelism", [
  {default, 2},
  {datatype, integer}
]}.

{mapping, "cluster.channels.wamp_relay.compression",
"bondy_router.channels.wamp_relay.compression", [
  {default, false},
  {datatype, [flag, integer]}
]}.

