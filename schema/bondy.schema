%% =============================================================================
%% GENERAL
%% =============================================================================



%% -----------------------------------------------------------------------------
%% @doc Enables active anti-entropy (AAE) replication for the bondy_db storage
%% substrate — the live store for security (users / grants), realms, the API
%% gateway, the registry and more. When enabled the sync scheduler discovers
%% peers from the live Partisan cluster membership and runs sync sessions over
%% the dedicated Partisan AAE channel, converging each node's view of the
%% replicated tables. On by default. This is the single master switch: the sync
%% scheduler process always runs, but with AAE off
%% `bondy_app:maybe_setup_oplog_replication/0` wires no Partisan peer source, so
%% the scheduler has no peers and stays inert. A single-node deployment is
%% unaffected either way — it has no peer to sync with, and the authentication
%% freshness fence treats a lone node as vacuously fresh (see
%% `db.aae.fence.on_isolation`).
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.aae", "bondy_oplog.aae_enabled", [
  {datatype, {flag, on, off}},
  {default, on}
]}.

%% -----------------------------------------------------------------------------
%% @doc The interval between bondy_db sync scheduler ticks. Each tick the
%% scheduler asks the peer source for peers and dispatches sync sessions. Only
%% relevant when `db.aae` is on.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.aae.interval", "bondy_oplog.sync_interval_ms", [
  {datatype, {duration, ms}},
  {default, "500ms"}
]}.

%% -----------------------------------------------------------------------------
%% @doc Throttle live (post-bootstrap) syncs adaptively. A converged shard only
%% re-syncs to discover divergence; once its data has settled it has nothing to
%% pull, yet a naive scheduler still dispatches a session against every peer
%% every tick — the dominant steady-state cost of running AAE across many shards.
%% When on (default), each shard syncs at the tick interval while its data is
%% actively changing and backs off geometrically up to `db.aae.live_sync.max`
%% once it goes quiescent, resetting to the fast cadence the moment its data
%% moves again. Shards that back the authentication freshness fence are exempt
%% and always sync every tick, so this never affects auth availability. When
%% off, every live shard syncs every peer every tick (the historical
%% behaviour). Only relevant when `db.aae` is on.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.aae.live_sync", "bondy_oplog.live_sync_adaptive", [
  {datatype, {flag, on, off}},
  {default, on}
]}.

%% -----------------------------------------------------------------------------
%% @doc Upper bound on the adaptive live-sync poll interval. Once a shard goes
%% quiescent its sync cadence doubles each round up to this cap. Because bondy_db
%% apply propagates pull-only (no eager push), this cap is also the steady-state
%% cross-node convergence latency for a quiescent shard — set it below the
%% convergence SLA you need. The first poll that pulls anything resets the shard
%% to the fast cadence, so recovery is quick once it starts. Shards backing the
%% auth fence ignore this cap (they always sync every tick). Only relevant when
%% `db.aae` and `db.aae.live_sync` are on.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.aae.live_sync.max", "bondy_oplog.live_sync_max_ms", [
  {datatype, {duration, ms}},
  {default, "5s"}
]}.

%% -----------------------------------------------------------------------------
%% @doc Maximum number of AAE sync sessions allowed to run concurrently on this
%% node. AAE is background work subordinate to routing — this cap keeps it from
%% saturating the node. It governs SPEED and FAIRNESS, never the memory ceiling:
%% the per-round page batch is `db.aae.max_pages_in_flight` divided by this
%% value, so raising concurrency shrinks each session's batch and the node-wide
%% page budget stays fixed. More concurrency means more peers/shards make
%% progress at once (no shard starves behind a single serial sync), each running
%% slower — NOT more RAM. `1` serialises AAE; `3` is a sane fairness default.
%% Only relevant when `db.aae` is on.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.aae.max_concurrency", "bondy_oplog.aae_max_concurrency", [
  {datatype, integer},
  {default, 3}
]}.

%% -----------------------------------------------------------------------------
%% @doc Node-wide budget, in MST pages, for AAE reconciliation in flight at any
%% instant. This is the lever that bounds AAE's peak memory: a sync session
%% pulls missing pages in bounded rounds of
%% `this / db.aae.max_concurrency` pages, so total in-flight pages stay
%% ≈ this budget regardless of dataset size or concurrency. Larger = faster
%% sync, higher peak; smaller = gentler on RAM, slower. Only relevant when
%% `db.aae` is on.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.aae.max_pages_in_flight", "bondy_oplog.aae_max_pages_in_flight", [
  {datatype, integer},
  {default, 2048}
]}.

%% -----------------------------------------------------------------------------
%% @doc Yield AAE's throttleable dispatches while the node is busy. The
%% concurrency cap bounds AAE in aggregate; this adds the temporal dimension —
%% even within the cap, a routing load spike transiently defers AAE so background
%% reconciliation never steals scheduler time from the node's real job. When on,
%% the scheduler samples a node-load signal each tick and, while the node is
%% backlogged past `db.aae.load_run_queue_threshold`, skips the throttleable
%% dispatches (bootstrap snapshot ships and non-fence live syncs) for that tick;
%% in-flight sessions are never aborted and the deferred shards retry on the next
%% quiet tick. Shards backing the authentication freshness fence are exempt and
%% always sync, so this never affects auth availability. It cannot affect
%% correctness, only convergence latency under load. Off by default — the cap and
%% live throttle already keep AAE subordinate; enable it where routing latency is
%% sensitive to AAE scheduler pressure under load. Only relevant when `db.aae`
%% is on.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.aae.load_adaptive", "bondy_oplog.aae_load_adaptive", [
  {datatype, {flag, on, off}},
  {default, off}
]}.

%% -----------------------------------------------------------------------------
%% @doc Run-queue length per online scheduler — EWMA-smoothed across ticks — at
%% or above which AAE yields its throttleable dispatches (see
%% `db.aae.load_adaptive`). The signal is `erlang:statistics(run_queue)`
%% divided by the online scheduler count: the average number of ready processes
%% queued per scheduler. A healthy node hovers near 0–1; a sustained 2+ means
%% work is queuing faster than the schedulers drain it. Lower yields AAE sooner
%% (more protective of routing latency, slower convergence under load); higher
%% lets AAE work closer to saturation. Only consulted when both `db.aae` and
%% `db.aae.load_adaptive` are on.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.aae.load_run_queue_threshold",
 "bondy_oplog.aae_load_run_queue_threshold", [
  {datatype, float},
  {default, 2.0}
]}.

%% -----------------------------------------------------------------------------
%% @doc The number of peers the bondy_db sync scheduler samples from the
%% Partisan cluster membership each tick. Only relevant when `db.aae` is on.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.aae.fanout", "bondy_oplog.aae_fanout", [
  {datatype, integer},
  {default, 3}
]}.

%% -----------------------------------------------------------------------------
%% @doc The freshness bound for the authentication AE fence.
%% A node refuses new authentication when its view
%% of the security tables (users / grants) has not been confirmed by a local
%% commit or a successful AE round within this window — bounding how stale a
%% credential/permission change a node may authenticate against. Lower = tighter
%% security (a lagging node refuses sooner); higher = more availability under
%% partition/lag. Only relevant when `db.aae` is on (the fence is otherwise a
%% no-op — local writes are synchronous).
%%
%% Do not set this near the AE tick period: the confirming AE rounds are
%% background work whose wall-clock completion stretches whenever the node is
%% busy, so a ~1s bound mass-refuses authentication under a session-open burst
%% with no actual staleness in play — under fleet load the worst
%% security-shard lag was measured reaching ~30s with zero staleness. The 60s
%% default still bounds the cross-node staleness window; precise
%% credential-revocation handling is provided independently by the per-user
%% token_version fence and the AE merge-reactor RBAC invalidation.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.aae.fence.max_lag", "bondy_router.auth_max_lag", [
  {datatype, {duration, ms}},
  {default, "60s"}
]}.

%% -----------------------------------------------------------------------------
%% @doc What the authentication AE fence does on a node in a multi-node cluster
%% that currently cannot confirm freshness with any peer — partitioned into a
%% minority, or cold-started before its first AE round completes. Such a node
%% still lists its peers in its Partisan membership, so it knows it may be
%% lagging a security change made elsewhere. A genuine single-node deployment
%% (membership is just this node) is NOT governed by this policy: with no peer
%% to lag, its view is vacuously fresh and it always authenticates — so flipping
%% `db.aae` on does not lock out a lone node.
%%
%% Only relevant when `db.aae` is on.
%%
%% Options:
%%  refuse  - fail closed: refuse all new authentication until a peer round
%%             confirms freshness. The secure default — a node that cannot
%%             confirm
%%             freshness with any peer must not authenticate against a possibly-
%%             stale security view. A node restarting into an established cluster
%%             refuses only until its first sync round (typically sub-second).
%%   proceed - treat the unreachable peers as vacuously fresh and keep
%%             authenticating. Most available, but during a partition a stale
%%             minority node would accept a token revoked elsewhere until it
%%             heals. Not recommended for a security fence.
%%   quorum  - certify freshness (and so authenticate) only while connected to a
%%             majority of the expected cluster membership; a minority partition
%%             refuses even if it can still sync internally. Secure AND available
%%             for the majority side. Requires a Partisan cluster.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.aae.fence.on_isolation", "bondy_oplog.aae_fence_on_isolation", [
  {datatype, {enum, [refuse, proceed, quorum]}},
  {default, refuse}
]}.


%% -----------------------------------------------------------------------------
%% @doc How long a per-shard WAL drain may actively process frames without
%% committing any NEW consumer position before the node raises the
%% bondy_oplog_drain_stalled alarm (visible in /metrics via bondy_alarms and
%% cleared automatically when the drain progresses again). This is the guard
%% against a wedged or ground-re-reading log consumer on a node that
%% anti-entropy otherwise reports as converged. `0` disables the detector.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.drain.stall_alarm", "bondy_oplog.drain_stall_alarm_ms", [
  {datatype, {duration, ms}},
  {default, "1m"}
]}.

%% -----------------------------------------------------------------------------
%% @doc The shard count for a bondy_db database. `main` is the durable
%% database; `registry` is ephemeral. Applied whenever the catalogue
%% provisions the named DB. `main` and `registry` are Bondy's only two
%% databases — a fixed, closed set — so each gets its own explicit mapping
%% rather than a `$name`-parameterised one.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.main.shard_count", "bondy_db.databases", [
  {datatype, integer},
  {default, 16}
]}.

{mapping, "db.registry.shard_count", "bondy_db.databases", [
  {datatype, integer},
  {default, 16}
]}.

%% -----------------------------------------------------------------------------
%% @doc OVERLOAD BACKSTOP (off by default): retention window, in milliseconds,
%% for the ephemeral `registry` database's per-shard op-log history (the MST
%% event history backing anti-entropy). The primary history bound is
%% peer-confirmed compaction — the same mechanism durable databases use — which
%% truncates only what every fresh peer already holds and so never strands a
%% lagging peer. Enabling retention truncates history older than this window
%% locally REGARDLESS of peer confirmation: a peer lagging past the window must
%% then recover via catalogue re-bootstrap, and summary cells it re-installs can
%% only be fully reconciled from history still inside the window. Enable only
%% when sustained overload demonstrably outruns peer-confirmed compaction.
%% `0` (default) disables the age bound. `registry`-only: durable databases are
%% never retention-bounded.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.registry.retention.max_age_ms", "bondy_db.databases", [
  {datatype, integer},
  {default, 0}
]}.

%% -----------------------------------------------------------------------------
%% @doc OVERLOAD BACKSTOP (off by default): event-count bound, per shard, for
%% the ephemeral `registry` database's op-log history. When a shard's live
%% history exceeds this many events the whole applied history is truncated at
%% the next GC tick (default 1s), independent of
%% `db.registry.retention.max_age_ms` — keeps a write burst from outrunning the
%% age window. Same trade as the age knob: truncation past peer confirmation
%% forces lagging peers through catalogue re-bootstrap. `0` (default) disables
%% the size bound; both knobs `0` = retention fully disabled (peer-confirmed
%% compaction alone bounds history).
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.registry.retention.max_events", "bondy_db.databases", [
  {datatype, integer},
  {default, 0}
]}.


%% -----------------------------------------------------------------------------
%% @doc Partition strategy for the bondy_db `main` durable database: how a
%% (realm, key) write maps to one of `db.main.shard_count` shards. Sets BOTH
%% the write-atomicity grain (entities sharing a shard are written in one atomic
%% batch / one causal log) and which reads are shard-local vs scatter-gather.
%%   aggregate - shard = hash(realm, aggregate_root). A subject's record, grants
%%               and memberships co-locate (atomic per-subject writes); subjects
%%               spread across all shards, so a single realm still uses every
%%               shard. Realm-wide listings scatter-gather. (Recommended.)
%%   realm     - shard = hash(realm-prefix, db.main.realm_prefix_depth). A
%%               realm's whole dataset is one shard (single-shard realm scans),
%%               but a single realm collapses to one shard. Many-small-realm
%%               fleets only.
%%   entity    - shard = hash(entity_type, key). Maximum write parallelism, NO
%%               cross-entity atomicity (the pre-bondy_db behaviour).
%% TOPOLOGY-DEFINING: frozen in the on-disk topology manifest at first provision.
%% Changing it on a populated node requires a re-key (export -> wipe data dir ->
%% reimport); see `db.main.on_topology_mismatch`. `registry` has no on-disk
%% manifest (ephemeral), so it has no partition-strategy knob.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.main.partition_strategy", "bondy_db.databases", [
  {datatype, {enum, [aggregate, realm, entity]}},
  {default, aggregate}
]}.

%% -----------------------------------------------------------------------------
%% @doc Only used when `db.main.partition_strategy = realm`: the number of
%% leading dot-separated realm-URI components that share a shard (the Spanner
%% "directory" co-location pattern). 1 = per-realm; 2 co-locates `org.acme.sso`
%% with `org.acme.app`. TOPOLOGY-DEFINING (frozen in the manifest). `main`-only;
%% see `db.main.partition_strategy`.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.main.realm_prefix_depth", "bondy_db.databases", [
  {datatype, integer},
  {default, 1}
]}.

%% -----------------------------------------------------------------------------
%% @doc Boot behaviour when the on-disk topology manifest disagrees with the
%% configured topology (partition_strategy / shard_count / realm_prefix_depth /
%% per-table shard keys). The on-disk data is keyed under the manifest's
%% topology, so the new configuration cannot be applied without a re-key.
%%   warn - log a loud warning naming the diverging keys and keep running on the
%%          on-disk topology (the new config is NOT applied).
%%   stop - refuse to boot (fail fast). Recommended for production.
%% Runtime-tunable (not in the manifest). `main`-only; `registry` has no
%% manifest and cannot mismatch.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.main.on_topology_mismatch", "bondy_db.databases", [
  {datatype, {enum, [warn, stop]}},
  {default, warn}
]}.

%% -----------------------------------------------------------------------------
%% @doc Aggregates the `db.main.*` / `db.registry.*` per-database mappings
%% above into one `bondy_db` env key. Cuttlefish translation targets are
%% static strings fixed at schema-load time, so both database names are
%% read explicitly here rather than discovered — `main` and `registry` are
%% Bondy's only two databases, a fixed set, not an open-ended
%% operator-named collection. Shaped as
%% `#{DbName => #{oplog => #{Option => Value}}}`; read via
%% `bondy_db_config:oplog_*/1`.
%% @end
%% -----------------------------------------------------------------------------
{translation, "bondy_db.databases", fun(Conf) ->
    %% No fallback default here: `add_defaults/2` (cuttlefish_generator)
    %% splices each mapping's own `{default, ...}` into `Conf` before any
    %% translation runs, so every key below is always present by the time
    %% this fun executes. `conf_get/2` (not `/3`) makes that invariant
    %% load-bearing — a missing key fails config generation loudly instead
    %% of silently falling back to a second, easily-drifting copy of a
    %% default that already lives on the mapping above.
    Get = fun(Key) -> cuttlefish:conf_get(Key, Conf) end,
    #{
        main => #{
            oplog => #{
                shard_count => Get("db.main.shard_count"),
                partition_strategy => Get("db.main.partition_strategy"),
                realm_prefix_depth => Get("db.main.realm_prefix_depth"),
                on_topology_mismatch => Get("db.main.on_topology_mismatch")
            }
        },
        registry => #{
            oplog => #{
                shard_count => Get("db.registry.shard_count"),
                retention => #{
                    max_age_ms => Get("db.registry.retention.max_age_ms"),
                    max_events => Get("db.registry.retention.max_events")
                }
            }
        }
    }
end}.

%% -----------------------------------------------------------------------------
%% @doc Byte threshold at which a durable shard's pack-store MST seals its
%% `incoming.pack` into a sealed pack. The seal rewrites the whole incoming
%% pack in one datasync'd pass that runs on the apply pipeline, so its duration
%% is a freeze of local writes' visibility (read-after-write freshness lag),
%% NOT of the write calls. The cost scales linearly with this threshold: the
%% pack store's native 16MB default produces ~600ms+ freezes, large enough to
%% push freshness lag toward a tightly-set `db.aae.fence.max_lag` and trigger
%% spurious auth refusals. 2MB keeps each freeze to ~tens of ms at no throughput or
%% hot-read cost (reads serve from the projection + cache, never the MST). A
%% smaller value seals more often into more sealed packs, adding only
%% AAE/compaction/cold-boot work (GC-bounded), never read-path work.
%% Runtime-tunable (not in the manifest).
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.pack_auto_seal_bytes",
 "bondy_oplog.pack_auto_seal_bytes", [
  {datatype, bytesize},
  {default, "2MB"}
]}.


%% -----------------------------------------------------------------------------
%% @doc Seal driver for the durable shard pack-store MST. `async` (default)
%% rolls `incoming.pack` aside at the commit barrier and rewrites it into a
%% sealed pack in a monitored worker, keeping the multi-hundred-ms rewrite off
%% the apply pipeline — so the seal is no longer a freeze of local writes'
%% visibility (read-after-write freshness lag). Measured ~44% lower install
%% p99 with the inline seal freezes (84-188ms locally, up to ~750ms under disk
%% contention, close to `db.aae.fence.max_lag`) removed entirely. It does
%% NOT change durable write throughput — the per-writer ceiling is bounded by
%% disk fsync bandwidth, independent of where the seal runs. `sync` restores
%% the historical inline seal (the store seals on `put` at the threshold).
%% Affects only durable shards; ephemeral instances never seal.
%% Runtime-tunable (not in the manifest).
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.pack_seal_mode",
 "bondy_oplog.pack_seal_mode", [
  {datatype, {enum, [async, sync]}},
  {default, async}
]}.


%% -----------------------------------------------------------------------------
%% @doc Fsync driver for the durable write-ahead log. `per_write` (default)
%% fsyncs every append, bounding the writer to the storage device's fsync
%% rate (~6k ops/s on typical NVMe) but guaranteeing each write is durable
%% before it returns — required for security-class namespaces (grants,
%% tickets, users). `batched` defers fsync to a size or time boundary
%% (`db.wal.batched_fsync_bytes` / `db.wal.batched_fsync_interval`) and
%% exposes durability via an explicit wait instead of the append call
%% returning; it reaches roughly two orders of magnitude higher throughput
%% at the cost of a bounded durability window. Global — affects every
%% durable oplog instance node-wide, not a specific database; the
%% ephemeral (`registry`) in-memory WAL never fsyncs and ignores this.
%% Runtime-tunable (not in the manifest).
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.wal.fsync_mode",
 "bondy_oplog.wal_fsync_mode", [
  {datatype, {enum, [per_write, batched]}},
  {default, per_write}
]}.


%% -----------------------------------------------------------------------------
%% @doc Rotation threshold for the durable WAL's head segment. The writer
%% rotates to a fresh segment once the next frame would push the head past
%% this size; rotation fsyncs the sealed segment and advances the durable
%% position. Global, like `db.wal.fsync_mode`. Runtime-tunable.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.wal.max_segment_bytes",
 "bondy_oplog.wal_max_segment_bytes", [
  {datatype, bytesize},
  {default, "64MB"}
]}.


%% -----------------------------------------------------------------------------
%% @doc Batched-mode fsync time trigger: the writer fsyncs at most this long
%% after the first un-fsynced append. Only consulted when
%% `db.wal.fsync_mode = batched`. Global, like `db.wal.fsync_mode`.
%% Runtime-tunable.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.wal.batched_fsync_interval",
 "bondy_oplog.wal_batched_fsync_interval_ms", [
  {datatype, {duration, ms}},
  {default, "50ms"}
]}.


%% -----------------------------------------------------------------------------
%% @doc Batched-mode fsync size trigger: the writer fsyncs once accumulated
%% un-fsynced bytes exceed this threshold. Only consulted when
%% `db.wal.fsync_mode = batched`. Global, like `db.wal.fsync_mode`.
%% Runtime-tunable.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.wal.batched_fsync_bytes",
 "bondy_oplog.wal_batched_fsync_bytes", [
  {datatype, bytesize},
  {default, "1MB"}
]}.


%% -----------------------------------------------------------------------------
%% @doc Interval at which each durable Bookie's journal is trimmed back to the
%% files needed to recover the ledger's un-persisted tail.
%%
%% Bondy opens every durable Bookie in leveled's `head_only` mode, where a
%% write lands in BOTH stores: the whole cell in the ledger as a HEAD entry,
%% and the same object specs in the journal, which exists only to make the
%% ledger recoverable after an unclean stop — no read path reads it. Leveled
%% reclaims that journal on its own in neither mode: `book_compactjournal` is
%% refused under `head_only`, and its `book_trimjournal` counterpart is never
%% self-scheduled. Without this sweep the journal grows with cumulative
%% writes — every version of every cell, indefinitely — while the ledger holds
%% only the live set.
%%
%% A trim drops journal files strictly older than the one holding the
%% penciller's persisted SQN, which is exactly the history a clean restart
%% would no longer replay, so it cannot cost durability. Leveled defers the
%% unlink until no snapshot can still be reading the file, so disk returns a
%% few seconds after each pass rather than during it.
%%
%% The pass is a manifest scan, not a rewrite, so it is cheap and the cadence
%% is about how promptly disk is returned, not about load. `0` disables it,
%% which restores the unbounded-growth behaviour.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.journal_trim_interval",
 "bondy_db.journal_trim_interval_ms", [
  {datatype, {duration, ms}},
  {default, "1h"}
]}.

%% -----------------------------------------------------------------------------
%% @doc Interval at which each oplog instance checks its own heap and
%% fullsweep-hibernates if it has grown past `db.gc_heap_delta` over its
%% post-GC baseline. This reclaims the transient apply/AAE garbage a long-lived
%% instance retains until the next major GC — most visibly during a solo import
%% (no peers), where the AAE-driven hibernate never fires and the heap would
%% otherwise climb unbounded. `0` disables the monitor. Runtime-tunable. Global —
%% applies to every oplog instance node-wide, not a specific database.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.gc_interval",
 "bondy_oplog.instance_gc_interval_ms", [
  {datatype, {duration, ms}},
  {default, "2s"}
]}.


%% -----------------------------------------------------------------------------
%% @doc Heap-growth threshold above an instance's post-GC baseline at which the
%% periodic monitor (`db.gc_interval`) fullsweep-hibernates it. Keying on
%% growth over the live baseline — not absolute heap size — keeps an instance
%% with a large live MST from being GC-thrashed: it fires once per ~this-many
%% bytes of accumulated garbage, capping the transient per-instance peak at
%% roughly `live + this`. Lower trades a touch more fullsweep work for a tighter
%% memory ceiling. Runtime-tunable. Global — see `db.gc_interval`.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.gc_heap_delta",
 "bondy_oplog.instance_gc_heap_delta_bytes", [
  {datatype, bytesize},
  {default, "16MB"}
]}.


%% -----------------------------------------------------------------------------
%% @doc Enables the periodic projection-cell reclamation scheduler. Global —
%% governs every bondy_db database's oplog instances node-wide, not a
%% specific database. Deletion (`bondy_db:delete/3`) always converges and is
%% unaffected by this setting — a deleted value disappears immediately and
%% everywhere either way. This only controls whether the underlying
%% tombstone, once every cluster member has certified it causally stable, is
%% physically reclaimed. When off, tombstones are retained indefinitely,
%% exactly as if the feature did not exist. On by default.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.reclaim", "bondy_oplog.reclaim_enabled", [
  {datatype, {flag, on, off}},
  {default, on}
]}.

%% -----------------------------------------------------------------------------
%% @doc Interval between projection-cell reclamation passes. Deliberately
%% much larger than the compaction cadence: reclamation is a space concern,
%% not a liveness one, and each pass re-derives stability from peer state
%% that only changes as anti-entropy rounds complete. `0` disables periodic
%% passes (an operator can still trigger one explicitly). Only relevant when
%% `db.reclaim` is on.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.reclaim.interval", "bondy_oplog.reclaim_interval_ms", [
  {datatype, {duration, ms}},
  {default, "1m"}
]}.

%% -----------------------------------------------------------------------------
%% @doc Cells scanned per reclamation sweep batch. The sweep runs inside the
%% applier — the sole writer of a shard's local projection — so this bounds
%% how long a single batch can stall a concurrent write; a pass loops
%% batches to completion, letting writes interleave between them. Only
%% relevant when `db.reclaim` is on.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.reclaim.batch_cells", "bondy_oplog.reclaim_batch_cells", [
  {datatype, integer},
  {default, 500}
]}.

%% -----------------------------------------------------------------------------
%% @doc Cap on concurrently running reclamation/compaction trigger workers.
%% Global, shared machinery: the reclamation scheduler (`db.reclaim`) is a
%% second instance of the same scheduler that drives compaction, and both
%% instances read this one cap — it is NOT the `db.gc_interval` /
%% `db.gc_heap_delta` per-instance BEAM heap monitor, a separate subsystem
%% that happens to share the "gc" name. Instances over the cap on a given
%% tick are skipped that round and retried on the next.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.gc_max_concurrency", "bondy_oplog.gc_max_concurrency", [
  {datatype, integer},
  {default, 4}
]}.

%% -----------------------------------------------------------------------------
%% @doc Enables the origin-retirement pass. Global — reacts to Partisan
%% membership changes node-wide, not a specific database: each node reacts
%% to an observed membership removal — and reconciles once at boot, covering
%% removals that happened while it was down — by forgetting departed peers
%% from its peer state and reaping dead origins from cell state by
%% complement. The pass also carries the retirement set between nodes,
%% pulling every member's set and unioning it in, and drops the
%% applied-frontier entry of any origin every member has retired. The pass
%% is fail-closed: if any current member cannot be queried, nothing is
%% learned and nothing is reaped, and the pass retries on the next trigger.
%% It never retires an origin on its own — that is an operator act
%% (`bondy_oplog_origin_retirement:retire_dead/0`). On by default.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.origin_retirement", "bondy_oplog.origin_retirement", [
  {datatype, {flag, on, off}},
  {default, on}
]}.

%% -----------------------------------------------------------------------------
%% @doc Where this node stores the origin retirement set. Retirement is the
%% operator asserting a replica is permanently gone; it bans the origin and
%% licenses dropping its applied-frontier entry, so a node that forgot it on
%% restart would re-learn the entry from a peer and then read its own absence
%% as a deficit. A node that cannot persist the set refuses to retire and
%% refuses to reap — retirement is disabled there, nothing else is affected.
%% Relative paths are resolved against `platform_data_dir`.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.origin_retirement.path", "bondy_oplog.retirement_path", [
  {datatype, file},
  {default, "origin_retirement"}
]}.

{translation, "bondy_oplog.retirement_path", fun(Conf) ->
    Path = cuttlefish:conf_get("db.origin_retirement.path", Conf),
    case filename:pathtype(Path) of
        absolute ->
            Path;
        _ ->
            filename:join(cuttlefish:conf_get("platform_data_dir", Conf), Path)
    end
end}.

%% -----------------------------------------------------------------------------
%% @doc Interval between periodic origin-retirement passes, in addition to
%% the membership-event trigger. The periodic pass covers origin-epoch
%% turnover that produces no membership event — e.g. a node that loses its
%% storage and rejoins under the same name mints a fresh origin without any
%% peer joining or leaving, and only a periodic pass on the surviving nodes
%% reaps the dead epoch. Only relevant when `db.origin_retirement` is on.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.origin_retirement.interval",
 "bondy_oplog.origin_retirement_interval_ms", [
  {datatype, {duration, ms}},
  {default, "10m"}
]}.

%% -----------------------------------------------------------------------------
%% @doc Recency window for a peer's last-seen state to count toward
%% compaction's view of cluster liveness; a peer silent longer than this is
%% excluded from compaction's stability read, so a permanently-departed peer
%% eventually stops holding compaction back on its own. Governs the
%% compaction scheduler ONLY — projection-cell reclamation (`db.reclaim`)
%% uses a strict, membership-based reading with no recency filter, so a
%% silent member holds reclamation down until retired by an explicit
%% membership act (`db.origin_retirement`); no timeout changes that.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.compaction.peer_timeout", "bondy_oplog.peer_timeout_ms", [
  {datatype, {duration, ms}},
  {default, "30s"}
]}.

%% -----------------------------------------------------------------------------
%% @doc Maximum number of primary cells a single stale-index fallback read
%% will enumerate. When an index is stale, Bondy answers the query by
%% scanning every primary cell in the realm and recomputing each value's
%% index terms; this bounds that scan so the slow-but-correct path cannot
%% run unbounded.
%%
%% A scan that fills the cap returns a POTENTIALLY INCOMPLETE result and
%% logs a warning naming this key; the caller is not told. Raise it for
%% realms holding more cells than the default, since the correct value
%% follows from realm size and nothing else. Global, like `db.wal.*`.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.primary_scan_limit", "bondy_db.primary_scan_limit", [
  {datatype, integer},
  {default, 1000000}
]}.


%% =============================================================================
%% LEVELED (DURABLE PROJECTION STORE)
%% =============================================================================
%% Options passed to `leveled_bookie:book_start/1` for every durable Bookie
%% this node starts. Global, like `db.wal.*` — not per-database. The
%% ephemeral `registry` database keeps its projection in memory and starts
%% no Bookie, so none of these apply to it.
%%
%% `root_path` and `head_only` are deliberately absent: the first is derived
%% per Bookie from the data directory, and the second must stay
%% `with_lookup` because the projection adapter is built on `book_headonly/4`
%% and `book_mput/2`.
%%
%% Every default is leveled's own, which applied before by omission, except
%% `db.leveled.cache_size`, which keeps the 2000 Bondy has always passed.
%%
%% `db.leveled.max_journal_size` is a deliberate change: Bondy previously
%% passed 100MB, a test-tuned value that costs a large store ten times the
%% journal files, handles and compaction runs it needs. It is now leveled's
%% own 1GB. The option is the head file's roll threshold, not a format
%% parameter, so sealed journals are unaffected and only files rolled after
%% the upgrade grow.

%% -----------------------------------------------------------------------------
%% @doc Size of the Bookie's ledger cache — the in-memory buffer of recent
%% additions to the ledger, measured in objects, flushed to the penciller when
%% full. Larger values reduce penciller pressure and raise memory use.
%% Leveled ignores any value below 100, and adds randomised jitter to whatever
%% is configured so that Bookies do not flush in lockstep.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.leveled.cache_size", "bondy_db.leveled_cache_size", [
  {datatype, integer},
  {default, 2000}
]}.

%% -----------------------------------------------------------------------------
%% @doc Multiple of `db.leveled.cache_size` beyond which the ledger cache
%% will not grow even while the penciller is busy. On reaching it, every PUT
%% returns a pause, applying back-pressure to the writer rather than growing
%% memory without bound.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.leveled.cache_multiple", "bondy_db.leveled_cache_multiple", [
  {datatype, integer},
  {default, 2}
]}.

%% -----------------------------------------------------------------------------
%% @doc Maximum size of a single journal file. Leveled rolls to a new file
%% on reaching either this or `db.leveled.max_journal_objects`, whichever
%% comes first. The absolute ceiling is 4GB, imposed by leveled's 4-byte file
%% pointers.
%%
%% This bounds the size of each file, not the number of them. Under
%% `head_only` a journal record carries the write's object specs INCLUDING
%% their payload, so the journal accumulates every version ever written while
%% the ledger holds only the live set. `db.journal_trim_interval` is what
%% bounds the total: it drops files below the ledger's persisted sequence
%% number. Setting that to `0` restores unbounded growth.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.leveled.max_journal_size", "bondy_db.leveled_max_journalsize", [
  {datatype, bytesize},
  {default, "1000000000"}
]}.

%% -----------------------------------------------------------------------------
%% @doc Maximum number of objects in a single journal file. The companion
%% bound to `db.leveled.max_journal_size`; the journal stays within both.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.leveled.max_journal_objects", "bondy_db.leveled_max_journalobjectcount", [
  {datatype, integer},
  {default, 200000}
]}.

%% -----------------------------------------------------------------------------
%% @doc Maximum number of keys the penciller holds in memory before pushing
%% a new level-zero SST file to disk. Larger values mean fewer, bigger L0
%% pushes and more memory held.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.leveled.penciller_cache_size", "bondy_db.leveled_max_pencillercachesize", [
  {datatype, integer},
  {default, 28000}
]}.

%% -----------------------------------------------------------------------------
%% @doc Maximum number of ledger files a single file may be merged into.
%% With fewer than this many overlapping files below, the merge runs
%% unbounded; at or above it, the merge is partial. `infinity` never bounds
%% the merge. Leveled tests at the default; changing it is for tuning under
%% measurement, not routine operation.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.leveled.max_merge_below", "bondy_db.leveled_max_mergebelow", [
  {datatype, [integer, {atom, infinity}]},
  {default, 24}
]}.

%% -----------------------------------------------------------------------------
%% @doc Ledger level at and above which SST files are preloaded into the OS
%% page cache on open. Higher values preload more of the tree, trading memory
%% and startup work for lower first-read latency.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.leveled.ledger_preload_pagecache_level", "bondy_db.leveled_ledger_preloadpagecache_level", [
  {datatype, integer},
  {default, 4}
]}.

%% -----------------------------------------------------------------------------
%% @doc Whether leveled flushes to disk after every write. `none` (the
%% default) lets the operating system schedule the flush. `sync` forces a
%% flush per write, which is markedly slower unless the hardware absorbs it
%% (battery-backed write cache). `riak_sync` calls sync() manually after each
%% write and exists for OTP16 compatibility.
%%
%% This governs the durable *projection*, not the write-ahead log. A write is
%% already durable in the WAL before the fold reaches leveled, and the
%% projection can be rebuilt from the log, so `none` is the deliberate
%% default. Durability of the write itself is `db.wal.fsync_mode`.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.leveled.sync_strategy", "bondy_db.leveled_sync_strategy", [
  {datatype, {enum, [none, sync, riak_sync]}},
  {default, none}
]}.

%% -----------------------------------------------------------------------------
%% @doc NO EFFECT at present. Bondy opens every durable Bookie in `head_only`
%% mode, and leveled accepts journal compaction only when `head_only` is
%% false; its head_only counterpart is a `trim`, which Bondy does not invoke
%% and leveled does not schedule on its own. No journal file is compacted, so
%% none is ever waste, so this option is never consulted.
%%
%% Were compaction to run, this would set how long already-compacted journal
%% files are kept before deletion. `off` (the default) would garbage-collect
%% every such file at compaction and retain no waste. A period would keep
%% them, allowing the store to be restored to a point in time by clearing the
%% ledger and reverting the inker manifest, at the cost of the disk the waste
%% occupies.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.leveled.waste_retention_period", "bondy_db.leveled_waste_retention_period", [
  {datatype, [{atom, off}, {duration, s}]},
  {default, off}
]}.

%% -----------------------------------------------------------------------------
%% @doc NO EFFECT at present. Journal compaction never runs: Bondy opens every
%% durable Bookie in `head_only` mode, leveled accepts compaction only when
%% `head_only` is false, and the head_only alternative — a `trim` — is invoked
%% neither by Bondy nor by leveled itself.
%%
%% Were it to run, this would set how many journal files may be compacted in a
%% single run. `default` uses leveled's built-in run length of 8. Raising it
%% would let one run reclaim more space at the cost of a longer, heavier
%% compaction.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.leveled.max_run_length", "bondy_db.leveled_max_run_length", [
  {datatype, [{atom, default}, integer]},
  {default, default}
]}.

%% -----------------------------------------------------------------------------
%% @doc NO EFFECT at present. Journal compaction never runs: Bondy opens every
%% durable Bookie in `head_only` mode, leveled accepts compaction only when
%% `head_only` is false, and the head_only alternative — a `trim` — is invoked
%% neither by Bondy nor by leveled itself. Nothing scores a journal file.
%%
%% Were it to run, this would be the compaction score at or below which a
%% single journal file is eligible for compaction on its own. Lower values
%% would make solitary-file compactions rarer, favouring longer runs.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.leveled.singlefile_compaction_percentage", "bondy_db.leveled_singlefile_compactionpercentage", [
  {datatype, float},
  {default, 30.0}
]}.

%% -----------------------------------------------------------------------------
%% @doc NO EFFECT at present. Journal compaction never runs: Bondy opens every
%% durable Bookie in `head_only` mode, leveled accepts compaction only when
%% `head_only` is false, and the head_only alternative — a `trim` — is invoked
%% neither by Bondy nor by leveled itself. Nothing scores a journal file.
%%
%% Were it to run, this would be the compaction score required for a
%% full-length run to be eligible. Raising it, or lowering
%% `db.leveled.singlefile_compaction_percentage`, would make leveled prefer a
%% long run over a short one.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.leveled.maxrunlength_compaction_percentage", "bondy_db.leveled_maxrunlength_compactionpercentage", [
  {datatype, float},
  {default, 70.0}
]}.

%% -----------------------------------------------------------------------------
%% @doc NO EFFECT at present. Journal compaction never runs: Bondy opens every
%% durable Bookie in `head_only` mode, leveled accepts compaction only when
%% `head_only` is false, and the head_only alternative — a `trim` — is invoked
%% neither by Bondy nor by leveled itself. There are no compaction runs to
%% score files on.
%%
%% Were it to run, this would set how often a journal file is scored. `1`
%% would score every file on every compaction run. A value of `n` would score
%% any given file on roughly one run in `n`, using a cached score otherwise,
%% with all files scored on the first run after startup. Raising it would save
%% significant work on large journals under frequent compaction.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.leveled.journal_compaction_score_one_in", "bondy_db.leveled_journalcompaction_scoreonein", [
  {datatype, integer},
  {default, 1}
]}.

%% -----------------------------------------------------------------------------
%% @doc Compression algorithm for stored values. `none` disables
%% compression. `native` uses the Erlang term compressor. `lz4` (the default)
%% and `zstd` trade CPU for space, `zstd` more aggressively than `lz4`.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.leveled.compression_method", "bondy_db.leveled_compression_method", [
  {datatype, {enum, [lz4, native, zstd, none]}},
  {default, lz4}
]}.

%% -----------------------------------------------------------------------------
%% @doc When journal records are compressed. This governs the journal only —
%% the ledger's own setting is `db.leveled.ledger_compression`.
%%
%% `on_receipt` (the default) compresses each record as it arrives, spending
%% CPU on the write path to keep the journal small. `on_compact` defers
%% compression to journal compaction — which never runs here, because Bondy
%% opens every durable Bookie in `head_only` mode and leveled accepts
%% compaction only when `head_only` is false. Setting `on_compact` therefore
%% means records stay uncompressed indefinitely; only `on_receipt` has a
%% compressing effect.
%%
%% In `head_only` mode a journal record holds the write's object specs, and
%% those carry the payload, so this option governs real volume — but no read
%% path reads the journal (the entries exist only for startup consistency)
%% and `db.journal_trim_interval` bounds how long any of it is retained.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.leveled.compression_point", "bondy_db.leveled_compression_point", [
  {datatype, {enum, [on_receipt, on_compact]}},
  {default, on_receipt}
]}.

%% -----------------------------------------------------------------------------
%% @doc Compression level, applicable when `db.leveled.compression_method` is
%% `zstd`. Higher values compress harder and cost more CPU.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.leveled.compression_level", "bondy_db.leveled_compression_level", [
  {datatype, integer},
  {default, 1}
]}.

%% -----------------------------------------------------------------------------
%% @doc Compression for the ledger specifically. `as_store` (the default)
%% follows `db.leveled.compression_method`; the remaining values override it
%% for the ledger alone, which is useful when ledger and journal deserve
%% different trade-offs.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.leveled.ledger_compression", "bondy_db.leveled_ledger_compression", [
  {datatype, {enum, [as_store, native, lz4, zstd, none]}},
  {default, as_store}
]}.

%% -----------------------------------------------------------------------------
%% @doc How long a short-lived snapshot may remain open before leveled
%% releases it. Snapshots pin the files they were opened against, so a leaked
%% snapshot holds disk that compaction would otherwise reclaim; the timeout
%% bounds that.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.leveled.snapshot_timeout_short", "bondy_db.leveled_snapshot_timeout_short", [
  {datatype, {duration, s}},
  {default, "15m"}
]}.

%% -----------------------------------------------------------------------------
%% @doc As `db.leveled.snapshot_timeout_short`, for snapshots registered as
%% long-running — full-store folds and similar.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.leveled.snapshot_timeout_long", "bondy_db.leveled_snapshot_timeout_long", [
  {datatype, {duration, s}},
  {default, "12h"}
]}.

%% -----------------------------------------------------------------------------
%% @doc Minimum severity leveled logs at. Independent of Bondy's own log
%% level: leveled is verbose at `debug`, and this keeps that separable.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.leveled.log_level", "bondy_db.leveled_log_level", [
  {datatype, {enum, [debug, info, warning, error, critical]}},
  {default, info}
]}.

%% -----------------------------------------------------------------------------
%% @doc Percentage of operations sampled for leveled's internal timing
%% statistics. Sampling rather than measuring everything keeps the cost of
%% statistics off the hot path; raising it sharpens the numbers and costs more.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.leveled.stats_percentage", "bondy_db.leveled_stats_percentage", [
  {datatype, integer},
  {default, 10}
]}.

%% -----------------------------------------------------------------------------
%% @doc How often leveled logs its accumulated timing statistics.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "db.leveled.stats_log_frequency", "bondy_db.leveled_stats_logfrequency", [
  {datatype, {duration, s}},
  {default, "30s"}
]}.



%% -----------------------------------------------------------------------------
%% @doc The period in seconds that Bondy will waith for clients to gracefully
%% terminate their connections when the router is shutting down.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "shutdown.grace_period", "bondy_router.shutdown_grace_period", [
{default, "30s"},
{datatype, {duration, s}}
]}.


{mapping, "serializers.json.float_format",
  "bondy_router.json.float_format", [
  {datatype, string},
  {default, "[{decimals, 16}]"}
]}.


{translation, "bondy_router.json.float_format",
  fun(Conf) ->

    case cuttlefish:conf_get("serializers.json.float_format", Conf) of
      undefined ->
        [];

      String when is_list(String) ->
        case erl_scan:string(String ++ ".") of
          {ok, Tokens, _} ->
            {ok, Term} = erl_parse:parse_term(Tokens),
            Term;

          {error, _} ->
            cuttlefish:invalid(
              "value should be a list of options "
              "according to erlang:float_to_binary/2"
            )
        end;

        _ ->
          cuttlefish:invalid(
            "value should be a list of options "
            "according to erlang:float_to_binary/2"
          )
    end
  end}.


%% =============================================================================
%% ROUTER
%% =============================================================================


{mapping, "router.forward.ack",
  "bondy_router.router.forward.ack",
  [
    {default, off},
    {datatype, flag}
  ]
}.

{mapping, "router.forward.retransmission",
  "bondy_router.router.forward.retransmission",
  [
    {default, off},
    {datatype, flag}
  ]
}.


{translation, "bondy_router.router.forward",
  fun(Conf0) ->
    Conf = cuttlefish_variable:filter_by_prefix("router.forward", Conf0),
    Fwd =
      lists:foldl(
        fun
          ({["router", "forward", "ack"], V}, Acc) ->
            maps:put(ack, V, Acc);
          ({["router", "forward", "retransmission"], V}, Acc) ->
            maps:put(retransmission, V, Acc)
        end,
        #{},
        Conf
      ),
    Fwd
 end
}.

%% =============================================================================
%% SECURITY REALMS
%% =============================================================================

%% -----------------------------------------------------------------------------
%% @doc The filename of a security JSON configuration file, which allows you to
%% statically configure realms and its users, groups, sources and permissions.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "security.config_file", "bondy_router.security.config_file", [
  {datatype, file}
]}.

%% -----------------------------------------------------------------------------
%% @doc Periodic reclamation of security state that can no longer be used —
%% expired OAuth2 tokens, and tokens belonging to users that were deleted or
%% disabled. Nothing reclaims this storage otherwise: it is bounded (one cell
%% per user) but never shrinks, so a user who never returns leaves a cell
%% behind permanently.
%%
%% Each node sweeps only the realms it owns under Rendezvous hashing, so the
%% work spreads across the cluster with no coordination — and, because that
%% leaves exactly one writer per realm, without nodes overwriting each other's
%% reclamation. Turn it off only if you would rather retain dead tokens than
%% spend the periodic scan.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "security.reclamation.enabled",
"bondy_router.security.reclamation.enabled", [
  {default, on},
  {datatype, {flag, on, off}}
]}.

%% -----------------------------------------------------------------------------
%% @doc How often each node sweeps the realms it owns. Nothing waits on a
%% sweep, so this should be generous; the scan is O(tokens in the owned
%% realms).
%%
%% The actual delay is jittered down by up to 25%, because every node schedules
%% independently from this same value — without jitter a cluster restarted
%% together would sweep in lockstep forever.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "security.reclamation.interval",
"bondy_router.security.reclamation.interval", [
  {default, "6h"},
  {datatype, {duration, ms}}
]}.

%% -----------------------------------------------------------------------------
%% @doc Defines whether Bondy create's a new realm or not when a session wants
%% to connect a non existing realm.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "security.automatically_create_realms", "bondy_router.security.automatically_create_realms", [
  {default, off},
  {datatype, {flag, on, off}}
]}.

%% -----------------------------------------------------------------------------
%% @doc Defines whether Bondy allows the "anonymous" user
%% @end
%% -----------------------------------------------------------------------------
%% @doc Controls anonymous authentication (the `anonymous` role):
%%   off   - anonymous is disabled everywhere.
%%   local - anonymous is allowed only from the loopback interface (the DEFAULT):
%%           local development works out of the box, while exposing anonymous
%%           access remotely is an explicit opt-in. Mirrors RabbitMQ's
%%           loopback-only `guest` user and Redis protected mode.
%%   on    - anonymous is allowed from anywhere a realm's own sources permit.
%% This does NOT affect the master realm, which never accepts anonymous
%% connections regardless of this setting.
{mapping, "security.allow_anonymous_user",
"bondy_router.security.allow_anonymous_user", [
  {default, local},
  {datatype, {enum, [off, local, on]}}
]}.

%% @doc The initial password for the master realm's `admin` user. It is applied
%% ONLY when the master realm is first created (first boot of a fresh install).
%% If left unset, Bondy generates a random password and logs it once at startup.
%% For a multi-node cluster, set the SAME value on every node.
{mapping, "security.admin_user.password",
"bondy_router.security.admin_user.password", [
  {datatype, string},
  {commented, "changeme-use-a-strong-password"}
]}.

%% -----------------------------------------------------------------------------
%% @doc Master key for at-rest encryption of realm signing/encryption keys (and,
%% when wired, the WAL body codec). The master key is a 32-byte value resolved
%% once at startup via the shared secret resolver.
%%
%% Encryption is OFF by default (`provider = none`) — key material is stored in
%% cleartext (filesystem/disk-encryption is then the only at-rest control). Set
%% `provider` to enable it:
%%   - `env`    — read from the environment variable named by
%%                `security.master_key.env.var` (recommended for the base64
%%                default: `BONDY_SECRET_KEY=$(openssl rand -base64 32)`).
%%   - `aws_sm` — read from AWS Secrets Manager
%%                (`security.master_key.aws_sm.{secret_id,region,field}`).
%%
%% In a cluster EVERY node must resolve the SAME master key, or replicated
%% (anti-entropy) realm keys will not decrypt on peers. Back the master key up
%% out of band: losing it makes all encrypted realm keys unrecoverable.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "security.master_key.provider",
"bondy_router.security.master_key.provider", [
  {default, none},
  {datatype, {enum, [none, env, aws_sm]}}
]}.

{mapping, "security.master_key.env.var",
"bondy_router.security.master_key.env.var", [
  {datatype, string},
  {commented, "BONDY_SECRET_KEY"}
]}.

{mapping, "security.master_key.aws_sm.secret_id",
"bondy_router.security.master_key.aws_sm.secret_id", [
  {datatype, string},
  {commented, "bondy/master_key"}
]}.

{mapping, "security.master_key.aws_sm.region",
"bondy_router.security.master_key.aws_sm.region", [
  {datatype, string},
  {commented, "us-east-1"}
]}.

{mapping, "security.master_key.aws_sm.field",
"bondy_router.security.master_key.aws_sm.field", [
  {datatype, string},
  {commented, "master_key"}
]}.

%% @doc How the resolved master key material is encoded. `base64` decodes it to
%% raw bytes (expected 32); `raw` uses the bytes verbatim.
{mapping, "security.master_key.encoding",
"bondy_router.security.master_key.encoding", [
  {default, base64},
  {datatype, {enum, [raw, base64]}}
]}.

%% @doc The key id baked into new encryption envelopes; bump on rotation.
{mapping, "security.master_key.id",
"bondy_router.security.master_key.id", [
  {default, 1},
  {datatype, integer}
]}.

%% -----------------------------------------------------------------------------
%% @doc Inbound application-level rate limiting. OFF by default — enabling
%% it applies per-source-IP token buckets to the pre-auth handshake and
%% credential-verification path, HTTP request admission (API Gateway, admin
%% API, MCP), and (opt-in) per-session message rate limits.
%% Each `rate` is tokens per SECOND (steady-state); `capacity` is the burst size.
%% Tune to your topology: source IPs behind a shared NAT/proxy are throttled
%% collectively, so keep limits generous unless clients are per-IP.
%%
%% All keys target the ONE env key `bondy_router.security.rate_limit`, whose
%% translation below builds the nested MAP `bondy_rate_limit` reads. The map
%% shape is load-bearing: the previous per-key targets generated nested
%% proplists, which that reader rejects — so enabling the feature from this
%% file was a no-op (measured by generation probe, 2026-08-26).
%% @end
%% -----------------------------------------------------------------------------
{mapping, "security.rate_limit.enabled",
"bondy_router.security.rate_limit", [
  {default, off},
  {datatype, {flag, on, off}}
]}.

%% Pre-auth handshake (HELLO) per source IP.
{mapping, "security.rate_limit.handshake.rate",
"bondy_router.security.rate_limit", [
  {default, 10}, {datatype, integer}
]}.
{mapping, "security.rate_limit.handshake.capacity",
"bondy_router.security.rate_limit", [
  {default, 50}, {datatype, integer}
]}.

%% Credential-verification attempts per source IP: WAMP AUTHENTICATE and the
%% OAuth2 HTTP endpoints share this budget — a per-IP credential-guessing
%% allowance regardless of which door the attempt uses.
{mapping, "security.rate_limit.auth.rate",
"bondy_router.security.rate_limit", [
  {default, 5}, {datatype, integer}
]}.
{mapping, "security.rate_limit.auth.capacity",
"bondy_router.security.rate_limit", [
  {default, 20}, {datatype, integer}
]}.

%% New connections per source IP (pre-auth, at the transport handler).
{mapping, "security.rate_limit.connection.rate",
"bondy_router.security.rate_limit", [
  {default, 20}, {datatype, integer}
]}.
{mapping, "security.rate_limit.connection.capacity",
"bondy_router.security.rate_limit", [
  {default, 100}, {datatype, integer}
]}.

%% HTTP requests per source IP: API Gateway and admin API resources (the
%% cowboy_rest `rate_limited` hook) and the MCP endpoints. Requests, not
%% connections — an HTTP client reuses connections, so this class is
%% deliberately separate from (and defaults higher than) `connection`.
{mapping, "security.rate_limit.http.rate",
"bondy_router.security.rate_limit", [
  {default, 100}, {datatype, integer}
]}.
{mapping, "security.rate_limit.http.capacity",
"bondy_router.security.rate_limit", [
  {default, 500}, {datatype, integer}
]}.

%% Per-session CALL/PUBLISH/SUBSCRIBE/REGISTER message rate (opt-in; hot path).
{mapping, "security.rate_limit.message.enabled",
"bondy_router.security.rate_limit", [
  {default, off}, {datatype, {flag, on, off}}
]}.
{mapping, "security.rate_limit.message.rate",
"bondy_router.security.rate_limit", [
  {default, 1000}, {datatype, integer}
]}.
{mapping, "security.rate_limit.message.capacity",
"bondy_router.security.rate_limit", [
  {default, 2000}, {datatype, integer}
]}.

{translation, "bondy_router.security.rate_limit",
  fun(Conf) ->
    Get = fun(K) ->
        cuttlefish:conf_get("security.rate_limit." ++ K, Conf)
    end,
    Class = fun(C) ->
        #{rate => Get(C ++ ".rate"), capacity => Get(C ++ ".capacity")}
    end,
    #{
        enabled => Get("enabled"),
        handshake => Class("handshake"),
        auth => Class("auth"),
        connection => Class("connection"),
        http => Class("http"),
        message => (Class("message"))#{enabled => Get("message.enabled")}
    }
  end
}.

%% -----------------------------------------------------------------------------
%% @doc Defines the default password protocol to be used for new user password
%% creation. Notice the user API allows a caller to define the protocol to be
%% used. This default is used when the caller does not specify a protocol.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "security.password.protocol",
"bondy_router.security.password.protocol", [
  {default, cra},
  {datatype, {enum, [cra, scram]}}
]}.


%% -----------------------------------------------------------------------------
%% @doc Controls whether a password protocol upgrade is performed during
%% password migrations. A password migration occurs when Bondy changes the
%% internal representation of the password object to accommodate new protocols,
%% features or bug fixes. Normally some of this changes can be done without
%% user input, but when these changes include a re-calculation of the salted
%% hash they can only happen during authentication or when the user changes
%% the password.
%% If this option is set to 'on', then Bondy will try to upgrade the password
%% protocol of an existing password to the protocol defined by the
%% 'security.password.protocol' option using the default parameters defined in
%% the 'security.password.{SelectedProtocol}.{Option}' options.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "security.password.protocol.upgrade.enabled",
  "bondy_router.security.password.protocol_upgrade_enabled", [
  {default, off},
  {datatype, {flag, on, off}}
]}.

%% -----------------------------------------------------------------------------
%% @doc Defines the minimum length for newly created passwords. The value
%% should be at least 3 and at most 256.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "security.password.min_length",
"bondy_router.security.password.min_length", [
  {default, 6},
  {datatype, integer}
]}.


{translation, "bondy_router.security.password.min_length",
  fun(Conf) ->
    case cuttlefish:conf_get("security.password.min_length", Conf) of
        Value when is_integer(Value), Value >= 3, Value =< 256 ->
          Value;
        _ ->
            cuttlefish:invalid(
              "value should be an integer in the range 3..256"
            )
    end
  end
}.

%% -----------------------------------------------------------------------------
%% @doc Defines the maximum length for newly created passwords. The value
%% should be at least 3 and at most 256.
%% @end
%% -----------------------------------------------------------------------------

{mapping, "security.password.max_length",
"bondy_router.security.password.max_length", [
  {default, 254},
  {datatype, integer}
]}.

{translation, "bondy_router.security.password.max_length",
  fun(Conf) ->
    Min = cuttlefish:conf_get("security.password.min_length", Conf),
    case cuttlefish:conf_get("security.password.max_length", Conf) of
        Value when is_integer(Value), Value >= Min, Value =< 256 ->
          Value;
        _ ->
            cuttlefish:invalid(
              "value should be an integer in the range {Min}..256"
            )
    end
  end
}.

%% -----------------------------------------------------------------------------
%% @doc Defines the default key derivation function (KDF) to be used with SCRAM.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "security.password.scram.kdf",
  "bondy_router.security.password.scram.kdf", [
  {default, pbkdf2},
  %% argon2id13 RETIRED UNTIL NEW IMPLEMENTATION IS DONE
  %% {datatype, {enum, [pbkdf2, argon2id13]}}
  {datatype, {enum, [pbkdf2]}}
]}.


%% -----------------------------------------------------------------------------
%% @doc Defines the default key derivation function (KDF) to be used with CRA. The only option is pbkdf2.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "security.password.cra.kdf",
  "bondy_router.security.password.cra.kdf", [
  {default, pbkdf2},
  {datatype, {enum, [pbkdf2]}},
  hidden
]}.


%% -----------------------------------------------------------------------------
%% @doc Defines the default number of iterations to be used with the pbkdf2 key
%% derivation function. It should be an integer in the range 4096..10000000.
%% The default (600000) follows OWASP guidance for PBKDF2-HMAC-SHA256 (S-1);
%% raise it as hardware improves. Higher values increase login CPU cost.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "security.password.pbkdf2.iterations",
  "bondy_router.security.password.pbkdf2.iterations", [
  {default, "600000"},
  {datatype, integer}
]}.

{translation, "bondy_router.security.password.pbkdf2.iterations",
  fun(Conf) ->
    case cuttlefish:conf_get("security.password.pbkdf2.iterations", Conf) of
        Value when is_integer(Value), Value >= 4096, Value =< 10000000 ->
          Value;
        _ ->
            cuttlefish:invalid(
              "value should be an integer in the range 4096..10000000"
            )
    end
  end
}.


%% -----------------------------------------------------------------------------
%% @doc Defines the default iterations to be used with the argon2id13 key
%% derivation function. It should be an integer in the range 4096..4294967295
%% or a named configuration:
%% - interactive (integer 2)
%% - moderate (integer 3)
%% - sensitive (integer 4)
%% @end
%% -----------------------------------------------------------------------------
%% argon2id13 RETIRED UNTIL NEW IMPLEMENTATION IS DONE
%% {mapping,
%%   "security.password.argon2id13.iterations",
%%   "bondy_router.security.password.argon2id13.iterations", [
%%   {default, moderate},
%%   {datatype, [
%%     {enum, [interactive, moderate, sensitive]}, integer
%%   ]}
%% ]}.

%% {translation, "bondy_router.security.password.argon2id13.iterations",
%%   fun(Conf) ->
%%     case cuttlefish:conf_get("security.password.argon2id13.iterations", Conf) of
%%         Value when is_integer(Value), Value >= 1, Value =< 4294967295 ->
%%           Value;
%%         Value when Value == interactive; Value == moderate; Value == sensitive ->
%%           Value;
%%         _ ->
%%             cuttlefish:invalid(
%%               "value should be an integer in the range 1..4294967295"
%%             )
%%     end
%%   end
%% }.

%% -----------------------------------------------------------------------------
%% @doc Defines the default memory to be used with the argon2id13 key
%% derivation function. It should be an integer in the range 8192..1073741824
%% or a named configuration:
%% - interactive (integer 64MB)
%% - moderate (integer 256MB)
%% - sensitive (integer 1GB)
%%
%% (Notice that the underlying library allows up to 4398046510080 (3.9 TB)
%% but we have restricted this value to avoid a configuration error to enable a
%% DoS attack).
%% @end
%% -----------------------------------------------------------------------------
%% RETIRED TILL NEW IMPLEMENTATION IS DONE
%% {mapping,
%%   "security.password.argon2id13.memory",
%%   "bondy_router.security.password.argon2id13.memory", [
%%   {default, interactive},
%%   {datatype, [
%%     {enum, [interactive, moderate, sensitive]}, bytesize
%%   ]}
%% ]}.

%% {translation, "bondy_router.security.password.argon2id13.memory",
%%   fun(Conf) ->
%%     case cuttlefish:conf_get("security.password.argon2id13.memory", Conf) of
%%         Value when is_integer(Value), Value >= 8192, Value =< 1073741824 ->
%%           Value;
%%         Value when Value == interactive; Value == moderate; Value == sensitive ->
%%           Value;
%%         _ ->
%%             cuttlefish:invalid(
%%               "value should be an integer in the range 1..4294967295"
%%             )
%%     end
%%   end
%% }.

%% -----------------------------------------------------------------------------
%% @doc The default expiration time on or after which authentication ticket
%% MUST NOT be accepted for processing.
%% @end
%% -----------------------------------------------------------------------------
%%
{mapping, "security.ticket.expiry_time",
  "bondy_router.security.ticket.expiry_time_secs",[
  {default, "30d"},
  {datatype, {duration, s}}
]}.

%% -----------------------------------------------------------------------------
%% @doc The maximum expiration time on or after which authentication ticket
%% MUST NOT be accepted for processing.
%% @end
%% -----------------------------------------------------------------------------
%%
{mapping, "security.ticket.max_expiry_time",
  "bondy_router.security.ticket.max_expiry_time_secs",[
{default, "30d"},
{datatype, {duration, s}}
]}.

%% -----------------------------------------------------------------------------
%% @doc Controls whether local scope tickets are persistent. If enabled the
%% ticket will be stored in Bondy's database. Otherwise the ticket is not
%% stored.
%%
%% @end
%% -----------------------------------------------------------------------------
%%
{mapping, "security.ticket.scope.local.persistence",
  "bondy_router.security.ticket.local.persistence", [
  {default, on},
  {datatype, flag}
]}.

%% -----------------------------------------------------------------------------
%% @doc Controls whether SSO scope tickets are persistent. If enabled the
%% ticket will be stored in Bondy's database. Otherwise the ticket is not
%% stored.
%%
%% @end
%% -----------------------------------------------------------------------------
%%
{mapping, "security.ticket.scope.sso.persistence", "bondy_router.security.ticket.sso.persistence",[
{default, on},
{datatype, flag}
]}.

%% -----------------------------------------------------------------------------
%% @doc Controls whether client-local scope tickets are persistent. If enabled
%% the ticket will be stored in Bondy's database. Otherwise the ticket is not
%% stored.
%%
%% @end
%% -----------------------------------------------------------------------------
%%
{mapping, "security.ticket.scope.client_local.persistence",
"bondy_router.security.ticket.client_local.persistence", [
{default, on},
{datatype, flag}
]}.

%% -----------------------------------------------------------------------------
%% @doc Controls whether client-SSO scope tickets are persistent. If enabled the
%% ticket will be stored in Bondy's database. Otherwise the ticket is not
%% stored.
%%
%% @end
%% -----------------------------------------------------------------------------
%%
{mapping, "security.ticket.scope.client_sso.persistence",
"bondy_router.security.ticket.client_sso.persistence", [
{default, on},
{datatype, flag}
]}.


%% -----------------------------------------------------------------------------
%% @doc Defines whether Bondy will allow a valid ticket to be used for
%% authentication when a local copy of the ticket has not been found in
%% storage. This might happen if the ticket data has not yet been synchronised
%% to the node handling the authentication request.
%% @end
%% -----------------------------------------------------------------------------
%%
{mapping, "security.ticket.allow_not_found",
"bondy_router.security.ticket.allow_not_found", [
{default, on},
{datatype, flag}
]}.

%% -----------------------------------------------------------------------------
%% @doc Defines the a comma separated list of authentication methods that a
%% user can use to establish a session that is allowed to issue tickets to be
%% used with 'ticket' authentication.
%%
%% The possible values are the names of the authentication methods:
%% - "cryptosign"
%% - "password"
%% - "ticket"
%% - "tls"
%% - "trust"
%% - "wamp-scram"
%% - "wampcra"
%% - "oidc"
%% - "oidcrp"
%%
%% The option also allows a single value "all" in which case all the methods
%% above will be allowed.
%%
%% Notice that "anonymous" and "oauth2" methods are NOT allowed in this list as
%% they are incompatible with the idea of tickets.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "security.ticket.authmethods",
"bondy_router.security.ticket.authmethods", [
  {default, "all"},
  {datatype, string}
]}.

{translation, "bondy_router.security.ticket.authmethods",
  fun(Conf) ->
    case cuttlefish:conf_get("security.ticket.authmethods", Conf) of
        Value when is_list(Value) ->
          Allowed = ordsets:from_list([
            <<"cryptosign">>,
            <<"password">>,
            <<"ticket">>,
            <<"tls">>,
            <<"trust">>,
            <<"wamp-scram">>,
            <<"wampcra">>,
            <<"oidc">>,
            <<"oidcrp">>
          ]),
          try
            Requested = ordsets:from_list([
              list_to_binary(string:strip(Method))
              || Method <- string:split(Value, ",")
            ]),

            case Requested of
              [<<"all">>] ->
                Allowed;
              _ ->
                Invalid = ordsets:subtract(Requested, Allowed),
                ordsets:size(Invalid) == 0 orelse throw({invalid, Invalid}),
                Requested
            end

          catch
            throw:{invalid, List} ->
              String = string:join(List, ", "),
              cuttlefish:invalid("invalid authmethods " ++ String)
          end;
        _ ->
            cuttlefish:invalid(
              "value should be string containing valid authmethods e.g. \"cryptosign, wampcra, ticket\""
            )
    end
  end
}.

{mapping, "security.oidc.providers.enabled",
"bondy_router.security.oidc.providers.enabled", [
    {default, off},
    {datatype, flag}
]}.

%% $provider_id will be used together with login_path and redirect_path to build
%% the login and redirect callbacks.
{mapping, "security.oidc.providers.$provider_id.issuer",
"bondy_router.security.oidc.providers", [
  {datatype, string}
]}.

{mapping, "security.oidc.providers.$provider_id.client_id",
"bondy_router.security.oidc.providers", [
  {datatype, string}
]}.

{mapping, "security.oidc.providers.$provider_id.client_secret",
"bondy_router.security.oidc.providers", [
  {datatype, string}
]}.

%% Example:  /oidc/aws_cognito/login
{mapping, "security.oidc.providers.$provider_id.login_path",
"bondy_router.security.oidc.providers", [
    {datatype, string}
]}.

%% Example:  security.oidc.providers.aws.client_id = /oidc/aws_cognito/callback
{mapping, "security.oidc.providers.$provider_id.redirect_path",
"bondy_router.security.oidc.providers", [
    {datatype, string}
]}.


{translation, "bondy_router.security.oidc.providers", fun(Conf0) ->
    Conf = cuttlefish_variable:filter_by_prefix("security.oidc.providers", Conf0),

    {Enabled, Providers0} = lists:foldl(
        fun
            ({["security", "oidc", "providers", "enabled" = Key], Value}, {Flag, Map}) ->
                {Value, Map};

            ({["security", "oidc", "providers", ProviderId0, Key], Value}, {Flag, Map0})
            when Key == "client_id" orelse
            Key == "client_secret" orelse
            Key == "login_path" orelse
            Key == "redirect_path" ->
                ProviderId = list_to_binary(ProviderId0),
                Update = #{list_to_atom(Key) => list_to_binary(Value)},
                Map = maps:update_with(
                    ProviderId,
                    fun(ProviderConf) -> maps:merge(ProviderConf, Update) end,
                    Update,
                    Map0
                ),
                {Flag, Map}
        end,
        {false, maps:new()},
        Conf
    ),
    Providers = maps:fold(
        fun(ProviderId, ProviderConf, Acc) ->
            [#{id => ProviderId, config => ProviderConf} | Acc]
        end,
        [],
        Providers0
    ),
    #{enabled => Enabled, providers => Providers}
end}.

%% =============================================================================
%% CERTIFICATE MANAGER
%% =============================================================================

%% @doc Path to a PEM file containing additional trusted CA certificates for
%% outbound TLS connections (OIDC providers, HTTP Connector HTTP backends, etc.).
%% These certificates are merged with the certifi Mozilla CA bundle and
%% (when available) the OS trust store.
%% If not set, only those two sources are used. A listener's own
%% listeners.$name.tls.cacertfile is not consulted: that anchors verification of
%% inbound clients on one socket, not Bondy's own outbound trust.
{mapping, "cert_manager.cacertfile", "bondy_router.cert_manager.cacertfile", [
  {datatype, file},
  {commented, "{{platform_etc_dir}}/cacert.pem"}
]}.

%% =============================================================================
%% OVERLOAD PROTECTION AND LOAD REGULATION
%% =============================================================================

%% -----------------------------------------------------------------------------
%% @doc Unused at the moment
%% @end
%% -----------------------------------------------------------------------------
{mapping, "load_regulation.enabled",
"bondy_router.load_regulation_enabled", [
  {default, on},
  {datatype, {flag, on, off}},
  hidden
]}.


%% -----------------------------------------------------------------------------
%% @doc
%% @end
%% -----------------------------------------------------------------------------
{mapping, "load_regulation.router.pool.type",
"bondy_router.router_pool.type", [
  {default, transient},
  {datatype, {enum, [permanent, transient]}},
  hidden
]}.

%% -----------------------------------------------------------------------------
%% @doc The size of the router process pool.
%% The configured value is used verbatim; sizing it at or above
%% `erlang:system_info(schedulers)` is recommended.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "load_regulation.router.pool.size",
"bondy_router.router_pool.size", [
  {default, 16},
  {validators, ["pos_integer"]},
  {datatype, integer},
  hidden
]}.

%% -----------------------------------------------------------------------------
%% @doc The capacity of the router process pool, i.e. the maximum number of
%% active erlang processes handling router events (default = 2000000).
%% Once the maximum has been reached, Bondy will respond with an overload error.
%% Notice this is further limited by the `vm.process_limit` option.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "load_regulation.router.pool.capacity",
"bondy_router.router_pool.capacity", [
  {default, 2000000},
  {validators, ["pos_integer"]},
  {datatype, integer}
]}.


%% -----------------------------------------------------------------------------
%% @doc The total number of messages that can be queued across the router
%% flow pool workers (the pool preserving WAMP per-flow ordering) before new
%% messages for a saturated flow are shed. Deliberately much smaller than
%% `load_regulation.router.pool.capacity`: an ordered lane cannot overflow
%% work to another worker, so a large bound only buys memory pressure, not
%% throughput. Each worker's share is this value divided by
%% `load_regulation.router.pool.size`.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "load_regulation.router.flow_pool.capacity",
"bondy_router.router_flow_pool.capacity", [
  {default, 100000},
  {validators, ["pos_integer"]},
  {datatype, integer}
]}.

%% -----------------------------------------------------------------------------
%% @doc Enables the session admission gate: while the node is in the busy
%% state (see the load_regulation.load_monitor.* settings) new HELLO
%% requests are refused immediately with a retryable
%% `wamp.error.unavailable` ABORT instead of being accepted into a session
%% open that deep run queues would stretch past the client's timeout while
%% holding a socket and session state. Sessions already established, and
%% handshakes already past HELLO, are unaffected.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "load_regulation.hello.enabled",
"bondy_router.load_regulation.hello.enabled", [
  {default, on},
  {datatype, flag}
]}.

%% -----------------------------------------------------------------------------
%% @doc The node enters the busy state when the sampled total run queue
%% length reaches this factor times the number of online schedulers. The
%% run queue is the number of runnable processes waiting for a scheduler,
%% so a factor of N means roughly N processes ahead of any newly runnable
%% one on every scheduler — a direct measure of scheduling delay.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "load_regulation.load_monitor.run_queue_high_watermark",
"bondy_regulator.load_monitor_high_watermark", [
  {default, 8},
  {validators, ["pos_integer"]},
  {datatype, integer}
]}.

%% -----------------------------------------------------------------------------
%% @doc The node returns to the normal state when the sampled total run
%% queue length falls to this factor times the number of online
%% schedulers. Must be below the high watermark; the gap is the
%% hysteresis that prevents the state from flapping at the boundary.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "load_regulation.load_monitor.run_queue_low_watermark",
"bondy_regulator.load_monitor_low_watermark", [
  {default, 4},
  {datatype, integer}
]}.

%% -----------------------------------------------------------------------------
%% @doc How often the load monitor samples the runtime's run queue
%% length. The sample is cheap; the interval bounds how quickly the busy
%% state reacts to a load change.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "load_regulation.load_monitor.sample_interval",
"bondy_regulator.load_monitor_sample_interval_ms", [
  {default, "100ms"},
  {datatype, {duration, ms}}
]}.

%% -----------------------------------------------------------------------------
%% @doc The capacity of the session manager process pool, i.e. the maximum
%% number of active erlang processes handling session events (default = 32).
%% @end
%% -----------------------------------------------------------------------------
{mapping, "load_regulation.session_manager.pool.size", "bondy_router.session_manager_pool.size", [
  {default, 32},
  {validators, ["pos_integer"]},
  {datatype, integer}
]}.

{mapping, "load_regulation.job_manager.pool.size",
"bondy_router.job_manager_pool.size", [
  {default, 16},
  {validators, ["pos_integer"]},
  {datatype, integer}
]}.

%% -----------------------------------------------------------------------------
%% @doc The capacity of the anti-entropy merge-reaction worker pool, i.e. the
%% maximum number of erlang processes applying remote-merge reactions (session
%% close, RBAC cache invalidation, routing RIB stub updates) in parallel. Events
%% are sharded by cell key, so a given cell's changes always run on the same
%% worker and stay ordered (default = 16).
%% @end
%% -----------------------------------------------------------------------------
{mapping, "load_regulation.aae_reactor.pool.size",
"bondy_router.aae_reactor_pool.size", [
  {default, 16},
  {validators, ["pos_integer"]},
  {datatype, integer}
]}.

%% -----------------------------------------------------------------------------
%% @doc The maximun number of elements in the FIFO queue after which older items
%% are evicted. This is the sum of all queues (1 per worker)
%% -----------------------------------------------------------------------------
{mapping, "load_regulation.job_manager.queue.size",
"bondy_router.job_manager_queue.max_size", [
  {default, 160000},
  {validators, ["pos_integer"]},
  {datatype, integer}
]}.

%% -----------------------------------------------------------------------------
%% @doc The duration of a job in the FIFO queue after which it is evicted.
%% -----------------------------------------------------------------------------
{mapping, "load_regulation.job_manager.queue.ttl",
"bondy_router.job_manager_queue.ttl", [
  {default, "1m"},
  {datatype, {duration, ms}}
]}.


%% -----------------------------------------------------------------------------
%% @doc The number of registry store partitions (default = 32; the
%% runtime lowers an unset value to min(16, schedulers)).
%% A partition owns one registry store (the entry tables plus the
%% exact/prefix/wildcard routing indexes) and a gen_server that
%% supervises its index janitors. All registrations and subscriptions
%% for a realm are PLACED in the same (single) partition — assignment
%% hashes the realm URI across the partition count — so increasing the
%% count only spreads load when there is a decent number of realms.
%% Placement is not a concurrency bottleneck for a single busy realm,
%% however: every hot-path operation (add, remove, lookup, match) runs
%% lock-free in the calling process regardless of partition — exact
%% indexes via ETS, pattern indexes via a persistent trie with
%% compare-and-swap publication (contention is observable as
%% bondy_registry_ptrie_cas_retries_total).
%% @end
%% -----------------------------------------------------------------------------
{mapping, "registry.partitions",
"bondy_router.registry.partitions", [
  {default, 32},
  {validators, ["pos_integer"]},
  {datatype, integer}
]}.


%% -----------------------------------------------------------------------------
%% @doc off_heap only enabled if running on Erlang 25 or later.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "registry.partition_spawn_opts.message_queue_data",
  "bondy_router.registry.partition_spawn_opts.message_queue_data", [
  {default, off_heap},
  {datatype, {enum, [off_heap, on_heap]}},
  hidden
]}.

%% -----------------------------------------------------------------------------
%% The registry RIB (Routing Information Base): each node publishes a compact
%% replicated summary cell — one per (realm, match policy, URI, node) — for its
%% own local registrations and subscriptions, and cross-node routing is decided
%% from the merged summaries. Full registry entries are kept node-local, never
%% replicated, so a registration's replicated footprint is one summary cell per
%% owning node instead of a full entry on every node. This is unconditional —
%% there is no mode knob. The two settings below tune observability and flap
%% control; they do not change what the registry replicates.
%% -----------------------------------------------------------------------------

%% -----------------------------------------------------------------------------
%% @doc Interval of the periodic RIB consistency sweep, which compares the
%% replicated routing summaries against the ground truth per realm and logs
%% any divergence. `0` disables the sweep.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "registry.rib.check_interval",
"bondy_router.registry_rib_check_interval", [
  {datatype, {duration, ms}},
  {default, "5m"}
]}.

%% -----------------------------------------------------------------------------
%% @doc RIB update damping (route-flap control), owner side. Reachability
%% transitions — a procedure's first registration on this node, or its last
%% one leaving — always propagate immediately. With a non-zero window, an
%% update that changes ONLY the summary's count / latest fields (i.e. the
%% node keeps serving the procedure, just with a different number of
%% callees) is coalesced: at most one such cell write per window, with a
%% trailing update carrying the final value. `0` (default) disables damping
%% and every summary change is written through.
%% @end
%% -----------------------------------------------------------------------------
%% `integer` is listed alongside the duration so that `0` is expressible: the
%% duration parser rejects zero in every spelling (`0`, `0ms`, `0s`), so a
%% bare duration datatype makes the documented "set 0 to disable" impossible
%% to write and makes the generated defaults file fail to parse back.
{mapping, "registry.rib.damping", "bondy_router.registry_rib_damping", [
  {datatype, [integer, {duration, ms}]},
  {default, 0}
]}.

%% =============================================================================
%% LISTENERS
%% =============================================================================

%% -----------------------------------------------------------------------------
%% OPERATOR-DEFINED LISTENERS
%% -----------------------------------------------------------------------------
%% Each `listeners.$name' block describes one socket.
%%
%% Every mapping in this section targets the SAME key, `bondy_router.listeners',
%% and the single translation below turns them into `[{Name, Spec}]' — the shape
%% `bondy_listener_config:resolve/2' consumes. A mapping cannot target a
%% per-listener key: `cuttlefish_generator' tokenises a target string as written
%% and passes each token through `list_to_atom/1' (see :153 and :257-267 of
%% cuttlefish_generator.erl, cuttlefish 3.0.1), so `$name' in a target yields
%% the atom `'$name'' rather than the listener's name. Each listener's option
%% block therefore travels nested inside its own spec, at the path its consumer
%% reads it from.
%%
%% This section cannot write to `bondy_router.<name>.*' directly, but that IS
%% the path its option blocks end up on. `bondy_config:splat_listener_blocks/0'
%% copies every key of every spec that is not one of `?SPEC_KEYS' out to
%% `bondy_router.<name>.<key>', leaf by leaf, and `bondy_config:init/1' calls it
%% before `bondy_listener_manager:init/0' — so
%% `bondy_config:listener_transport_opts/2', `bondy_cert_manager',
%% `bondy_http_cors' and `bondy_http_security_headers' all read what this
%% section renders.
%%
%% One consequence a consumer must handle: the splat writes each leaf with
%% `set/2', which builds nested PROPLISTS, so a block reached at `[Name, Block]'
%% is a proplist and not the map its consumer wants. `bondy_http_cors' and
%% `bondy_http_security_headers' both convert with `key_value:to_map/1'.
%%
%% NO mapping in this section may declare a `{default, ...}'.
%% `cuttlefish_generator:add_fuzzy_default/4' materialises a $name mapping's
%% default for EVERY name mentioned anywhere under the `listeners' prefix — the
%% prefix, not the individual key (`get_possible_values_for_fuzzy_matches/2') —
%% which would make the global `wamp.<carrier>.*' fallback that
%% `bondy_listener_config:resolve_carrier_key/5' depends on permanently dead,
%% and would give every listener a key its operator never wrote. Defaults belong
%% to the global blocks and to `bondy_listener_config'.
%%
%% A `{validators, ...}' would be inert here, so none is declared.
%% `cuttlefish_generator:run_validations/2' (:612-639) looks a value up under
%% the mapping's OWN variable, which for a fuzzy mapping is the literal
%% `["listeners","$name",...]' and never a key in the rendered conf; its list
%% comprehension also admits a mapping only if it has a default or that same
%% literal variable is set. Both conditions fail for every mapping here, so a
%% validator would never be consulted — e.g. a `port_number' validator would
%% accept `listeners.pub.port = 99999', which its own predicate
%% `(Port band bnot 16#ffff) =:= 0' rejects. Range and coercion checks are
%% therefore applied inline in the translation's `Value' fun instead: a
%% lower-bound check (`Min'), a bounded-range check (`Range'), the
%% `port_number' predicate, IP-address parsing and TLS-version coercion.
%% `Value' checks exactly the keys named in its own clauses; every other key
%% falls through unchecked. Which keys those are is inherited rather than
%% derived, so a key absent from `Value' is not thereby known to need no
%% check — see the `linger.timeout' clause, whose `http.' sibling is
%% deliberately not checked.

%% --------------------------------------------------------------------------
%% Identity and bind target. These reach the inventory spec's top level, which
%% is where bondy_listener_config:resolve_one/3 reads them.
%% --------------------------------------------------------------------------

%% @doc The transport the listener binds: `tcp', `tls' or `uds'. TLS is a
%% transport, not a protocol — an HTTPS listener is protocol = http with
%% transport = tls.
{mapping, "listeners.$name.transport", "bondy_router.listeners", [
  {datatype, {enum, [tcp, tls, uds]}}
]}.

%% @doc What frames the wire. `http' takes a `services' list; a raw-socket
%% protocol carries exactly one protocol and takes none.
{mapping, "listeners.$name.protocol", "bondy_router.listeners", [
  {datatype, {enum, [http, wamp_rawsocket, bridge_relay]}}
]}.

%% @doc The TCP port. Required for tcp and tls. Deliberately has no default: a
%% default would silently collide between listeners.
{mapping, "listeners.$name.port", "bondy_router.listeners", [
  {datatype, integer}
]}.

%% @doc Filesystem path for a `uds' listener, instead of a port.
{mapping, "listeners.$name.path", "bondy_router.listeners", [
  {datatype, file}
]}.

%% @doc Comma-separated services reachable on this listener. Valid only when
%% protocol = http. Each entry names a protocol over a carrier, so BAMP can
%% be offered over WebSocket without also offering WAMP.
{mapping, "listeners.$name.services", "bondy_router.listeners", [
  {datatype, string}
]}.

%% @doc Whether the listener starts. Absent means enabled.
{mapping, "listeners.$name.enabled", "bondy_router.listeners", [
  {datatype, {flag, on, off}}
]}.

%% @doc `early' starts the listener before any `normal' one and while the
%% node still reports `initialising', so liveness and readiness probes answer
%% before clients are accepted. Absent means `normal'.
{mapping, "listeners.$name.start_phase", "bondy_router.listeners", [
  {datatype, {enum, [early, normal]}}
]}.

%% @doc The IP address to listen on, for a host with several interfaces.
%% Parsed to an address tuple at render time: it reaches ranch's socket
%% options after the normalisation that would otherwise convert it.
{mapping, "listeners.$name.ip", "bondy_router.listeners", [
  {datatype, string}
]}.

%% --------------------------------------------------------------------------
%% Stream-socket and connection options shared by every protocol.
%% --------------------------------------------------------------------------

%% @doc The IP version to use. Either 4 or 6. This selects the family only
%% for a listener that configures no `ip': there it chooses the wildcard
%% bound, `0.0.0.0' or `::'. An address determines its own family, so where
%% both keys are set and disagree the address wins and this key has no
%% effect.
{mapping, "listeners.$name.ip_version", "bondy_router.listeners", [
  {datatype, string}
]}.

%% @doc Size of the acceptor pool.
{mapping, "listeners.$name.acceptors_pool_size", "bondy_router.listeners", [
  {datatype, integer}
]}.

%% @doc Maximum number of concurrent connections. Match this to host
%% memory/fd capacity and raise it deliberately: a per-listener cap set very
%% high invites fd/memory exhaustion.
{mapping, "listeners.$name.max_connections", "bondy_router.listeners", [
  {datatype, integer}
]}.

%% @doc The maximum length that the queue of pending connections can grow to.
{mapping, "listeners.$name.backlog", "bondy_router.listeners", [
  {datatype, integer}
]}.

%% @doc Enables/disables periodic transmission on a connected socket when no
%% other data is exchanged. If the other end does not respond, the connection
%% is considered broken and an error message is sent to the controlling
%% process.
{mapping, "listeners.$name.keepalive", "bondy_router.listeners", [
  {datatype, {flag, on, off}}
]}.

%% @doc If on, option TCP_NODELAY is turned on for the socket, which means
%% that also small amounts of data are sent immediately.
{mapping, "listeners.$name.nodelay", "bondy_router.listeners", [
  {datatype, {flag, on, off}}
]}.

%% @doc Allows multiple listen sockets on the same port, so accepts fan out
%% across schedulers.
{mapping, "listeners.$name.reuseport", "bondy_router.listeners", [
  {datatype, {flag, on, off}}
]}.

%% @doc The minimum size of the send buffer to use for the socket.
{mapping, "listeners.$name.sndbuf", "bondy_router.listeners", [
  {datatype, bytesize}
]}.

%% @doc The minimum size of the receive buffer to use for the socket.
{mapping, "listeners.$name.recbuf", "bondy_router.listeners", [
  {datatype, bytesize}
]}.

%% @doc The size of the user-level software buffer used by the driver. Not to
%% be confused with sndbuf and recbuf, which correspond to the kernel socket
%% buffers. It is recommended to have val(buffer) >=
%% max(val(sndbuf),val(recbuf)) to avoid unnecessary copying; val(buffer) is
%% set to that maximum automatically when sndbuf or recbuf are set.
{mapping, "listeners.$name.buffer", "bondy_router.listeners", [
  {datatype, bytesize}
]}.

%% @doc Maximum allowed time for the listening process handshake call to
%% finish.
{mapping, "listeners.$name.handshake_timeout", "bondy_router.listeners", [
  {datatype, {duration, ms}}
]}.

%% @doc How long the socket blocks on close waiting for unsent data to be
%% acknowledged. `-1' disables lingering; `0' aborts the connection on close,
%% discarding anything unsent. Defaults to 1s.
%%
%% Expressed in SECONDS, unlike every other duration in this file, because the
%% value is handed to the OS socket option `{linger, {true, N}}' whose second
%% component the `inet' module documents in seconds. A sub-second value is
%% rounded UP to one second rather than down to zero, which would mean abort.
%%
%% A bare integer is accepted, and also means seconds, because the raw-socket
%% form of this setting always accepted one. See also
%% listeners.$name.http.linger.timeout, the Cowboy-level setting, which is a
%% different thing and is in milliseconds.
{mapping, "listeners.$name.linger.timeout", "bondy_router.listeners", [
  {datatype, [{duration, s}, integer]}
]}.

%% @doc Drops a raw-socket connection after a period of inactivity. This
%% option does not take effect when ping.enabled is `on' and
%% ping.idle_timeout times ping.max_attempts results in a value higher than
%% this option. For an HTTP listener the equivalent is
%% listeners.$name.http.idle_timeout.
{mapping, "listeners.$name.idle_timeout", "bondy_router.listeners", [
  {datatype, [{duration, ms}, {atom, infinity}]}
]}.

%% @doc The period of time without a session after which the connection is
%% dropped. Applies to a protocol = bridge_relay listener, which authenticates
%% the peer router before it may relay anything; other protocols ignore it.
%% Absent, bondy_bridge_relay_server:init/1 uses 5000 ms.
{mapping, "listeners.$name.auth_timeout", "bondy_router.listeners", [
  {datatype, [{atom, infinity}, {duration, ms}]}
]}.

%% @doc Whether the connection process hibernates when idle, trading a little
%% latency on the next message for a smaller heap. Applies to a
%% protocol = bridge_relay listener; a Websocket connection has its own
%% websocket.hibernate. Absent, bondy_bridge_relay_server:init/1 uses `idle'.
{mapping, "listeners.$name.hibernate", "bondy_router.listeners", [
  {datatype, {enum, [never, idle, always]}}
]}.

%% @doc Enables or disables proxy-protocol source-address capture, used for
%% matching against RBAC Source assignments.
{mapping, "listeners.$name.proxy_protocol", "bondy_router.listeners", [
  {datatype, {flag, on, off}}
]}.

%% @doc How to treat a connection with no proxy-protocol information when
%% proxy_protocol is enabled. `strict' drops it; `relaxed' accepts it and
%% logs.
{mapping, "listeners.$name.proxy_protocol.mode", "bondy_router.listeners", [
  {datatype, {enum, [strict, relaxed]}}
]}.

%% @doc Trusted reverse-proxy CIDRs, comma separated.
{mapping, "listeners.$name.proxy_protocol.trusted_proxies",
"bondy_router.listeners", [
  {datatype, string}
]}.

%% @doc Defines if server-initiated PING control messages are enabled. Bondy
%% always answers a client-initiated ping even when this is off. Enabling it
%% implies one additional timer per connection.
{mapping, "listeners.$name.ping.enabled", "bondy_router.listeners", [
  {datatype, {flag, on, off}}
]}.

%% @doc When ping.enabled is `on', the maximum time permitted to elapse
%% between the point at which the client finishes transmitting a message and
%% the point it starts sending the next.
{mapping, "listeners.$name.ping.idle_timeout", "bondy_router.listeners", [
  {datatype, {duration, ms}}
]}.

%% @doc When ping.enabled is `on', how long Bondy waits for a ping response
%% before counting a failed attempt.
{mapping, "listeners.$name.ping.timeout", "bondy_router.listeners", [
  {datatype, {duration, ms}}
]}.

%% @doc When ping.enabled is `on', how many missed pings are allowed before
%% the connection is closed.
{mapping, "listeners.$name.ping.max_attempts", "bondy_router.listeners", [
  {datatype, integer}
]}.

%% --------------------------------------------------------------------------
%% Cowboy protocol-level options. These carry an `http.' prefix so that one conf
%% key has one meaning: `idle_timeout' and `linger.timeout' name a different
%% setting here than they do on a raw socket, and a key whose effect depended on
%% a sibling `protocol' value would be worse than a longer name. All 23 are
%% prefixed, not only the two that collide, so the group does not drift as keys
%% are added.
%% --------------------------------------------------------------------------

%% @doc The number of packets Cowboy requests from the socket at once. Higher
%% values reduce how often Cowboy asks the port driver for more packets, at
%% the expense of potentially higher memory use.
{mapping, "listeners.$name.http.active_n", "bondy_router.listeners", [
  {datatype, integer}
]}.

%% @doc Lower bound of the dynamically resized socket receive buffer. To tune
%% it, BOTH min and max must be set, within 1KB..128KB and with min =< max;
%% setting either to 0 disables dynamic buffering entirely. Ignored when the
%% socket `buffer' size is set explicitly.
{mapping, "listeners.$name.http.buffer.min", "bondy_router.listeners", [
  {datatype, bytesize}
]}.

%% @doc Upper bound of the dynamically resized socket receive buffer. See
%% listeners.$name.http.buffer.min.
{mapping, "listeners.$name.http.buffer.max", "bondy_router.listeners", [
  {datatype, bytesize}
]}.

%% @doc Time with no data received before Cowboy closes the connection.
{mapping, "listeners.$name.http.idle_timeout", "bondy_router.listeners", [
  {datatype, {duration, ms}}
]}.

%% @doc Time with nothing received at all before Cowboy closes the
%% connection.
{mapping, "listeners.$name.http.inactivity_timeout", "bondy_router.listeners", [
  {datatype, {duration, ms}}
]}.

%% @doc HTTP/2 initial stream flow-control window.
{mapping, "listeners.$name.http.initial_stream_flow_size",
"bondy_router.listeners", [
  {datatype, bytesize}
]}.

%% @doc What to do when a response given to Cowboy contains invalid header
%% names or values (for example control characters): `error_terminate'
%% replies with a 500 and terminates the stream — preventing header injection
%% and response splitting — while `ignore' relays the response unchanged.
{mapping, "listeners.$name.http.invalid_response_headers",
"bondy_router.listeners", [
  {datatype, {enum, [error_terminate, ignore]}}
]}.

%% @doc Time Cowboy waits when closing the connection, to avoid the TCP reset
%% problem described in section 6.6 of RFC7230. Distinct from
%% listeners.$name.linger.timeout, which is the socket-level option.
{mapping, "listeners.$name.http.linger.timeout", "bondy_router.listeners", [
  {datatype, {duration, ms}}
]}.

%% @doc Maximum length of the authority component of the request URI (the
%% host[:port] part), in bytes. Requests exceeding it are rejected.
{mapping, "listeners.$name.http.max_authority_length",
"bondy_router.listeners", [
  {datatype, integer}
]}.

%% @doc Maximum length of the Authorization header value, in bytes.
%% Authorization headers routinely carry bearer tokens (JWTs) larger than
%% typical header values, so Cowboy allows raising this limit independently
%% of max_header_value_length, which is used when this option is not set.
{mapping, "listeners.$name.http.max_authorization_header_value_length",
"bondy_router.listeners", [
  {datatype, integer}
]}.

%% @doc HTTP/2 only: maximum number of concurrent streams (requests) a single
%% client connection may have open. Unbounded concurrent streams let one
%% connection exhaust the node. Raise it only for trusted, heavily
%% multiplexing clients.
{mapping, "listeners.$name.http.max_concurrent_streams",
"bondy_router.listeners", [
  {datatype, integer}
]}.

%% @doc Maximum length of the Cookie header value, in bytes. Cookie headers
%% can legitimately exceed typical header values, so Cowboy allows raising
%% this limit independently of max_header_value_length, which is used when
%% this option is not set.
{mapping, "listeners.$name.http.max_cookie_header_value_length",
"bondy_router.listeners", [
  {datatype, integer}
]}.

%% @doc Maximum number of cookies parsed out of the Cookie header of a
%% request. A request carrying more is rejected with a 400, which bounds the
%% work a single header of legal length can cause. This is a limit on the
%% COUNT of cookies; max_cookie_header_value_length bounds the header's SIZE.
%% Unset means the 100 cowlib applies (cow_cookie:parse_cookie/2).
%%
%% Unlike its siblings in this block, Cowboy's protocol loop does not read
%% this option: cowlib takes it per call, so Bondy passes it to
%% cowboy_req:parse_cookies/2 at each site that parses cookies
%% (bondy_http_utils:parse_cookies/1). It is rendered into the same
%% protocol_opts block as the rest of listeners.$name.http.* because that is
%% where a listener's HTTP request limits live and where that function reads
%% it from; Cowboy ignores an option it does not know.
{mapping, "listeners.$name.http.max_cookies", "bondy_router.listeners", [
  {datatype, integer}
]}.

%% @doc Maximum number of empty lines accepted before the request line.
{mapping, "listeners.$name.http.max_empty_lines", "bondy_router.listeners", [
  {datatype, integer}
]}.

%% @doc Maximum length of a header name, in bytes.
{mapping, "listeners.$name.http.max_header_name_length",
"bondy_router.listeners", [
  {datatype, integer}
]}.

%% @doc Maximum length of a header value, in bytes.
{mapping, "listeners.$name.http.max_header_value_length",
"bondy_router.listeners", [
  {datatype, integer}
]}.

%% @doc Maximum number of headers accepted per request.
{mapping, "listeners.$name.http.max_headers", "bondy_router.listeners", [
  {datatype, integer}
]}.

%% @doc Maximum number of requests allowed per connection.
{mapping, "listeners.$name.http.max_keepalive", "bondy_router.listeners", [
  {datatype, integer}
]}.

%% @doc Maximum length of the request method, in bytes.
{mapping, "listeners.$name.http.max_method_length", "bondy_router.listeners", [
  {datatype, integer}
]}.

%% @doc Maximum length of the request line, in bytes.
{mapping, "listeners.$name.http.max_request_line_length",
"bondy_router.listeners", [
  {datatype, integer}
]}.

%% @doc Maximum number of bytes of an unread request body Cowboy will skip in
%% order to reuse the connection.
{mapping, "listeners.$name.http.max_skip_body_length",
"bondy_router.listeners", [
  {datatype, integer}
]}.

%% @doc Time with no requests before Cowboy closes the connection.
{mapping, "listeners.$name.http.request_timeout", "bondy_router.listeners", [
  {datatype, {duration, ms}}
]}.

%% @doc Whether the idle_timeout gets reset when sending data to the socket.
{mapping, "listeners.$name.http.reset_idle_timeout_on_send",
"bondy_router.listeners", [
  {datatype, {flag, on, off}}
]}.

%% @doc Whether Cowboy uses sendfile to serve static files.
{mapping, "listeners.$name.http.sendfile", "bondy_router.listeners", [
  {datatype, {flag, on, off}}
]}.

%% @doc A comma separated, priority ordered list of the HTTP protocol versions
%% the listener offers; the default is `2, 1.1'. Bondy supports versions 1.1
%% and 2 and serves SSE and long-poll identically on both. On a TLS listener
%% the order is the server's ALPN preference; HTTP/2 is served only to a
%% client that negotiates `h2' via ALPN (RFC 7540 requires that), so a client
%% that negotiates `http/1.1' or sends no ALPN is served HTTP/1.1 whenever
%% 1.1 is listed. On a plaintext listener listing 2 enables the HTTP/2
%% prior-knowledge and Upgrade paths.
{mapping, "listeners.$name.http.versions", "bondy_router.listeners", [
  {datatype, string}
]}.

%% --------------------------------------------------------------------------
%% HTTP response-header policy.
%% --------------------------------------------------------------------------

%% @doc Whether CORS headers are enabled for this listener.
{mapping, "listeners.$name.cors.enabled", "bondy_router.listeners", [
  {datatype, {flag, on, off}}
]}.

%% @doc The allowed origins for CORS requests. Can be "*" (wildcard), "auto"
%% (derive from request host), or a comma-separated list of origins.
{mapping, "listeners.$name.cors.allowed_origins", "bondy_router.listeners", [
  {datatype, string}
]}.

%% @doc The allowed HTTP methods for CORS requests.
{mapping, "listeners.$name.cors.allowed_methods", "bondy_router.listeners", [
  {datatype, string}
]}.

%% @doc The allowed HTTP headers for CORS requests.
{mapping, "listeners.$name.cors.allowed_headers", "bondy_router.listeners", [
  {datatype, string}
]}.

%% @doc The max age in seconds for the CORS preflight cache.
{mapping, "listeners.$name.cors.max_age", "bondy_router.listeners", [
  {datatype, integer}
]}.

%% @doc Whether static security headers are enabled for this listener.
{mapping, "listeners.$name.security_headers.enabled",
"bondy_router.listeners", [
  {datatype, {flag, on, off}}
]}.

%% @doc The value for the Strict-Transport-Security header, or `off' to suppress
%% this one header while the others are still sent. Sent by default on a
%% listener that terminates TLS, and never on a plaintext one.
{mapping, "listeners.$name.security_headers.hsts", "bondy_router.listeners", [
  {datatype, [{atom, off}, string]}
]}.

%% @doc The value for the X-Frame-Options header, or `off' to suppress this one
%% header while the others are still sent.
{mapping, "listeners.$name.security_headers.frame_options",
"bondy_router.listeners", [
  {datatype, [{atom, off}, string]}
]}.

%% @doc The value for the X-Content-Type-Options header, or `off' to suppress
%% this one header while the others are still sent.
{mapping, "listeners.$name.security_headers.content_type_options",
"bondy_router.listeners", [
  {datatype, [{atom, off}, string]}
]}.

%% @doc The value for the Content-Security-Policy header, or `off' to suppress
%% this one header while the others are still sent.
{mapping, "listeners.$name.security_headers.content_security_policy",
"bondy_router.listeners", [
  {datatype, [{atom, off}, string]}
]}.

%% @doc The value for the Server response header.
{mapping, "listeners.$name.server_header", "bondy_router.listeners", [
  {datatype, string}
]}.

%% --------------------------------------------------------------------------
%% Websocket carrier. Overrides the global `wamp.websocket.*' block for this
%% listener only.
%%
%% `wamp.websocket.buffer.min' and `.max' are the two keys of that block with no
%% counterpart here, deliberately. Since Cowboy 2.13 a Websocket connection
%% inherits the dynamic buffer of the LISTENER it arrived on and
%% `cowboy_websocket' overrides any handler-supplied value, so a WebSocket-
%% specific setting cannot take effect; the listener-level
%% `listeners.$name.http.buffer.min'/`.max' are the ones that do.
%% `bondy_listener_config:?CARRIER_DEFAULTS' excludes them for the same
%% reason, so adding them here would ship two knobs that do nothing.
%% --------------------------------------------------------------------------

%% @doc Defines if server-initiated Websocket PING control messages are
%% enabled. Bondy always answers a client-initiated ping even when this is
%% off. Notice web browsers typically kill websocket connections after 60s
%% and will not initiate PINGs.
{mapping, "listeners.$name.websocket.ping.enabled", "bondy_router.listeners", [
  {datatype, {flag, on, off}}
]}.

%% @doc When websocket.ping.enabled is `on', the maximum time permitted to
%% elapse between the point at which the client finishes transmitting a
%% message and the point it starts sending the next. Not the same as
%% websocket.idle_timeout.
{mapping, "listeners.$name.websocket.ping.idle_timeout",
"bondy_router.listeners", [
  {datatype, {duration, ms}}
]}.

%% @doc When websocket.ping.enabled is `on', how long Bondy waits for a ping
%% response before counting a failed attempt.
{mapping, "listeners.$name.websocket.ping.timeout", "bondy_router.listeners", [
  {datatype, {duration, ms}}
]}.

%% @doc When websocket.ping.enabled is `on', how many missed pings are
%% allowed to time out before the connection is closed.
{mapping, "listeners.$name.websocket.ping.max_attempts",
"bondy_router.listeners", [
  {datatype, integer}
]}.

%% @doc Drops the connection after a period of inactivity. Does not take
%% effect when websocket.ping.enabled is `on' and ping.idle_timeout times
%% ping.max_attempts exceeds it. For some clients this option alone is not
%% enough to keep a connection alive.
{mapping, "listeners.$name.websocket.idle_timeout", "bondy_router.listeners", [
  {datatype, [{duration, ms}, {atom, infinity}]}
]}.

%% @doc Maximum frame size allowed by this Websocket handler. Cowboy closes
%% the connection when a client attempts to send a larger frame. For
%% fragmented frames this applies to the reconstituted frame.
{mapping, "listeners.$name.websocket.max_frame_size",
"bondy_router.listeners", [
  {datatype, bytesize}
]}.

%% @doc Controls when a Websocket connection process hibernates (a
%% hibernation forces a full-sweep garbage collection and shrinks the process
%% heap). `idle' hibernates only on control events, so a connection under
%% sustained traffic never pays a GC per message while quiet connections
%% still shrink; `always' hibernates after every message (lowest memory,
%% highest CPU); `never' disables hibernation.
{mapping, "listeners.$name.websocket.hibernate", "bondy_router.listeners", [
  {datatype, {enum, [never, idle, always]}}
]}.

%% @doc Defines if Websocket compression (the permessage-deflate extension)
%% is enabled. If enabled it is negotiated with supporting clients.
{mapping, "listeners.$name.websocket.compression_enabled",
"bondy_router.listeners", [
  {datatype, {flag, on, off}}
]}.

%% @doc Compression level, 0..9. 0 gives no compression, 1 best speed, 9 best
%% compression.
{mapping, "listeners.$name.websocket.deflate.level", "bondy_router.listeners", [
  {datatype, integer}
]}.

%% @doc How much memory is allocated for the internal compression state,
%% 1..9, where 1 uses minimum memory but is slow and reduces the compression
%% ratio and 9 uses maximum memory for optimal speed.
{mapping, "listeners.$name.websocket.deflate.mem_level",
"bondy_router.listeners", [
  {datatype, integer}
]}.

%% @doc Tunes the compression algorithm: `default' for normal data,
%% `filtered' for data produced by a filter or predictor, `huffman_only' to
%% force Huffman encoding only, `rle' to limit match distances to one.
%% Affects only the compression ratio, never correctness.
{mapping, "listeners.$name.websocket.deflate.strategy",
"bondy_router.listeners", [
  {datatype, {enum, [default, filtered, huffman_only, rle]}}
]}.

%% @doc Using no_takeover can severely limit the usefulness of compression.
{mapping, "listeners.$name.websocket.deflate.server_context_takeover",
"bondy_router.listeners", [
  {datatype, {enum, [takeover, no_takeover]}}
]}.

%% @doc Using no_takeover can severely limit the usefulness of compression.
{mapping, "listeners.$name.websocket.deflate.client_context_takeover",
"bondy_router.listeners", [
  {datatype, {enum, [takeover, no_takeover]}}
]}.

%% @doc The base two logarithm of the server window size (the size of the
%% history buffer), 8..15. Larger values give better compression at the
%% expense of memory.
{mapping, "listeners.$name.websocket.deflate.server_max_window_bits",
"bondy_router.listeners", [
  {datatype, integer}
]}.

%% @doc The base two logarithm of the client window size (the size of the
%% history buffer), 8..15. Larger values give better compression at the
%% expense of memory.
{mapping, "listeners.$name.websocket.deflate.client_max_window_bits",
"bondy_router.listeners", [
  {datatype, integer}
]}.

%% --------------------------------------------------------------------------
%% Server-sent events carrier. Overrides the global `wamp.sse.*' block for this
%% listener only.
%% --------------------------------------------------------------------------

%% @doc Whether SSE keepalive comments are sent.
{mapping, "listeners.$name.sse.ping.enabled", "bondy_router.listeners", [
  {datatype, {flag, on, off}}
]}.

%% @doc Interval between SSE keepalive comments (`:keepalive\n\n') sent to
%% prevent intermediary timeouts.
{mapping, "listeners.$name.sse.ping.interval", "bondy_router.listeners", [
  {datatype, {duration, ms}}
]}.

%% @doc How long a fully quiet SSE stream is kept before its connection is
%% closed. Becomes the listener's connection idle timeout default (the
%% largest held-stream carrier value wins), applied identically over
%% HTTP/1.1 and HTTP/2; a stream that is sending is not quiet, so with
%% keepalives on it never expires.
{mapping, "listeners.$name.sse.idle_timeout", "bondy_router.listeners", [
  {datatype, {duration, ms}}
]}.

%% --------------------------------------------------------------------------
%% Long-poll carrier. Overrides the global `wamp.longpoll.*' block for this
%% listener only.
%% --------------------------------------------------------------------------

%% @doc How long a longpoll receive request blocks waiting for messages
%% before returning an empty 204. This MUST be strictly less than
%% longpoll.idle_timeout, otherwise Cowboy may close the connection before
%% the longpoll reply is sent, stripping the response (including CORS
%% headers) that browser clients depend on.
{mapping, "listeners.$name.longpoll.poll_timeout", "bondy_router.listeners", [
  {datatype, {duration, ms}}
]}.

%% @doc How long an idle longpoll connection is retained between polls.
%% Becomes the listener's connection idle timeout default (the largest
%% held-stream carrier value wins), applied identically over HTTP/1.1 and
%% HTTP/2. It MUST be strictly greater than longpoll.poll_timeout so the
%% server has time to reply before the connection is torn down for
%% inactivity.
{mapping, "listeners.$name.longpoll.idle_timeout", "bondy_router.listeners", [
  {datatype, {duration, ms}}
]}.

%% --------------------------------------------------------------------------
%% MCP carrier. Read by listeners whose `services' name `mcp'. Like every
%% per-listener carrier key these are default-free: the defaults live in
%% bondy_listener_config's carrier defaults, and a default here would
%% materialise MCP keys on listeners that do not serve MCP at all.
%% --------------------------------------------------------------------------

%% @doc A comma separated, priority ordered list of the MCP protocol versions
%% this endpoint accepts (for example `2026-07-28, 2025-11-25').
{mapping, "listeners.$name.mcp.protocol_versions", "bondy_router.listeners", [
  {datatype, string}
]}.

%% @doc The public origin (scheme and host, for example
%% `https://mcp.example.com') this endpoint publishes in documents that must
%% carry one, such as the OAuth protected-resource metadata document. Set it
%% when the listener sits behind a TLS-terminating proxy, where neither the
%% listener's transport nor the request reflects the public URL; when unset,
%% the scheme is derived from the listener's transport and the host from the
%% request.
{mapping, "listeners.$name.mcp.public_base_uri", "bondy_router.listeners", [
  {datatype, string}
]}.

%% @doc DNS-rebinding protection for this MCP endpoint: the `Origin' request
%% header values this listener serves, as a comma separated list. Each entry
%% is either the word `local' — any localhost origin (`localhost',
%% `127.0.0.1' or `[::1]', any scheme and port) — or an explicit origin such
%% as `https://app.example.com'. A request whose `Origin' falls outside the
%% list is refused with 403. Requests WITHOUT an `Origin' header are always
%% served: only browsers send it, and the browser is the rebinding vector.
%% The single word `any' disables the check.
{mapping, "listeners.$name.mcp.allowed_origins", "bondy_router.listeners", [
  {datatype, string}
]}.

%% @doc Maximum size in bytes of an MCP request body on this listener.
{mapping, "listeners.$name.mcp.max_body_size", "bondy_router.listeners", [
  {datatype, bytesize}
]}.

%% @doc Maximum number of concurrent in-flight MCP calls per session on this
%% listener.
{mapping, "listeners.$name.mcp.max_inflight", "bondy_router.listeners", [
  {datatype, integer}
]}.

%% @doc How long a fully quiet held MCP response stream is kept before its
%% connection is closed. Becomes the listener's connection idle timeout
%% default (the largest held-stream carrier value wins), applied identically
%% over HTTP/1.1 and HTTP/2.
{mapping, "listeners.$name.mcp.idle_timeout", "bondy_router.listeners", [
  {datatype, {duration, ms}}
]}.

%% @doc Page size used for MCP list results when the client does not name
%% one.
{mapping, "listeners.$name.mcp.list.default_page_size",
"bondy_router.listeners", [
  {datatype, integer}
]}.

%% @doc Maximum nesting depth accepted when validating a JSON Schema carried
%% by an MCP request on this listener.
{mapping, "listeners.$name.mcp.schema.max_depth", "bondy_router.listeners", [
  {datatype, integer}
]}.

%% @doc Time bound on validating a single JSON Schema carried by an MCP
%% request on this listener.
{mapping, "listeners.$name.mcp.schema.max_validation_ms",
"bondy_router.listeners", [
  {datatype, {duration, ms}}
]}.

%% --------------------------------------------------------------------------
%% TLS material. bondy_listener_config:tls_material/3 is the single reader of
%% these, for both the boot-time validation and live certificate rotation.
%% --------------------------------------------------------------------------

%% @doc Path to the server certificate. Required when transport is tls.
{mapping, "listeners.$name.tls.certfile", "bondy_router.listeners", [
  {datatype, file}
]}.

%% @doc Path to the server private key. Required when transport is tls.
{mapping, "listeners.$name.tls.keyfile", "bondy_router.listeners", [
  {datatype, file}
]}.

%% @doc Path to the CA certificate bundle used to verify peers.
{mapping, "listeners.$name.tls.cacertfile", "bondy_router.listeners", [
  {datatype, file}
]}.

%% @doc A comma separated list of TLS protocol versions to support. At the
%% moment Bondy supports versions 1.2 and 1.3.
{mapping, "listeners.$name.tls.versions", "bondy_router.listeners", [
  {datatype, string}
]}.

%% @doc TLS peer verification mode. Set to verify_peer to request client
%% certificates (mTLS). On its own verify_peer only REQUESTS one: a client
%% presenting none still connects. Set fail_if_no_peer_cert to `on' as well to
%% require it.
{mapping, "listeners.$name.tls.verify", "bondy_router.listeners", [
  {datatype, {enum, [verify_peer, verify_none]}}
]}.

%% @doc Whether a client that presents no certificate is rejected. Only
%% meaningful together with tls.verify = verify_peer, which without this
%% accepts such a client.
{mapping, "listeners.$name.tls.fail_if_no_peer_cert",
"bondy_router.listeners", [
  {datatype, {flag, on, off}}
]}.


%% ---------------------------------------------------------------------------
%% Builds `[{Name, Spec}]' from every `listeners.$name.*' key.
%%
%% This is the only translation the listener block needs. A mapping's target is
%% tokenised literally, so no mapping can write a listener's name into its own
%% target; every key therefore renders into this one term, and each value's
%% coercion and range check happens in the `Coerce' fun below rather than in a
%% per-key translation.
%% ---------------------------------------------------------------------------
{translation, "bondy_router.listeners", fun(Conf0) ->
    Conf = cuttlefish_variable:filter_by_prefix("listeners", Conf0),

    %% Where each `listeners.$name.<Tail>' key lands inside the listener's map.
    %% Each path is where that option's consumer reads it from once
    %% `bondy_config:splat_listener_blocks/0' has copied the entry out to
    %% `bondy_router.<name>.<path>' — ranch and Cowboy option names, not conf
    %% key names. Three paths differ from the conf key's own name:
    %% `websocket.compression_enabled' lands on `compress',
    %% `websocket.deflate.*' on `deflate_opts.*', and `linger.timeout' on
    %% `linger_timeout'.
    Routes = [
        {["transport"], [transport]},
        {["protocol"], [protocol]},
        {["port"], [port]},
        {["path"], [path]},
        {["services"], [services]},
        {["enabled"], [enabled]},
        {["start_phase"], [start_phase]},
        {["ip"], [ip]},
        {["ip_version"], [transport_opts, socket_opts, ip_version]},
        {["acceptors_pool_size"], [transport_opts, num_acceptors]},
        {["max_connections"], [transport_opts, max_connections]},
        {["backlog"], [transport_opts, socket_opts, backlog]},
        {["keepalive"], [transport_opts, socket_opts, keepalive]},
        {["nodelay"], [transport_opts, socket_opts, nodelay]},
        {["reuseport"], [transport_opts, socket_opts, reuseport]},
        {["sndbuf"], [transport_opts, socket_opts, sndbuf]},
        {["recbuf"], [transport_opts, socket_opts, recbuf]},
        {["buffer"], [transport_opts, socket_opts, buffer]},
        {["handshake_timeout"], [transport_opts, handshake_timeout]},
        {["linger", "timeout"], [transport_opts, socket_opts, linger_timeout]},
        {["idle_timeout"], [idle_timeout]},
        %% Top level of the option block: `bondy_bridge_relay_server:init/1'
        %% reads both from `bondy_router.<name>.<key>'.
        {["auth_timeout"], [auth_timeout]},
        {["hibernate"], [hibernate]},
        {["proxy_protocol"], [proxy_protocol, enabled]},
        {["proxy_protocol", "mode"], [proxy_protocol, mode]},
        {["proxy_protocol", "trusted_proxies"],
            [proxy_protocol, trusted_proxies]},
        {["ping", "enabled"], [ping, enabled]},
        {["ping", "idle_timeout"], [ping, idle_timeout]},
        {["ping", "timeout"], [ping, timeout]},
        {["ping", "max_attempts"], [ping, max_attempts]},
        {["http", "active_n"], [protocol_opts, active_n]},
        {["http", "buffer", "min"], [protocol_opts, dynamic_buffer, min]},
        {["http", "buffer", "max"], [protocol_opts, dynamic_buffer, max]},
        {["http", "idle_timeout"], [protocol_opts, idle_timeout]},
        {["http", "inactivity_timeout"], [protocol_opts, inactivity_timeout]},
        {["http", "initial_stream_flow_size"],
            [protocol_opts, initial_stream_flow_size]},
        {["http", "invalid_response_headers"],
            [protocol_opts, invalid_response_headers]},
        {["http", "linger", "timeout"], [protocol_opts, linger_timeout]},
        {["http", "max_authority_length"],
            [protocol_opts, max_authority_length]},
        {["http", "max_authorization_header_value_length"],
            [protocol_opts, max_authorization_header_value_length]},
        {["http", "max_concurrent_streams"],
            [protocol_opts, max_concurrent_streams]},
        {["http", "max_cookie_header_value_length"],
            [protocol_opts, max_cookie_header_value_length]},
        {["http", "max_cookies"], [protocol_opts, max_cookies]},
        {["http", "max_empty_lines"], [protocol_opts, max_empty_lines]},
        {["http", "max_header_name_length"],
            [protocol_opts, max_header_name_length]},
        {["http", "max_header_value_length"],
            [protocol_opts, max_header_value_length]},
        {["http", "max_headers"], [protocol_opts, max_headers]},
        {["http", "max_keepalive"], [protocol_opts, max_keepalive]},
        {["http", "max_method_length"], [protocol_opts, max_method_length]},
        {["http", "max_request_line_length"],
            [protocol_opts, max_request_line_length]},
        {["http", "max_skip_body_length"],
            [protocol_opts, max_skip_body_length]},
        {["http", "request_timeout"], [protocol_opts, request_timeout]},
        {["http", "reset_idle_timeout_on_send"],
            [protocol_opts, reset_idle_timeout_on_send]},
        {["http", "sendfile"], [protocol_opts, sendfile]},
        %% NOT under `protocol_opts': the value is consumed by
        %% `bondy_listener_ranch', which derives the ALPN socket option and
        %% Cowboy's `protocols'/`alpn_default_protocol' from it — it is not
        %% itself a Cowboy option.
        {["http", "versions"], [http_versions]},
        {["cors", "enabled"], [cors, enabled]},
        {["cors", "allowed_origins"], [cors, allowed_origins]},
        {["cors", "allowed_methods"], [cors, allowed_methods]},
        {["cors", "allowed_headers"], [cors, allowed_headers]},
        {["cors", "max_age"], [cors, max_age]},
        {["security_headers", "enabled"], [security_headers, enabled]},
        {["security_headers", "hsts"], [security_headers, hsts]},
        {["security_headers", "frame_options"],
            [security_headers, frame_options]},
        {["security_headers", "content_type_options"],
            [security_headers, content_type_options]},
        {["security_headers", "content_security_policy"],
            [security_headers, content_security_policy]},
        {["server_header"], [server_header]},
        {["websocket", "ping", "enabled"], [websocket, ping, enabled]},
        {["websocket", "ping", "idle_timeout"],
            [websocket, ping, idle_timeout]},
        {["websocket", "ping", "timeout"], [websocket, ping, timeout]},
        {["websocket", "ping", "max_attempts"],
            [websocket, ping, max_attempts]},
        {["websocket", "idle_timeout"], [websocket, idle_timeout]},
        {["websocket", "max_frame_size"], [websocket, max_frame_size]},
        {["websocket", "hibernate"], [websocket, hibernate]},
        {["websocket", "compression_enabled"], [websocket, compress]},
        {["websocket", "deflate", "level"], [websocket, deflate_opts, level]},
        {["websocket", "deflate", "mem_level"],
            [websocket, deflate_opts, mem_level]},
        {["websocket", "deflate", "strategy"],
            [websocket, deflate_opts, strategy]},
        {["websocket", "deflate", "server_context_takeover"],
            [websocket, deflate_opts, server_context_takeover]},
        {["websocket", "deflate", "client_context_takeover"],
            [websocket, deflate_opts, client_context_takeover]},
        {["websocket", "deflate", "server_max_window_bits"],
            [websocket, deflate_opts, server_max_window_bits]},
        {["websocket", "deflate", "client_max_window_bits"],
            [websocket, deflate_opts, client_max_window_bits]},
        {["sse", "ping", "enabled"], [sse, ping, enabled]},
        {["sse", "ping", "interval"], [sse, ping, interval]},
        {["sse", "idle_timeout"], [sse, idle_timeout]},
        {["longpoll", "poll_timeout"], [longpoll, poll_timeout]},
        {["longpoll", "idle_timeout"], [longpoll, idle_timeout]},
        {["mcp", "protocol_versions"], [mcp, protocol_versions]},
        {["mcp", "allowed_origins"], [mcp, allowed_origins]},
        {["mcp", "public_base_uri"], [mcp, public_base_uri]},
        {["mcp", "max_body_size"], [mcp, max_body_size]},
        {["mcp", "max_inflight"], [mcp, max_inflight]},
        {["mcp", "idle_timeout"], [mcp, idle_timeout]},
        {["mcp", "list", "default_page_size"],
            [mcp, list, default_page_size]},
        {["mcp", "schema", "max_depth"], [mcp, schema, max_depth]},
        {["mcp", "schema", "max_validation_ms"],
            [mcp, schema, max_validation_ms]},
        {["tls", "certfile"], [tls, certfile]},
        {["tls", "keyfile"], [tls, keyfile]},
        {["tls", "cacertfile"], [tls, cacertfile]},
        {["tls", "versions"], [tls, versions]},
        {["tls", "verify"], [tls, verify]},
        {["tls", "fail_if_no_peer_cert"], [tls, fail_if_no_peer_cert]}
    ],

    Trim = fun(S) -> string:trim(S) end,

    Split = fun(V) ->
        [Trim(S) || S <- string:tokens(V, ","), Trim(S) =/= ""]
    end,

    %% Every diagnostic below is prefixed with the full conf key, including
    %% the listener name, so a render failure among 90 possible keys across
    %% however many listeners names the one that is wrong.
    FullKey = fun(Name, Tail) ->
        "listeners." ++ Name ++ "." ++ lists:flatten(lists:join(".", Tail))
    end,

    %% Folded from the four `wamp.websocket.deflate.*' translations. These are
    %% the only validation those keys ever had, and a `{validators, ...}' cannot
    %% replace them here (see the note above the mappings).
    Range = fun(Key, Value, Lo, Hi) ->
        case is_integer(Value) andalso Value >= Lo andalso Value =< Hi of
            true ->
                Value;
            false ->
                cuttlefish:invalid(
                    Key ++ " should be an integer between " ++
                        integer_to_list(Lo) ++ " and " ++ integer_to_list(Hi)
                )
        end
    end,

    %% One lower-bound check, called with Lo = 1 for a positive integer, 0 for a
    %% non-negative one and -1 for `linger.timeout'.
    Min = fun(Key, Value, Lo) ->
        case is_integer(Value) andalso Value >= Lo of
            true ->
                Value;
            false ->
                cuttlefish:invalid(
                    Key ++ " should be an integer greater than or equal to " ++
                        integer_to_list(Lo)
                )
        end
    end,

    %% cuttlefish's own `port_number' predicate rather than an equivalent
    %% `0 =< N =< 65535' range: the two agree for every value, and this is the
    %% form the check has everywhere else.
    PortNumber = fun(Key, Value) ->
        case (Value band bnot 16#ffff) =:= 0 of
            true ->
                Value;
            false ->
                cuttlefish:invalid(
                    Key ++ " should be an integer between 0 and 65535"
                )
        end
    end,

    %% Folded from the two equivalent `*.ip_version' translations.
    Family = fun(Key, V) ->
        case Trim(V) of
            "4" ->
                inet;
            "6" ->
                inet6;
            Other ->
                cuttlefish:invalid(
                    Key ++ " invalid IP version: " ++ Other ++
                        ". Value should be 4 or 6."
                )
        end
    end,

    %% ranch's `versions' socket option takes atoms, not the strings an operator
    %% writes.
    Versions = fun(Key, V) ->
        [
            case S of
                "1.2" -> 'tlsv1.2';
                "1.3" -> 'tlsv1.3';
                Bad -> cuttlefish:invalid(Key ++ " invalid TLS version " ++ Bad)
            end
         || S <- Split(V)
        ]
    end,

    %% Rendered to Cowboy's own protocol names (`http' = HTTP/1.1,
    %% `http2' = HTTP/2), order preserved: the first is the preferred version.
    HttpVersions = fun(Key, V) ->
        case
            [
                case S of
                    "1.1" ->
                        http;
                    "2" ->
                        http2;
                    Bad ->
                        cuttlefish:invalid(
                            Key ++ " invalid HTTP version " ++ Bad
                        )
                end
             || S <- Split(V)
            ]
        of
            [] ->
                cuttlefish:invalid(
                    Key ++ " must list at least one HTTP version"
                );
            Parsed ->
                Parsed
        end
    end,

    %% Parsed HERE, at render time, rather than left to
    %% `bondy_listener_config:to_address/2', which would also convert a string:
    %% failing here is a `cuttlefish:invalid' naming the key while the file is
    %% being read, instead of an `{invalid_listener, Name, {unresolvable_ip, _}}'
    %% at boot. It also fixes what `ip' accepts: a literal address only, since
    %% `inet:parse_address/1' does not resolve names. A hostname is rejected
    %% while the file is being read. And it keeps one type across both cases:
    %% `resolve_ip/3''s only other outcome, the `admin'/`metrics' narrowing,
    %% is an address tuple.
    %%
    %% `inet:parse_address/1' is documented to return only `{error, einval}'
    %% on failure, never anything else, so the `{error, _}' clause below is
    %% not known to be reachable; it exists so an unanticipated error shape
    %% is still a diagnostic rather than a `case_clause' crash in the
    %% generator.
    Address = fun(Key, V) ->
        case inet:parse_address(Trim(V)) of
            {ok, Parsed} ->
                Parsed;
            {error, _} ->
                cuttlefish:invalid(Key ++ " invalid IP address " ++ V)
        end
    end,

    %% Every path below is a key checked as a positive integer, and every one
    %% has datatype plain `{datatype, integer}' — never a type admitting an atom
    %% such as `infinity' — so checking the raw conf value is safe. This list is
    %% consulted only for a key the operator actually wrote; a value
    %% defaulted downstream in `bondy_listener_config' (for example
    %% `max_connections' defaulting to `infinity') never reaches here.
    PosIntegerPaths = [
        ["acceptors_pool_size"],
        ["max_connections"],
        ["backlog"],
        ["ping", "max_attempts"],
        ["websocket", "ping", "max_attempts"],
        ["http", "active_n"],
        ["http", "max_authority_length"],
        ["http", "max_authorization_header_value_length"],
        ["http", "max_concurrent_streams"],
        ["http", "max_cookie_header_value_length"],
        %% Positive, not non-negative, though cowlib's own type admits 0.
        %% Zero rejects every request carrying a Cookie header at all, which
        %% would break the OIDC and CSRF flows on the listener. There is no
        %% Bondy use for that, and no way to reach it by accident either: the
        %% key is default-free, so an operator with no opinion leaves it unset
        %% and gets cowlib's 100.
        ["http", "max_cookies"],
        ["http", "max_empty_lines"],
        ["http", "max_header_name_length"],
        ["http", "max_header_value_length"],
        ["http", "max_headers"],
        ["http", "max_keepalive"],
        ["http", "max_method_length"],
        ["http", "max_request_line_length"],
        ["http", "max_skip_body_length"],
        ["mcp", "max_inflight"],
        ["mcp", "list", "default_page_size"],
        ["mcp", "schema", "max_depth"]
    ],

    %% The three conversions the `cors' and `security_headers' members need.
    %%
    %% This section renders each member SEPARATELY and completes nothing. It
    %% used to hand the consumers a total map, restating all ten of their
    %% default values here, because `bondy_http_cors:build_headers/2' reads its
    %% members with `maps:get/2' and a partial map raised `badkey' on the
    %% request path. Both
    %% consumers now merge their own `default_config/0' UNDER whatever arrives
    %% (`bondy_http_cors:config_from_req/1',
    %% `bondy_http_security_headers:init/1'), so restating those values here
    %% would be a second copy of a security-relevant policy with nothing keeping
    %% the two in step. It also defeated
    %% `bondy_listener_config:option_defaults(tls, http)': a completed block
    %% carries `hsts => undefined', an operator value, which wins the merge — so
    %% a TLS listener stating any one header lost HSTS
    %% (`a_rendered_partial_block_does_not_defeat_the_hsts_default').
    Origins = fun(V) ->
        case Trim(V) of
            "*" -> '*';
            "auto" -> auto;
            _ -> [list_to_binary(S) || S <- Split(V)]
        end
    end,

    %% One clause is total here: every key it serves has `{datatype, string}',
    %% and cuttlefish delivers a string for that datatype.
    Bin = fun(V) when is_list(V) -> list_to_binary(V) end,

    %% A security-header value, or `off' to suppress that ONE header while the
    %% others are still sent. `security_headers.enabled = off' is the all-or-
    %% nothing switch and stays as it is.
    %%
    %% `off' becomes `undefined', which is not a new convention:
    %% `bondy_http_security_headers:init/1' merges its own `default_config/0'
    %% UNDER the listener's block and emits only the members that are not
    %% `undefined' (`build_headers/2'), so this reuses a meaning the consumer
    %% already implements rather than adding a second mechanism. It also beats
    %% the HSTS default a TLS listener gets, because that merge fills only
    %% ABSENT keys.
    %%
    %% `off' cannot collide with a real value: those are `max-age=...', `DENY',
    %% `SAMEORIGIN', `nosniff' and a CSP. The datatype is
    %% `[{atom, off}, string]', an EXTENDED type — cuttlefish parses as `atom'
    %% and accepts only the literal `off', so any other word falls through to
    %% `string' (`cuttlefish_generator:transform_extended_type/2'). `office' is
    %% a value, not a typo for `off'.
    Header = fun
        (off) -> undefined;
        (V) when is_list(V) -> list_to_binary(V)
    end,

    Value = fun
        (["services"], V, _Name) ->
            [list_to_atom(S) || S <- Split(V)];
        (["ip"] = Tail, V, Name) ->
            Address(FullKey(Name, Tail), V);
        (["ip_version"] = Tail, V, Name) ->
            Family(FullKey(Name, Tail), V);
        (["tls", "versions"] = Tail, V, Name) ->
            Versions(FullKey(Name, Tail), V);
        (["http", "versions"] = Tail, V, Name) ->
            HttpVersions(FullKey(Name, Tail), V);
        %% Version strings are carried opaquely: which versions the endpoint
        %% can actually speak is the MCP service's own knowledge, and a copy
        %% of that list here would drift from it.
        (["mcp", "protocol_versions"] = Tail, V, Name) ->
            case [list_to_binary(S) || S <- Split(V)] of
                [] ->
                    cuttlefish:invalid(
                        FullKey(Name, Tail) ++
                            " must list at least one MCP protocol version"
                    );
                Parsed ->
                    Parsed
            end;
        %% `any` disables the check; otherwise a list of rules, each the
        %% atom `local` or an explicit origin lowercased here — origin
        %% comparison is case-insensitive and the handler lowercases the
        %% request header before matching
        %% (`bondy_mcp_http_handler:origin_allowed/2`).
        (["mcp", "allowed_origins"] = Tail, V, Name) ->
            case Split(V) of
                [] ->
                    cuttlefish:invalid(
                        FullKey(Name, Tail) ++
                            " must be `any' or list at least one origin"
                    );
                ["any"] ->
                    any;
                Entries ->
                    lists:member("any", Entries) andalso
                        cuttlefish:invalid(
                            FullKey(Name, Tail) ++
                                " admits `any' only as the sole entry"
                        ),
                    [
                        case E of
                            "local" -> local;
                            _ -> list_to_binary(string:lowercase(E))
                        end
                     || E <- Entries
                    ]
            end;
        (["mcp", "public_base_uri"], V, _Name) ->
            Bin(V);
        (["port"] = Tail, V, Name) ->
            PortNumber(FullKey(Name, Tail), V);
        %% A max-age is a non-negative number of seconds. Rendered as a BINARY:
        %% `bondy_http_cors:build_headers/2' puts it straight into the
        %% `access-control-max-age' header value.
        (["cors", "max_age"] = Tail, V, Name) ->
            integer_to_binary(Min(FullKey(Name, Tail), V, 0));
        (["cors", "allowed_origins"], V, _Name) ->
            Origins(V);
        (["cors", "allowed_methods"], V, _Name) ->
            Bin(V);
        (["cors", "allowed_headers"], V, _Name) ->
            Bin(V);
        %% `Bin', not a converter with an empty-string clause. The deleted
        %% completion had one, because it turned its OWN default of `""' into the
        %% `undefined' that `bondy_http_security_headers:build_headers/1' reads
        %% as "do not send this header". No operator value can be an empty
        %% string: `key =' with nothing after it is a conf SYNTAX error, and
        %% `key = ""' renders the two-character string `""' — both measured, and
        %% the first is pinned by
        %% `an_empty_security_header_value_is_a_syntax_error'. So a clause for it
        %% would be dead. An embedded caller can still put `undefined' straight
        %% into the block, and the consumer honours it.
        (["security_headers", "hsts"], V, _Name) ->
            Header(V);
        (["security_headers", "frame_options"], V, _Name) ->
            Header(V);
        (["security_headers", "content_type_options"], V, _Name) ->
            Header(V);
        (["security_headers", "content_security_policy"], V, _Name) ->
            Header(V);
        %% Only the FLAT key is checked. `["http", "linger", "timeout"]' — the
        %% `http.' sibling, which reaches Cowboy's `linger_timeout' rather than
        %% the socket option — deliberately falls through to the pass-through
        %% clause below and is not range-checked. The asymmetry is inherited,
        %% not derived from a difference between the two options.
        (["linger", "timeout"] = Tail, V, Name) ->
            Min(FullKey(Name, Tail), V, -1);
        (["websocket", "deflate", "level"] = Tail, V, Name) ->
            Range(FullKey(Name, Tail), V, 0, 9);
        (["websocket", "deflate", "mem_level"] = Tail, V, Name) ->
            Range(FullKey(Name, Tail), V, 1, 9);
        (["websocket", "deflate", "server_max_window_bits"] = Tail, V, Name) ->
            Range(FullKey(Name, Tail), V, 8, 15);
        (["websocket", "deflate", "client_max_window_bits"] = Tail, V, Name) ->
            Range(FullKey(Name, Tail), V, 8, 15);
        (Tail, V, Name) ->
            case lists:member(Tail, PosIntegerPaths) of
                true -> Min(FullKey(Name, Tail), V, 1);
                false -> V
            end
    end,

    %% No path in `Routes' is deeper than three, so this needs no recursion.
    Put = fun
        ([K], V, M) ->
            maps:put(K, V, M);
        ([K1, K2], V, M) ->
            maps:put(K1, maps:put(K2, V, maps:get(K1, M, #{})), M);
        ([K1, K2, K3], V, M) ->
            Inner1 = maps:get(K1, M, #{}),
            Inner2 = maps:get(K2, Inner1, #{}),
            maps:put(K1, maps:put(K2, maps:put(K3, V, Inner2), Inner1), M)
    end,

    Path = fun(Name, Tail) ->
        case lists:keyfind(Tail, 1, Routes) of
            {_, P} ->
                P;
            false ->
                %% Only reachable for a mapping declared above and left out of
                %% `Routes': cuttlefish discards keys with no mapping before a
                %% translation runs (`transform_datatypes/3'), silently under
                %% the release's `--allow_extra'. Without this the operator's
                %% setting would vanish with no diagnostic.
                cuttlefish:invalid(
                    FullKey(Name, Tail) ++ ": no listener option path"
                )
        end
    end,

    Specs = lists:foldl(
        fun({["listeners", Name | Tail], V}, Acc) ->
            Spec = Put(
                Path(Name, Tail), Value(Tail, V, Name), maps:get(Name, Acc, #{})
            ),
            maps:put(Name, Spec, Acc)
        end,
        #{},
        Conf
    ),

    %% Sorted by name so the rendered inventory is stable across renders of the
    %% same `bondy.conf'.
    [
        {list_to_atom(Name), Spec}
     || {Name, Spec} <- lists:sort(maps:to_list(Specs))
    ]
end}.


%% =============================================================================
%% API GATEWAY
%% =============================================================================



%% -----------------------------------------------------------------------------
%% @doc The filename of a the API Gatyeway JSON configuration file, which
%% allows you to statically configure the API GAteway with a list of API
%% Specifications.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "api_gateway.config_file",
"bondy_router.api_gateway.config_file", [
  {datatype, file}
]}.


%% =============================================================================
%% WAMP
%% =============================================================================



%% -----------------------------------------------------------------------------
%% @doc Not currently working, leave the value as 'session'
%% @end
%% -----------------------------------------------------------------------------
{mapping, "wamp.connection_lifetime",
"bondy_router.wamp_connection_lifetime", [
  {default, session},
  %% {datatype, {enum, [session, connection]}},
  {datatype, {enum, [session]}},
  hidden
]}.

%% -----------------------------------------------------------------------------
%% @doc The default timeout for WAMP (RPC) Calls when the CALL.Options.timeout
%% property is not used. This value will be restricted by the
%% 'wamp.max_call_timeout' property
%% @end
%% -----------------------------------------------------------------------------
{mapping, "wamp.call_timeout",
"bondy_router.wamp_call_timeout", [
  {default, "30s"}, % Long enough but not infinity
  {datatype, {duration, ms}}
]}.

%% -----------------------------------------------------------------------------
%% @doc Controls the production of WAMP meta events (wamp.session.*,
%% wamp.subscription.*, wamp.registration.* topics).
%% - demand (default): a meta event is produced only when at least one
%%   session (on any node) has a subscription matching the meta topic.
%%   Aggregate metrics are always maintained regardless.
%% - on: always produce meta events (pre-1.0 behaviour).
%% - off: never produce meta events.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "wamp.meta_events",
"bondy_router.wamp_meta_events", [
  {default, demand},
  {datatype, {enum, [demand, on, off]}}
]}.


%% -----------------------------------------------------------------------------
%% @doc The maximum timeout value for WAMP (RPC) Calls for the CALL.Options.
%% timeout or the wamp.call_timeout default.
%% According to the protocol a missing value or a value
%% of 0 disables the timeout feature, but we disagree, there should be no such
%% thing as "infinite timeout". Set it to 24 hours, a week or even a year if
%% you want.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "wamp.max_call_timeout",
"bondy_router.wamp_max_call_timeout", [
{default, "10m"}, % Long enough but not infinity
{datatype, {duration, ms}}
]}.

{mapping, "wamp.message_retention.enabled",
"bondy_router.wamp_message_retention.enabled", [
  {datatype, flag},
  {default, on}
]}.

%% How will Bondy store the retained messages.
{mapping, "wamp.message_retention.storage_type",
"bondy_router.wamp_message_retention.storage_type", [
  {default, ram},
  {datatype, {enum, [ram, disk, ram_disk]}}
]}.

%% Maximum number of messages that can be store in a Bondy node.
%% Once the max has been reached no more events will be stored.
%% A value of 0 means no limit is enforced.
{mapping, "wamp.message_retention.max_messages",
"bondy_router.wamp_message_retention.max_messages", [
  {default, "1000000"},
  {validators, ["pos_integer"]},
  {datatype, integer}
]}.


%% Maximum space in memory used by retained messages.
%% Once the max has been reached no more events will be stored.
%% A value of 0 means no limit is enforced.
{mapping, "wamp.message_retention.max_memory",
"bondy_router.wamp_message_retention.max_memory", [
  {default, "1GB"},
  {datatype, bytesize}
]}.

%% The max size for an event message.
%% All events whose size exceeds this value will not be retained.
{mapping, "wamp.message_retention.max_message_size",
"bondy_router.wamp_message_retention.max_message_size", [
  {default, "64KB"},
  {datatype, bytesize}
]}.

%% The default Time To Live (TTL) in seconds Bondy will use for all retained
%% messages not specifying a specific TTL.
%% A value of 0 means a message will not be expired.
{mapping, "wamp.message_retention.default_ttl",
"bondy_router.wamp_message_retention.default_ttl", [
  {default, "0"},
  {datatype, [integer, {duration, s}]}
]}.

{mapping, "request_timeout",
"bondy_router.request_timeout", [
  {default, "20s"}, % Long enough but not infinity
  {datatype, {duration, ms}},
  hidden
]}.


{mapping, "wamp.uri.strictness",
"wamp.uri_strictness", [
  {default, loose},
  {datatype, {enum, [loose, strict]}}
]}.






%% In addition to JSON and Msgpack, Bondy supports Erlang External Term Format
%% ("erl") and BERT ("bert") serializations.
%%
%% The WAMP v2 Raw Socket protocol defines a code (integer from 1..15) for each
%% serializer, and specifies json and msgpack to be assigned to slots 1 and 2
%% respectively, leaving the remaining 13 slots for future assignment.
%%
%% Because some clients might be hardcoded to expect certain serializers in
%% certain slots, we need to make the slots assigned to "erl" and "bert"
%% configurable.
%%
%% For example, in order to assign the erl serializer to a slot 15 and bert
%% to slot 4 we write the following configuration line:
%%
%% wamp.serializers.erl = 15
%% wamp.serializers.bert = 4
{mapping, "wamp.serializers.erl",
"bondy_router.wamp_serializers.erl", [
  {datatype, integer},
  {default, 15}
]}.

{mapping, "wamp.serializers.bert",
"bondy_router.wamp_serializers.bert", [
  {datatype, integer},
  {default, 4}
]}.

% {translation,
% "bondy_router.wamp_serializers",
% fun(Conf0) ->
%     Conf1 = cuttlefish_variable:filter_by_prefix(
%       "wamp.serializers", Conf0),
%     Fun = fun ({[_, _, _, Key], Value}, Acc) ->
%       case lists:member(Key, ["erl", "bert"]) of
%         true when is_integer(Value) andalso (Value >= 3 orelse Value =< 15) ->
%           [{Value, list_to_atom(Key)} | Acc];
%         true ->
%           cuttlefish:invalid("value should be an integer between 3 and 15");
%         false ->
%           cuttlefish:invalid("key should be one of 'erl' or 'bert'")
%       end
%     end,
%     lists:foldl(Fun, [], Conf1)
% end}.




%% @doc Where WAMP connection processes (Websocket and raw TCP/TLS) keep
%% their mailbox: off_heap avoids scanning a deep mailbox on every GC (the
%% fan-out delivery path can queue one EVENT per subscription), at a small
%% constant cost per received message. on_heap is the BEAM default.
{mapping, "wamp.connection.message_queue_data",
"bondy_router.wamp_connection.message_queue_data", [
  {default, off_heap},
  {datatype, {enum, [off_heap, on_heap]}},
  hidden
]}.



%% =============================================================================
%% WAMP OVER HTTP (long-poll and SSE)
%% =============================================================================
%%
%% These settings apply ONLY to the two WAMP transports carried over HTTP:
%% long-poll and Server-Sent Events. A WebSocket or raw-socket session never
%% reaches any of them.
%%
%% They exist because those two transports have no process holding a socket for
%% the session's lifetime. A long-poll client is not connected at all between
%% `/receive' calls, so a message routed to it in that gap has nowhere to go
%% unless something parks it; `bondy_http_transport_queue' is that parking
%% place, and these are its bounds. See that module for the full rationale.
%%
%% Node-wide rather than per listener: one ETS partition ring and one eviction
%% sweeper serve every HTTP transport on the node, whichever listener the
%% request arrived on.

%% @doc How long a WAMP-over-HTTP session survives with no HTTP request
%% touching it. This is the SESSION's deadline, not the queue's — it closes the
%% `bondy_http_transport_session' process and discards whatever it still holds.
{mapping, "wamp.http_transport.idle_timeout",
"bondy_router.http_transport.idle_timeout", [
  {default, "1h"},
  {datatype, {duration, ms}}
]}.

%% @doc Most messages held for one disconnected transport before the oldest is
%% evicted to make room.
{mapping, "wamp.http_transport.queue.max_messages",
"bondy_router.http_transport.queue.max_messages", [
    {default, 1000},
    {datatype, integer},
    {validators, ["pos_integer"]}
]}.

%% @doc Most bytes held for one disconnected transport before the oldest
%% message is evicted to make room. Enforced alongside `max_messages': whichever
%% bound is reached first evicts.
{mapping, "wamp.http_transport.queue.max_bytes",
"bondy_router.http_transport.queue.max_bytes", [
    {default, "10MB"},
    {datatype, bytesize}
]}.

%% @doc How long a queued message stays deliverable. A message older than this
%% is dropped by the eviction sweep, and is skipped if a client polls for it
%% first, on the assumption that a client absent this long no longer wants it.
{mapping, "wamp.http_transport.queue.message_ttl",
"bondy_router.http_transport.queue.message_ttl", [
  {default, "5m"},
  {datatype, {duration, ms}}
]}.

%% @doc How often the TTL eviction sweep runs across every partition.
{mapping, "wamp.http_transport.queue.eviction_interval",
"bondy_router.http_transport.queue.eviction_interval", [
  {default, "5s"},
  {datatype, {duration, ms}}
]}.

%% @doc How many ETS partitions the queue is sharded across. Every entry for one
%% transport lives in a single partition, so this trades table contention across
%% transports against the cost of a sweep. Defaults to the scheduler count,
%% which is why this mapping carries no `{default, ...}': that number is not
%% knowable when the schema is written, so `bondy_config:configure_http_
%% transport/0' supplies it at boot instead.
{mapping, "wamp.http_transport.queue.partitions",
"bondy_router.http_transport.queue.partitions", [
    {datatype, integer},
    {validators, ["pos_integer"]}
]}.

%% =============================================================================
%% CLUSTERING
%% =============================================================================



%% @doc Defines whether a Bondy node should perform a cluster leave operation
%% automatically when it is being shutdown.
{mapping, "cluster.automatic_leave",
"bondy_router.automatic_leave", [
  {default, off},
  {datatype, flag}
]}.

%% @doc Defines a list of ip_address:port this node will use to listen for
%% incoming cluster connections. The value accepts the following input formats
%% - 192.168.50.174:18086
%% - [192.168.50.174:18086]
%% - 192.168.50.174:18086, 192.168.50.180:18086
%% - [192.168.50.174:18086, 192.168.50.180:18086]
%%
%% If this option is provided Partisan will ignore 'cluster.peer_port' but notice that the value for peer port is still required for some discovery strategies used by partisan_peer_discovery_agent e.g. dns discovery which
{mapping, "cluster.listen_addresses",
"partisan.listen_addrs", [
  {datatype, string}
]}.


{translation,

  "partisan.listen_addrs",
  fun(Conf0) ->
      Conf = cuttlefish_variable:filter_by_prefix(
        "cluster.listen_addresses", Conf0
      ),

      Parse = fun(Val, ForceList) ->
         case string:split(Val, ",") of
            [Val] when ForceList == true ->
              [list_to_binary(Val)];
            [Val] when ForceList == false ->
              list_to_binary(Val);
            L when is_list(L) ->
              [list_to_binary(E) || E <- L]
          end
      end,

      lists:foldl(
          fun
            ({["cluster", "listen_addresses"], Value0}, Acc) ->
              %% Remove empty spaces
              Value1 = unicode:characters_to_list(
                string:replace(Value0, " ", "", all)
              ),
              %% parse list
              case string:trim(Value1, both, "[]") of
                Value1 ->
                  %% No list, but maybe list without [ ]
                  [Parse(Value1, false) | Acc];
                Trimmed ->
                  %% A list
                  [Parse(Trimmed, true) | Acc]
              end;

            ({["cluster", "listen_addresses"], Value}, Acc) ->
              [list_to_binary(Value) | Acc]

          end,
          [],
          Conf
      )
  end
}.

%% @doc Defines the port to use for the cluster TCP connection
{mapping, "cluster.peer_ip",
"partisan.peer_ip", [
  {datatype, string},
  {validators, ["ip_address"]}
]}.

%% @doc Defines the port to use for the cluster TCP connection
{mapping, "cluster.peer_port",
"partisan.peer_port", [
  {default, 18086},
  {datatype, integer}
]}.

%% @doc Defines the default number of TCP connections for the cluster TCP stack
{mapping, "cluster.parallelism",
"partisan.parallelism", [
  {default, 1},
  {datatype, integer}
]}.

%% @doc Maximum size of an inter-node (Partisan peer) message. It bounds the
%% length-prefixed framing on both the connect and accept paths, so an oversized
%% frame is rejected before it is assembled or decoded — closing a
%% pre-authentication memory-exhaustion / decompression-bomb vector. A peer that
%% sends a frame over this cap has its connection closed (the socket reports
%% 'emsgsize') and is dropped from the active view until it reconnects. Raise it
%% only if the cluster legitimately exchanges peer messages larger than the
%% default, for example very large application broadcasts or anti-entropy deltas.
{mapping, "cluster.max_message_size",
"partisan.max_message_size", [
  {default, "64MB"},
  {datatype, bytesize}
]}.

%% @doc Maximum number of inbound Partisan RPC requests (partisan_rpc /
%% partisan_erpc / partisan_gen_server calls from a remote node) that may be
%% executing concurrently on this node. Requests received past this cap fail
%% immediately with `{badrpc, overloaded}` (or, for callers still using the
%% legacy v5 RPC framing, `{badrpc, {'EXIT', overloaded}}`) instead of being
%% queued or spawned unboundedly. Set to `infinity` to disable the cap.
{mapping, "cluster.rpc_max_concurrency",
"partisan.rpc_max_concurrency", [
  {default, 10000},
  {datatype, [integer, {atom, infinity}]}
]}.

%% @doc Maximum number of messages that may be queued to a single Partisan
%% connection process before further sends to it are refused with
%% `{error, overloaded}`. Dispatch to a connection is an unbounded mailbox by
%% default (`infinity`, preserving the historical behaviour), so a sender
%% faster than the peer's socket can otherwise grow that mailbox until the
%% node runs out of memory. Lower this to fail fast instead.
{mapping, "cluster.connection_high_watermark",
"partisan.connection_high_watermark", [
  {default, infinity},
  {datatype, [{atom, infinity}, integer]}
]}.

{mapping, "cluster.channels.default.parallelism",
"bondy_router.channels.undefined.parallelism", [
  {default, 1},
  {datatype, integer}
]}.

{mapping, "cluster.channels.default.compression",
"bondy_router.channels.undefined.compression", [
  {default, off},
  {datatype, [flag, integer]}
]}.


{mapping, "cluster.channels.data.parallelism",
"bondy_router.channels.data.parallelism", [
  {default, 2},
  {datatype, integer}
]}.

{mapping, "cluster.channels.data.compression",
"bondy_router.channels.data.compression", [
  {default, off},
  {datatype, [flag, integer]}
]}.


{mapping, "cluster.channels.control_plane.parallelism",
"bondy_router.channels.partisan_membership.parallelism", [
  {default, 1},
  {datatype, integer}
]}.

{mapping, "cluster.channels.control_plane.compression",
"bondy_router.channels.partisan_membership.compression", [
  {default, on},
  {datatype, [flag, integer]}
]}.


%% -----------------------------------------------------------------------------
%% @doc Number of connections Partisan opens for the `wamp_relay' channel,
%% which carries the WAMP data plane between nodes. Each connection is one
%% ordered pipe — a flow is pinned to a single connection by its partition
%% key — with its own sender and receiver process on each side, so this is
%% the relay's ingress/egress process parallelism. Size it for data-plane
%% throughput, not like the control-plane channels.
%%
%% AUTHORITATIVE. `bondy_config:setup_partisan_channels/0' keeps a matching
%% fallback map for boots that never render cuttlefish; config set here wins
%% over it, so the two MUST agree or the fallback's value is dead.
%% @end
%% -----------------------------------------------------------------------------
{mapping, "cluster.channels.wamp_relay.parallelism",
"bondy_router.channels.wamp_relay.parallelism", [
  {default, 8},
  {datatype, integer}
]}.

{mapping, "cluster.channels.wamp_relay.compression",
"bondy_router.channels.wamp_relay.compression", [
  {default, off},
  {datatype, [flag, integer]}
]}.

%% {translation,
%% "bondy_router.channels",
%% fun(Conf0) ->
%%     Conf = cuttlefish_variable:filter_by_prefix(
%%       "cluster.channels", Conf0
%%     ),
%%     Dict = lists:foldl(
%%         fun
%%           ({[_, _, Channel, "parallelism"], Value}, Acc) ->
%%             (is_integer(Value) andalso Value > 1)
%%               orelse cuttlefish:invalid(
%%                 "invalid value for property 'parallelism'"
%%               ),
