%% =============================================================================
%% Standalone rebar3 project. This is the Jepsen-facing OTP wrapper
%% (HTTP shim + 3-node disterl cluster wiring) consumed by the Clojure
%% Jepsen test under `../jepsen.bondymst/`.
%%
%% It exercises the full stack, so it depends on `bondy_db` (the consumer
%% facade), which transitively pulls `bondy_oplog` and `bondy_mst`. It is a
%% sibling project of the bondy umbrella — `rebar3 compile` of the umbrella
%% never pulls cowboy, jsx, or this app into the apps' builds. The release is
%% built by running rebar3 inside this directory (see the umbrella `justfile`:
%% `rel-jepsen`).
%% =============================================================================

{minimum_otp_vsn, "R26"}.

{erl_opts, [
    debug_info
]}.

{deps, [
    %% Local dep override: `_checkouts/{bondy_db,bondy_oplog}` are symlinks to
    %% the umbrella apps (`../../../apps/...`). rebar3 prefers the checkouts
    %% over these git fallbacks, so local edits to the apps flow through
    %% immediately. `bondy_db` pulls `bondy_oplog` + `bondy_mst` + `leveled`.
    {bondy_db, {git_subdir, "https://github.com/bondy-io/bondy.git",
                {branch, "feature/aramallo.new_routing_architecture"},
                "apps/bondy_db"}},
    {cowboy, "2.13.0"},
    {jsx, "3.1.0"}
]}.

{relx, [
    {release, {bondy_mst_jepsen_release, "0.4.0"}, [
        compiler,
        crypto,
        inets,
        kernel,
        os_mon,
        runtime_tools,
        sasl,
        stdlib,
        tools,
        app_config,
        utils,
        resulto,
        memory,
        bloomfi,
        leveled,
        telemetry,
        cowlib,
        ranch,
        cowboy,
        jsx,
        bondy_mst,
        bondy_oplog,
        bondy_db,
        bondy_mst_jepsen
    ]},
    {dev_mode, false},
    {include_src, false},
    {include_erts, true},
    {extended_start_script, true},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"}
]}.

{profiles, [
    {test, [
        {erl_opts, [nowarn_export_all]}
    ]}
]}.
