%% Default sys.config for the bondy_mst_jepsen release.
%%
%% The Java side (io.leapsight.jepsen.Utils#configuration) rewrites
%% this file on each Jepsen run to inject the actual peer node list
%% picked up from `--nodes` and the workload's tuning knobs. The
%% defaults below are good enough to boot a node standalone for
%% interactive debugging (`./bin/bondy_mst_jepsen_release console`).

[
    {kernel, [
        {logger_level, notice},
        {logger, [
            {handler, default, logger_std_h,
                #{formatter => {logger_formatter, #{
                    template => [
                        time, " ", level, " ", file, ":", line,
                        " ", msg, "\n"
                    ]
                }}}}
        ]}
    ]},
    {bondy_mst_jepsen, [
        {http_port, 8080},
        {db_name, jepsen},
        {tables, [t0, t1, t2, t3, t4, t5, t6, t7, t8, t9]},
        {shard_count, 16},
        {fold_module, lww_register},
        {peers, []},
        {data_dir, "/var/lib/bondy_mst_jepsen"},
        {reconnect_interval_ms, 1000}
    ]},
    {bondy_mst, [
        {sync_scheduler, true},
        {sync_interval_ms, 200}
    ]}
].
