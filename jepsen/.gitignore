# Build / release artefacts produced by `just rel-jepsen` and `lein`.
# `target/` is Leiningen's per-project compile output; the release
# tarball is regenerated on every build; `.cpcache/` is the
# Clojure CLI's compiled classpath cache.
jepsen.bondymst/target/
jepsen.bondymst/.cpcache/
jepsen.bondymst/bondy_mst_jepsen_release-*.tar.gz
jepsen.bondy/target/
jepsen.bondy/.cpcache/
jepsen.bondy/bondy-*.tar.gz

# Leiningen / nREPL transient state.
.lein-failures
.lein-deps-sum
.lein-repl-history
.lein-plugins/
.nrepl-port
pom.xml.asc

# Jepsen test outputs. Regenerated every `lein run test`. Symlinked
# `latest/` and `current/` point inside this tree; ignoring the parent
# covers them.
jepsen.bondymst/store/
jepsen.bondy/store/

# Locally-captured run artefacts (logs, history.edn, latency graphs).
# Useful when working on a problem; not source. If a specific run
# needs to be shared, attach the tarball to the PR / issue or pin its
# results.edn alongside the relevant memory.
store_runs/

# SSH keys generated by `just jepsen-up`. The private key
# (`jepsen-bot`) must NEVER be committed; the public key is
# regenerated alongside it so we ignore both to keep the pair
# consistent — the `jepsen-up` recipe recreates them on demand.
# `known_hosts` is per-host SSH state and not portable.
docker/shared/jepsen-bot
docker/shared/jepsen-bot.pub
docker/shared/known_hosts
