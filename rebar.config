{minimum_otp_vsn, "R28"}.

{erl_opts, [
    % warn_export_all,
    % warn_missing_spec,
    debug_info,
    ewarn_export_all,
    strict_validation,
    warn_bif_clash,
    warn_deprecated_function,
    warn_export_vars,
    warn_exported_vars,
    warn_format,
    warn_obsolete_guard,
    warn_shadow_vars,
    % warn_untyped_record,
    warn_unused_function,
    warn_unused_import,
    warn_unused_record,
    warn_unused_vars,
    warnings_as_errors
 ]}.

%% NOTE: erlfmt's provider is `fmt`, not `format`. Re-enable as
%% {provider_hooks, [{pre, [{compile, fmt}]}]}. once you want format-on-compile
%% (be aware it will reformat the whole tree on the next build).

{deps, [
    %% -------------------------------------------------------------------------
    %% Crypto
    %% -------------------------------------------------------------------------
    {jose,
        {git,
            "https://github.com/potatosalad/erlang-jose.git",
            {tag, "1.11.12"}
        }
    },
    {stringprep, "1.0.34"},
    {base16, "2.0.1"},
    %% -------------------------------------------------------------------------
    %% Web Server|client
    %% -------------------------------------------------------------------------
    %% Used to implement WebSockets, API Gateway, HTTP Admin API
    %% and /metrics endpoint
    {cowboy, "2.17.0"},
    {ranch, "2.2.0"},
    %% Used by bondy_connect's WebSocket (ws/wss) client transport
    {gun, "2.4.1"},
    %% Used by API Gateway to implement forward action to
    %% downstream HTTP services
    hackney,
    backoff,
    %% -------------------------------------------------------------------------
    %% Utils
    %% -------------------------------------------------------------------------
    {uuid, "2.0.7", {pkg, uuid_erl}},
    {app_config,
        {git, "https://github.com/leapsight/app_config.git", {tag, "1.1.2"}}
    },
    {leap, {
        git,
        "https://github.com/leapsight/leap.git",
        {branch, "master"}
    }},
    %% Leapsight utility library
    {utils,
        {git, "https://github.com/leapsight/utils.git", {tag, "1.4.3"}}
    },
    {memory,
        {git, "https://github.com/Leapsight/memory.git", {branch, "master"}}
    },
    resulto,
    lrw,
    %% -------------------------------------------------------------------------
    %% Concurrency|Load|Traffic Management
    %% -------------------------------------------------------------------------
    %% Currently used to implement a load regulated pool of workers
    sidejob,
    %% A hashed set of ets tables and an implementation of a queue that we
    %% currently used for bondy_rpc_promise.
    {tuplespace,
        {git, "https://gitlab.com/leapsight/tuplespace.git", {tag, "0.3.2"}}
    },
    {jobs, "0.10.0"},
    %% -------------------------------------------------------------------------
    %% Instrumentation/Observability/Debugging
    %% -------------------------------------------------------------------------
    {observer_cli, "2.0.0"},
    %% Exposes metrics to Promethues
    {prometheus, "6.1.3"},
    {prometheus_cowboy, "0.2.0"},
    {telemetry, "1.4.2"},
    {opentelemetry_api, "1.5.0"},
    {riak_sysmon,
        {git, "https://github.com/Leapsight/riak_sysmon.git", {tag, "2.2.0"}}
    },
    %% -------------------------------------------------------------------------
    %% Core Deps
    %% -------------------------------------------------------------------------
    %% Bondy's cluster transport. Started manually by bondy_app (before
    %% bondy_db); `{partisan, load}' in the release.
    {partisan, {
        git,
        "https://github.com/lasp-lang/partisan.git",
        {tag, "v6.0.0-rc.1"}
    }},
    %% Process registry / worker pools (bondy_jobs_sup, bondy_rpc_promise et al.).
    {gproc, "1.2.0"},
    %% A mustache-like library used by API Gateway and Broker Bridge
    %% specifications
    {mops, {
        git,
        "https://gitlab.com/leapsight/mops.git",
        {branch, "master"}
    }},
    %% -------------------------------------------------------------------------
    %% Auth Deps
    %% -------------------------------------------------------------------------
    {oidcc, "3.7.2"}
]}.

{overrides, [
    {override, oidcc, [
        {deps, [
            %% Only the Erlang deps (not Elixir ones)
            {jose, "1.11.12"},
            {telemetry, "~> 1.3.0"}
        ]}
    ]}

]}.


%% =============================================================================
%% RELX
%% =============================================================================


{relx, [
    {release, {bondy, "1.0.0-rc-yellow"},[
        %% Erlang/OTP
        crypto,
        inets,
        kernel,
        runtime_tools,
        sasl,
        stdlib,
        tools,
        compiler, %% required by sidejob
        %% Crypto
        jose,
        stringprep,
        base16,
        %% Web Server|client
        cowboy,
        hackney,
        %% Utils
        uuid,
        lrw,
        %% Concurrency|Load|Traffic Management
        jobs,
        sidejob,
        %% Instrumentation/Debugging
        observer_cli,
        riak_sysmon,
        prometheus,
        prometheus_cowboy,
        telemetry,
        %% Serialization formats
        msgpack,
        %% 1st-party deps
        leap,
        mops,
        utils,
        memory,
        resulto,
        {tuplespace, load},
        %% Partisan is loaded but not started by the release; bondy_app starts it
        %% manually (it is not in any app.src `applications' list).
        {partisan, load},
        %% bondy_db storage substrate — started manually by bondy_app after
        %% Partisan (bondy_db replicates over Partisan, which bondy_router owns).
        %% leveled = durable projection backend; bondy_mst = MST substrate library.
        {leveled, load},
        {bondy_mst, load},
        {bondy_oplog, load},
        {bondy_db, load},
        %% Bondy router app
        bondy_router,
        %% =====================================================================
        bondy_stdlib,
        bondy_cbor,
        bondy_regulator,
        bondy_wamp,
        %% Bondy WAMP client app (no dependency on the bondy router app)
        bondy_connect,
        %% Bondy broker bridge app
        bondy_broker_bridge,
        bondy_http_connector,
        %% Bondy Kafka Bridge
        {brod, load},
        {hash, load},
        %% Bondy AWS SNS Bridge
        {erlcloud, load},
        %% Bondy Email Bridge
        {email, load}
    ]},

    {overlay, [
        {template, "priv/hooks/pre_start", "bin/hooks/pre_start"},
        {copy, "priv/hooks/status","bin/hooks/status"},

        {template,
            "priv/hooks/bondy_remote_console", "bin/hooks/bondy_remote_console"
        },
        %% copy scripts required by extended_start_script_hooks
        {copy,
            "priv/tools/validate-config", "bin/validate-config"
        },
        {copy,
            "priv/tools/replace-env-vars","bin/replace-env-vars"
        },
        {template,
            "priv/tools/console_clean", "bin/console_clean"
        },
        {template,
            "priv/tools/db-repair.escript", "bin/db-repair.escript"
        }
    ]},

    {overlay_vars, "config/prod/vars.config"},
    {extended_start_script, true},
    {extended_start_script_hooks, [
        {pre_start, [
            {custom, "hooks/pre_start"},
            {custom, "hooks/pre_start_cuttlefish"}
        ]},
        {status, [
            {custom, "hooks/status"}
        ]},
        {remote2, [
            {custom, "hooks/bondy_remote_console"}
        ]}
    ]}
]}.

{pre_hooks, [

]}.


%% =============================================================================
%% REBAR
%% =============================================================================


{project_plugins, [
    pc,
    rebar3_hex,
    rebar3_ex_doc,
    rebar3_proper,
    rebar3_hank,
    rebar3_depup,
    {erlfmt, "1.8.0"},
    {rebar3_scuttler,
        {
            git,
            "https://github.com/leapsight/rebar3_scuttler",
            {branch, "master"}
        }
    }
]}.

%% =============================================================================
%% HANK — dead-code analyser (`rebar3 hank`)
%% =============================================================================
%% We run only the default rules that reliably flag GENUINE dead code here. The
%% three omitted rules are systematically false-positive for this codebase
%% (verified against the code, not assumed), and Hank cannot tell the difference:
%%
%%   - `unused_callbacks` — every `-callback` in a real `-behaviour`
%%     (`bondy_oplog_crdt`, `bondy_db_topology`, `bondy_connect_transport`,
%%     `bondy_broker_bridge`, `bondy_oplog_transport`, ...) IS the contract its
%%     implementers satisfy; Hank only counts direct `Mod:CB()` invocations and
%%     so flags all of them as unused.
%%   - `unnecessary_function_arguments` — behaviour-callback implementations and
%%     interface/consistency stubs legitimately ignore arguments they must still
%%     accept to honour the API (e.g. `bondy_registry_store:fold/4` and the
%%     `plum_db`-shaped find/lookup family, the WAMP `not_implemented` meta
%%     stubs, gen_server/gen_statem callbacks).
%%   - `single_use_hrl_attrs` — the protocol/URI/constant headers
%%     (`bondy_wamp.hrl`, `bondy_uris.hrl`, `bondy_cbor.hrl`, the WAL/pack
%%     headers) deliberately centralise their macros so there is one place to
%%     find, e.g., every WAMP procedure URI — even when a macro currently has a
%%     single consumer.
%%   - `unused_record_fields` — proven false-positive on the idiomatic
%%     `#?MODULE{}` record syntax this codebase uses: e.g. `bondy_mst.store` is
%%     read 56 times via `#?MODULE{store = _}` yet Hank reports it unused,
%%     because it does not resolve `#?MODULE{}` to the `bondy_mst` record.
%%   - `single_use_hrls` — Hank does not resolve cross-app `-include_lib`, so a
%%     header reached through it is counted as unincluded. Verified: it flags
%%     `bondy_stdlib.hrl` as "only included at bondy_stdlib.erl", but that header
%%     defines `optional(T)` and is pulled in codebase-wide via `bondy.hrl`'s
%%     `-include_lib`. The rule would push us to inline genuinely-shared headers.
%%   - `unused_configuration_options` — omitted: enabling it makes `rebar3 hank`
%%     never terminate on this tree (it cross-references every cuttlefish
%%     `.schema` / `sys.config` key against `application:get_env` reads), and it
%%     surfaced no genuine finding before it hung.
%%
%% `unused_macros` stays ON, but is ignored in `.hrl` files: headers here are
%% centralised constant/URI/opcode/doc VOCABULARIES (same rationale as
%% `single_use_hrl_attrs`), so an unused macro there is intentional. In a `.erl`
%% module an unused `-define` is genuine dead code, so the rule keeps catching
%% those. `unused_hrls` also stays ON — a header included nowhere is truly dead
%% (it is currently clean; note the same `-include_lib` blind spot could produce
%% a false positive on a header consumed only across apps).
{hank, [
    {rules, [
        unused_macros,
        unused_hrls
    ]},
    {ignore, [
        %% Vendored / fetched dependencies and nested per-app build output are
        %% not our source (top-level _build is ignored by Hank already).
        "apps/*/bench/**",
        "apps/*/_build/**",
        "_checkouts/**",
        %% Header vocabularies (see note above).
        {"apps/**/*.hrl", unused_macros}
    ]}
]}.

{shell, [
    {config, "config/dev/advanced.config"},
    {apps, [bondy_router, bondy_broker_bridge, bondy_http_connector]}
]}.

{profiles, [
    {prod, [
        {relx, [
            % {mode, prod},
            {debug_info, strip},
            {dev_mode, false},
            {include_erts, true},
            {include_src, false},
            {system_libs, true},

            {overlay_vars, "config/prod/vars.config"},
            {sys_config, "config/prod/sys.config"},
            {vm_args, "config/prod/vm.args"}
        ]}
    ]},
    {docker, [
        {relx, [
            {debug_info, strip},
            {dev_mode, false},
            {include_erts, true},
            {include_src, false},
            {system_libs, true},

            {overlay_vars, "config/docker/vars.config"},
            {sys_config, "config/docker/sys.config"},
            {vm_args, "config/docker/vm.args"}
        ]}
    ]},
    {prod_bondy, [
        {relx, [
            % {mode, prod},
            {debug_info, strip},
            {dev_mode, false},
            {include_erts, true},
            {include_src, false},
            {system_libs, true},

            %% This file is generated by the pre_hook
            {overlay_vars, "config/prod/vars.config"},
            {sys_config, "config/prod/sys.config"},
            %% We use a vm.args with hardcoded values for name and cookie
            %% for those cases when we need the release directory to be
            %% readonly. Using variables requires the directory to be writable
            %% and there is no way for us  to tell relx to find these files in
            %% another directory.
            {vm_args, "config/prod_named/vm.args"}
        ]}
    ]},
    {dev, [
        {relx, [
            % {mode, dev},
            {debug_info, keep},
            {dev_mode, true},
            {include_erts, false},
            {include_src, true},

            {overlay_vars, "config/dev/vars.config"},
            {overlay, [
                {mkdir, "{{platform_data_dir}}"},
                {mkdir, "{{platform_log_dir}}"},
                {mkdir, "{{platform_etc_dir}}"},
                {copy,
                    "config/dev/bondy.conf.template",
                    "{{platform_etc_dir}}/bondy.conf.template"
                },
                {copy,
                    "config/_ssl/server/cacerts.pem",
                    "{{platform_etc_dir}}/ssl/server/cacert.pem"
                },
                {copy,
                    "config/_ssl/server/keycert.pem",
                    "{{platform_etc_dir}}/ssl/server/keycert.pem"
                },
                {copy,
                    "config/_ssl/server/key.pem",
                    "{{platform_etc_dir}}/ssl/server/key.pem"
                },
                {copy,
                    "config/_ssl/client/cacerts.pem",
                    "{{platform_etc_dir}}/ssl/client/cacert.pem"
                },
                {copy,
                    "config/_ssl/client/keycert.pem",
                    "{{platform_etc_dir}}/ssl/client/keycert.pem"
                },
                {copy,
                    "config/_ssl/client/key.pem",
                    "{{platform_etc_dir}}/ssl/client/key.pem"
                },
                {template,
                    "config/dev/vm.args",
                    "releases/{{release_version}}/vm.args"
                },
                {template,
                    "config/dev/sys.config",
                    "releases/{{release_version}}/sys.config"
                }
            ]}
        ]}
    ]},
    {node1, [
        {relx, [
            % {mode, prod},
            {debug_info, strip},
            {dev_mode, false},
            {include_erts, true},
            {include_src, false},
            {system_libs, true},

            {overlay_vars, "config/test/node_1_vars.config"},
            {overlay, [
                {mkdir, "{{platform_data_dir}}"},
                {mkdir, "{{platform_log_dir}}"},
                {mkdir, "{{platform_etc_dir}}"},
                {mkdir, "{{platform_etc_dir}}/ssl"},
