    {bridge, [
        {relx, [
            % {mode, dev},
            {debug_info, keep},
            {dev_mode, true},
            {include_erts, false},
            {include_src, true},

            {vm_args, "config/bridge/vm.args"},
            {overlay_vars, "config/bridge/vars.config"},
            {overlay,
                [{mkdir, "{{platform_data_dir}}"},
                {mkdir, "{{platform_log_dir}}"},
