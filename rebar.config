                },
                {copy,
                    "examples/config/security_config.json",
                    "{{platform_etc_dir}}/security_config.json"
                }
            ]}
        ]}
    ]}
]}.



%% =============================================================================
%% DOCS
%% =============================================================================



{ex_doc, [
    {name, "Bondy"},
    {source_url, <<"https://github.com/bondy-io/bondy">>},
    {homepage_url, "https://bondy.io"},
    {extra_section, "Pages"},

