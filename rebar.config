    {edge1, [
        {relx, [
            % {mode, prod},
            {debug_info, strip},
            {dev_mode, false},
            {include_erts, true},
            {include_src, false},
            {system_libs, true},

            {overlay_vars, "config/test/edge_1_vars.config"},
            {overlay, [
                {mkdir, "{{platform_data_dir}}"},
                {mkdir, "{{platform_log_dir}}"},
