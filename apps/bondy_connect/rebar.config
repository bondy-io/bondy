{minimum_otp_vsn, "R28"}.
{erl_opts, [debug_info]}.

%% Inter-app dependencies. Inside the Bondy umbrella these resolve to the local
%% project apps (which shadow same-named deps); declared here as `git_subdir' so
%% that external consumers pulling `bondy_connect' via `git_subdir' get the whole
%% chain fetched transitively (they only declare `bondy_connect'). There is
%% deliberately NO dependency on the `bondy' router app.
%%
%% NOTE: the branch ref MUST track the branch this code lives on, so that a
%% consumer of branch X pulls its siblings from X too (not from a divergent
%% branch such as `master'). Keep it in sync on branch rename/merge, and pin to
%% a release tag before cutting `bondy_connect' for external use.
{deps, [
    {bondy_stdlib,
        {git_subdir, "https://github.com/bondy-io/bondy.git",
            {branch, "feature/aramallo.new_routing_architecture"},
            "apps/bondy_stdlib"}},
    {bondy_wamp,
        {git_subdir, "https://github.com/bondy-io/bondy.git",
            {branch, "feature/aramallo.new_routing_architecture"},
            "apps/bondy_wamp"}},
    {bondy_regulator,
        {git_subdir, "https://github.com/bondy-io/bondy.git",
            {branch, "feature/aramallo.new_routing_architecture"},
            "apps/bondy_regulator"}}
]}.

%% =============================================================================
%% REBAR
%% =============================================================================


{project_plugins, [
    rebar3_ex_doc,
    rebar3_proper
]}.

{shell, [
    {apps, [bondy_connect]}
]}.

{xref_checks, [undefined_function_calls]}.

%% =============================================================================
%% DOCS
%% =============================================================================


{ex_doc, [
    {source_url, <<"https://github.com/bondy-io/bondy">>},
    {extras, [
        <<"README.md">>,
        {<<"apps/bondy_connect/doc_extras/tutorial.md">>, #{title => <<"Tutorial">>}}
    ]},
    {main, <<"README.md">>}
]}.
