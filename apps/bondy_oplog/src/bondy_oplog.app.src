{application, bondy_oplog, [
    {description,
        "Operation-log write/replication framework and op-based CRDT "
        "catalogue, built on the bondy_mst Merkle-Search-Tree library."},
    {vsn, "0.1.0"},
    {registered, []},
    {mod, {bondy_oplog_app, []}},
    {applications, [
        %% Erlang
        kernel,
        stdlib,
        %% External
        app_config,
        utils,
        memory,
        resulto,
        telemetry,
        %% Cluster transport — the node-level responder is a
        %% partisan_gen_server and bondy_oplog_transport_partisan routes sync
        %% over Partisan (deployments run connect_disterl => false).
        partisan,
        %% Umbrella
        bondy_mst
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, []}
]}.
