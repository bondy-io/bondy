{application, bondy_oplog, [
    {description,
        "Operation-log write/replication framework and op-based CRDT "
        "catalogue, built on the bondy_mst Merkle-Search-Tree library."},
    {vsn, "0.1.0"},
    {registered, []},
    {mod, {bondy_oplog_app, []}},
    {applications, [
        %% Erlang
        kernel,
        stdlib,
        %% External
        app_config,
        utils,
        memory,
        resulto,
        telemetry,
        %% Project
        bondy_metrics,
        bondy_connect_lib,
        bondy_cluster,
        %% Umbrella
        bondy_mst,
        bondy_log
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, []}
]}.
