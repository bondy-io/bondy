%% =============================================================================

{minimum_otp_vsn, "R28"}.
{erl_opts, [debug_info]}.

%% =============================================================================
%% REBAR
%% =============================================================================

{project_plugins, [
    rebar3_ex_doc,
    rebar3_proper
]}.

{shell, [
    {apps, []}
]}.

%% Deps are resolved at the umbrella level (bondy_mst, app_config, utils,
%% memory, resulto, telemetry). Declared here only for standalone builds and
%% for third parties that consume bondy_oplog via git_subdir.
{deps, [
    %% Merkle Search Trees — vendored as a sibling app in the bondy umbrella;
    %% pulled here via git_subdir for standalone/third-party builds.
    {bondy_mst,
        {git_subdir, "https://github.com/bondy-io/bondy.git",
            {branch, "feature/aramallo.new_routing_architecture"},
            "apps/bondy_mst"}}
]}.

%% =============================================================================
%% DOCS
%% =============================================================================

{ex_doc, [
    {source_url, <<"https://github.com/bondy-io/bondy">>},
    {extras, [
        <<"README.md">>
    ]},
    {main, <<"README.md">>}
]}.
