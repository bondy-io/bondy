{erl_opts, [debug_info]}.
{deps, []}.

{shell, [
    {apps, [bondy_msgpack]}
]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]},
        %% `msgpack` is the reference implementation for prop_bondy_msgpack
        %% only; nothing outside the tests depends on it.
        {deps, [proper, {msgpack, "0.8.1"}]}
    ]}
]}.

{cover_enabled, true}.
{cover_opts, [verbose]}.
