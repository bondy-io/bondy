%% =============================================================================

{minimum_otp_vsn, "R28"}.
{erl_opts, [debug_info]}.

%% =============================================================================
%% REBAR
%% =============================================================================

{project_plugins, [
    rebar3_ex_doc,
    rebar3_proper
]}.

{shell, [
    {apps, []}
]}.


{deps, [
    {leveled,
        {git, "https://github.com/OpenRiak/leveled.git",
            {branch, "openriak-4.0"}
        }
    },
    {bondy_oplog,
        {git_subdir, "https://github.com/bondy-io/bondy.git",
            {branch, "feature/aramallo.new_listeners"},
            "apps/bondy_oplog"}}
]}.

%% =============================================================================
%% DOCS
%% =============================================================================

{ex_doc, [
    {source_url, <<"https://github.com/bondy-io/bondy">>},
    %% These pages reference modules by name in prose (incl. the MST-library
    %% chapters 02/08, which live in the bondy_mst repo) — intentional, not
    %% autolinkable. Suppress the undefined-reference warnings so docs build clean.
    {skip_undefined_reference_warnings_on, [
        "apps/bondy_db/doc_extras/architecture/00_overview.md",
        "apps/bondy_db/doc_extras/architecture/03_bondy_db.md",
        "apps/bondy_db/doc_extras/architecture/05_crdt_model.md",
        "apps/bondy_db/doc_extras/architecture/07_app_developers_tour.md"
    ]},
    {extras, [
        <<"README.md">>,
        %% System architecture chapters for the bondy_oplog/bondy_db layer.
        %% The MST-library chapters (02_bondy_mst, 08_backup_and_restore)
        %% live in the bondy_mst repo's own docs.
        {<<"apps/bondy_db/doc_extras/architecture/README.md">>, #{
            filename => <<"architecture">>,
            title => <<"Architecture">>
        }},
        <<"apps/bondy_db/doc_extras/architecture/00_overview.md">>,
        <<"apps/bondy_db/doc_extras/architecture/01_bondy_oplog.md">>,
        <<"apps/bondy_db/doc_extras/architecture/03_bondy_db.md">>,
        <<"apps/bondy_db/doc_extras/architecture/04_applier.md">>,
        <<"apps/bondy_db/doc_extras/architecture/05_crdt_model.md">>,
        <<"apps/bondy_db/doc_extras/architecture/06_compaction_and_bootstrap.md">>,
        <<"apps/bondy_db/doc_extras/architecture/07_app_developers_tour.md">>,
        <<"apps/bondy_db/doc_extras/cheatsheet.cheatmd">>
    ]},
    {main, <<"README.md">>}
]}.
