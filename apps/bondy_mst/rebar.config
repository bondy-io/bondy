%% =============================================================================
%% SPDX-FileCopyrightText: 2023 - 2026 Leapsight
%% SPDX-License-Identifier: Apache-2.0
%% =============================================================================

%% Merkle Search Tree replication-structure library. Vendored into the bondy
%% umbrella as `apps/bondy_mst` (alongside the bondy_oplog/bondy_db apps that
%% build on it). Stays a self-contained, leveled-free library: third parties
%% consume it via a rebar3 `git_subdir` dep pointing at `apps/bondy_mst`.

%% OTP 27+: the source uses triple-quoted string literals and the
%% `-doc`/`-moduledoc` attributes.
{minimum_otp_vsn, "R27"}.
{erl_opts, [debug_info]}.

%% =============================================================================
%% REBAR
%% =============================================================================

{project_plugins, [
    rebar3_ex_doc,
    rebar3_proper
]}.

{shell, [
    {apps, [bondy_mst]}
]}.

%% Library deps only. `leveled` is NOT a library dependency — the bondy_mst src
%% is leveled-free; the leveled-backed projection store + storage topologies
%% live in the bondy_oplog/bondy_db apps. `leveled` is a TEST-only dep (see the
%% `test` profile). In an umbrella build the shared deps (app_config, memory,
%% resulto, telemetry) resolve at the root; key_value and bloomfi are pulled
%% here.
{deps, [
    {app_config,
        {git, "https://github.com/leapsight/app_config.git",
            {branch, "1.1.2"}
        }
    },
    {memory,
        {git, "https://github.com/Leapsight/memory.git",
            {branch, "master"}
        }
    },
    {key_value,
        {git, "https://github.com/leapsight/key_value.git",
            {tag, "1.1.1"}
        }
    },
    resulto,
    {bloomfi,
        {git, "https://github.com/Leapsight/bloomfi.git",
            {tag, "1.1.0"}
        }
    },
    telemetry
]}.




%% =============================================================================
%% PROFILES
%% =============================================================================

%% No relx release here — the vendored library is built by the umbrella, or
%% pulled standalone via a `git_subdir` dep. The `test` profile carries only
%% the deps the library's own eunit/CT suites need. `leveled` is TEST-ONLY
%% (the src is leveled-free) — it backs the `bondy_mst_leveled_store` test
%% helper; the production leveled users live in bondy_oplog/bondy_db.
{profiles, [
    {test, [
        {deps, [
            meck,
            proper,
            {types, "0.1.8"},
            {leveled,
                {git, "https://github.com/OpenRiak/leveled.git",
                    {branch, "openriak-4.0"}
                }
            }
        ]},
        {erl_opts, [nowarn_export_all]},
        %% Start the CT runner distributed (CT suites that spawn `peer`
        %% nodes need it). `rebar3 eunit` does not honour this; eunit
        %% tests that need distribution start their own (see
        %% `bondy_mst_pack_crash_injection_test:ensure_distribution/0`).
        {dist_node, [{name, 'ct@127.0.0.1'}]}
    ]}
]}.


%% =============================================================================
%% CODE QUALITY
%% =============================================================================


{cover_enabled, true}.
{cover_opts, [verbose]}.
{cover_export_enabled, true}.

{covertool, [
    {coverdata_files, ["ct.coverdata"]}
]}.

{eunit_opts, [
    verbose
]}.

{proper_opts, [
    {numtests, 300}
]}.




%% =============================================================================
%% DOCS
%% =============================================================================


{ex_doc, [
    {source_url, <<"https://github.com/bondy-io/bondy">>},
    %% These modules / pages reference functions, callbacks, types, OTP-
    %% hidden internals (`prim_file`), or since-moved helpers in their
    %% docs by name, for explanation — intentional, but not autolinkable.
    %% Suppress the undefined-reference warnings on those sources so the
    %% docs build clean; the references stay as code text.
    {skip_undefined_reference_warnings_on, [
        "bondy_mst_admin",
        "bondy_mst_pack_tombstones",
        "bondy_mst_pack_recovery",
        "bondy_mst_pack_index",
        "bondy_mst_pack_idx_rebuild",
        "bondy_mst_pack_codec",
        "bondy_mst_io",
        "doc_extras/architecture/02_bondy_mst.md",
        "doc_extras/architecture/08_backup_and_restore.md"
    ]},
    %% Render mermaid blocks. `with_mermaid` would be the canonical
    %% knob, but in rebar3_ex_doc 0.2.31 it's a no-op when no
    %% `before_closing_body_tag` is already present
    %% (`lists:keyreplace/4` silently drops the new entry). We inject
    %% the script tag + initializer ourselves so the option list is
    %% non-empty before the merge runs.
    {before_closing_body_tag, #{
        html =>
            "<script src=\"https://cdn.jsdelivr.net/npm/mermaid@10.9.1/dist/mermaid.min.js\"></script>"
            "<script>"
            %% --------------------------------------------------------------
            %% Bondy brand palette (from bondy_lang/_art/bondy-brand-book.html)
            %% --------------------------------------------------------------
            "const bondyDark = {"
            "  background: '#111110',"
            "  primaryColor: '#0A2530',"
            "  primaryBorderColor: '#0891B2',"
            "  primaryTextColor: '#F5F5F3',"
            "  secondaryColor: '#1A1A18',"
            "  secondaryBorderColor: '#2C2C2A',"
            "  secondaryTextColor: '#F5F5F3',"
            "  tertiaryColor: '#2C2C2A',"
            "  tertiaryBorderColor: '#48484A',"
            "  tertiaryTextColor: '#F5F5F3',"
            "  lineColor: '#06B6D4',"
            "  textColor: '#F5F5F3',"
            "  mainBkg: '#0A2530',"
            "  secondBkg: '#1A1A18',"
            "  clusterBkg: '#1A1A18',"
            "  clusterBorder: '#2C2C2A',"
            "  edgeLabelBackground: '#1A1A18',"
            "  defaultLinkColor: '#06B6D4',"
            "  titleColor: '#F5F5F3',"
            "  nodeBorder: '#0891B2',"
            "  nodeTextColor: '#F5F5F3',"
            %% sequence
            "  actorBkg: '#0A2530',"
            "  actorBorder: '#0891B2',"
            "  actorTextColor: '#F5F5F3',"
            "  actorLineColor: '#48484A',"
            "  signalColor: '#06B6D4',"
            "  signalTextColor: '#F5F5F3',"
            "  labelBoxBkgColor: '#1A1A18',"
            "  labelBoxBorderColor: '#2C2C2A',"
            "  labelTextColor: '#F5F5F3',"
            "  loopTextColor: '#F5F5F3',"
            "  noteBkgColor: '#2A1800',"
            "  noteBorderColor: '#FF9F0A',"
            "  noteTextColor: '#F5F5F3',"
            "  activationBkgColor: '#0A6880',"
            "  activationBorderColor: '#06B6D4',"
            "  sequenceNumberColor: '#111110',"
            %% state
            "  stateBkg: '#0A2530',"
            "  altBackground: '#1A1A18',"
            "  compositeBackground: '#1A1A18',"
            "  compositeBorder: '#2C2C2A',"
            "  compositeTitleBackground: '#0A2530',"
            "  innerEndBackground: '#06B6D4',"
            "  specialStateColor: '#F5F5F3',"
            "  errorBkgColor: '#380A08',"
            "  errorTextColor: '#E05040'"
            "};"

            "const bondyLight = {"
            "  background: '#F7F7F5',"
            "  primaryColor: '#D0EFF8',"
            "  primaryBorderColor: '#0891B2',"
            "  primaryTextColor: '#111110',"
            "  secondaryColor: '#EFEFED',"
            "  secondaryBorderColor: '#D5D5D3',"
            "  secondaryTextColor: '#111110',"
            "  tertiaryColor: '#D5D5D3',"
            "  tertiaryBorderColor: '#AEAEB2',"
            "  tertiaryTextColor: '#111110',"
            "  lineColor: '#0891B2',"
            "  textColor: '#111110',"
            "  mainBkg: '#D0EFF8',"
            "  secondBkg: '#EFEFED',"
            "  clusterBkg: '#EFEFED',"
            "  clusterBorder: '#D5D5D3',"
            "  edgeLabelBackground: '#F7F7F5',"
            "  defaultLinkColor: '#0891B2',"
            "  titleColor: '#111110',"
            "  nodeBorder: '#0891B2',"
            "  nodeTextColor: '#111110',"
            "  actorBkg: '#D0EFF8',"
            "  actorBorder: '#0891B2',"
            "  actorTextColor: '#111110',"
            "  actorLineColor: '#AEAEB2',"
            "  signalColor: '#0891B2',"
            "  signalTextColor: '#111110',"
            "  labelBoxBkgColor: '#EFEFED',"
            "  labelBoxBorderColor: '#D5D5D3',"
            "  labelTextColor: '#111110',"
            "  loopTextColor: '#111110',"
            "  noteBkgColor: '#FFF4E6',"
            "  noteBorderColor: '#FF9F0A',"
            "  noteTextColor: '#111110',"
            "  activationBkgColor: '#90C8D8',"
            "  activationBorderColor: '#0891B2',"
            "  sequenceNumberColor: '#F7F7F5',"
            "  stateBkg: '#D0EFF8',"
            "  altBackground: '#EFEFED',"
            "  compositeBackground: '#EFEFED',"
            "  compositeBorder: '#D5D5D3',"
            "  compositeTitleBackground: '#D0EFF8',"
            "  innerEndBackground: '#0891B2',"
            "  specialStateColor: '#111110',"
            "  errorBkgColor: '#FAE4E0',"
            "  errorTextColor: '#C04030'"
            "};"

            "function renderBondyMermaid() {"
            "  const isDark = document.body.className.includes(\"dark\");"
            "  mermaid.initialize({"
            "    startOnLoad: false,"
            "    theme: 'base',"
            "    themeVariables: isDark ? bondyDark : bondyLight,"
            "    fontFamily: \"'Geist Variable','Geist',system-ui,sans-serif\","
            "    flowchart: { curve: 'basis', padding: 12 },"
            "    sequence: { actorMargin: 60, messageAlign: 'center' }"
            "  });"
            "  let id = 0;"
            "  for (const codeEl of document.querySelectorAll(\"pre code.mermaid\")) {"
            "    const preEl = codeEl.parentElement;"
            "    const graphDefinition = codeEl.textContent;"
            "    const graphEl = document.createElement(\"div\");"
            "    graphEl.className = \"mermaid-rendered\";"
            "    const graphId = \"mermaid-graph-\" + id++;"
            "    mermaid.render(graphId, graphDefinition).then(({svg, bindFunctions}) => {"
            "      graphEl.innerHTML = svg;"
            "      bindFunctions?.(graphEl);"
            "      preEl.insertAdjacentElement(\"afterend\", graphEl);"
            "      preEl.remove();"
            "    });"
            "  }"
            "}"

            "document.addEventListener(\"DOMContentLoaded\", renderBondyMermaid);"
            "</script>"
            %% Light pad around the rendered SVG so it doesn't sit flush
            %% against the markdown body, plus a subtle border in either
            %% palette.
            "<style>"
            ".mermaid-rendered{"
            "  display:flex;justify-content:center;"
            "  padding:1.25rem;margin:1rem 0;"
            "  background:#F7F7F5;border:1px solid #D5D5D3;border-radius:6px;"
            "}"
            "body.dark .mermaid-rendered{"
            "  background:#1A1A18;border-color:#2C2C2A;"
            "}"
            ".mermaid-rendered svg{max-width:100%;height:auto}"
            "</style>"
    }},
    {extras, [
        <<"README.md">>,
        %% Only the MST-library architecture chapters remain here. The
        %% oplog/db-layer chapters (00,01,03-07), the cheatsheet, and the
        %% planning docs moved to the bondy umbrella (apps/bondy_db/doc_extras)
        %% alongside the bondy_oplog/bondy_db apps they describe.
        <<"doc_extras/architecture/02_bondy_mst.md">>,
        <<"doc_extras/architecture/08_backup_and_restore.md">>,
        <<"LICENSE">>,
        <<"CHANGELOG.md">>,
        <<"CODE_OF_CONDUCT.md">>
    ]},
    {main, <<"README.md">>},
    {api_reference, true}
]}.


