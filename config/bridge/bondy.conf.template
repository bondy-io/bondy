## =============================================================================
## ADMIN HTTP/S API
## =============================================================================

## `admin` is the reserved name for the node's administrable listener: an
## operator declares it under this name rather than the historical
## `admin_api_http`, or the manager injects its own default in its place.
##
## Every setting this listener needs is restated under `listeners.admin.*`,
## because config is read by a listener's CURRENT name and nothing reads
## `admin_api_http`'s historical block any more. The socket options go
## directly on `listeners.admin.*`; the Cowboy ones go under
## `listeners.admin.http.*`.
##
## `http.idle_timeout` and `http.active_n` are here to preserve what this
## listener already had, because Cowboy's own defaults differ
## — 60s rather than 15s, and `active_n` 1 rather than 100
## (`cowboy_http.erl:214,336`). Leaving them out silently changed both.
listeners.admin.transport = tcp
listeners.admin.protocol = http
listeners.admin.port = 18081
listeners.admin.start_phase = early
listeners.admin.services = admin_api, wamp_ws, admin, metrics
listeners.admin.acceptors_pool_size = 100
listeners.admin.max_connections = 10000
listeners.admin.backlog = 1024
listeners.admin.keepalive = off
listeners.admin.nodelay = on
listeners.admin.http.idle_timeout = 15s
listeners.admin.http.active_n = 100

listeners.admin_api_https.transport = tls
listeners.admin_api_https.protocol = http
listeners.admin_api_https.port = 18084
listeners.admin_api_https.start_phase = early
listeners.admin_api_https.services = admin_api, wamp_ws, admin, metrics
listeners.admin_api_https.enabled = off

## No certificate: a disabled listener is not checked for one. Uncomment the
## three below and point them at a real certificate before setting
## `enabled = on`.
listeners.admin_api_https.acceptors_pool_size = 100
listeners.admin_api_https.keepalive = off
listeners.admin_api_https.max_connections = 10000
listeners.admin_api_https.tls.versions = 1.3
# listeners.admin_api_https.tls.cacertfile = ${BONDY_ETC_DIR}/ssl/cacert.pem
# listeners.admin_api_https.tls.certfile = ${BONDY_ETC_DIR}/ssl/keycert.pem
# listeners.admin_api_https.tls.keyfile = ${BONDY_ETC_DIR}/ssl/key.pem

