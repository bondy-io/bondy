listeners.api_gateway_https.services = api_gateway, wamp_ws, wamp_sse, wamp_longpoll
listeners.api_gateway_https.enabled = off

listeners.api_gateway_https.acceptors_pool_size = 200
listeners.api_gateway_https.backlog = 4096
listeners.api_gateway_https.keepalive = off
listeners.api_gateway_https.max_connections = 500000
listeners.api_gateway_https.nodelay = on
## No certificate, for the same reason as `admin_api_https` above.
