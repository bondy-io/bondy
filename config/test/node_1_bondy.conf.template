log.handlers.default.level = info
log.level = info


## `admin` is the reserved name for the node's administrable listener: an
## operator declares it under this name rather than the historical
## `admin_api_http`, or the manager injects its own default in its place.
listeners.admin.transport = tcp
listeners.admin.protocol = http
listeners.admin.port = 18081
listeners.admin.start_phase = early
listeners.admin.services = admin_api, wamp_ws, admin, metrics
listeners.admin.acceptors_pool_size = 200
listeners.admin.max_connections = 500000

## Socket options go directly on `listeners.admin.*`, Cowboy ones under
## `listeners.admin.http.*`.
##
## `http.idle_timeout` and `http.active_n` are stated explicitly because
## Cowboy's own defaults differ from the values this listener has always run
## with: 60s rather than 15s, and `active_n` 1 rather than 100
## (`cowboy_http.erl:214,336`).
listeners.admin.backlog = 65535
listeners.admin.keepalive = off
listeners.admin.reuseport = on
listeners.admin.http.max_keepalive = 1000
listeners.admin.http.linger.timeout = 1s
listeners.admin.http.buffer.min = 1KB
listeners.admin.http.buffer.max = 128KB
listeners.admin.http.idle_timeout = 15s
listeners.admin.http.active_n = 100

listeners.admin_api_https.transport = tls
listeners.admin_api_https.protocol = http
listeners.admin_api_https.port = 18084
listeners.admin_api_https.start_phase = early
listeners.admin_api_https.services = admin_api, wamp_ws, admin, metrics

listeners.admin_api_https.acceptors_pool_size = 200
listeners.admin_api_https.keepalive = off
listeners.admin_api_https.max_connections = 250000
listeners.admin_api_https.backlog = 4096
listeners.admin_api_https.tls.cacertfile = ${BONDY_ETC_DIR}/ssl/server/cacert.pem
listeners.admin_api_https.tls.certfile = ${BONDY_ETC_DIR}/ssl/server/keycert.pem
listeners.admin_api_https.tls.keyfile = ${BONDY_ETC_DIR}/ssl/server/key.pem

api_gateway.config_file = ${BONDY_ETC_DIR}/api_spec.json

listeners.api_gateway_http.transport = tcp
listeners.api_gateway_http.protocol = http
listeners.api_gateway_http.port = 18080
listeners.api_gateway_http.services = api_gateway, wamp_ws, wamp_sse, wamp_longpoll
## `ip` is read from the listener's own block by `resolve_ip/3`, and takes a
## literal address — `inet:parse_address/1`, so not a hostname.
#listeners.api_gateway_http.ip = ::1
#listeners.api_gateway_http.ip_version = 6

listeners.api_gateway_http.acceptors_pool_size = 200
listeners.api_gateway_http.backlog = 4096
listeners.api_gateway_http.keepalive = off
listeners.api_gateway_http.max_connections = 500000
listeners.api_gateway_http.nodelay = on

listeners.api_gateway_https.transport = tls
listeners.api_gateway_https.protocol = http
listeners.api_gateway_https.port = 18083
listeners.api_gateway_https.services = api_gateway, wamp_ws, wamp_sse, wamp_longpoll

listeners.api_gateway_https.tls.cacertfile = ${BONDY_ETC_DIR}/ssl/server/cacert.pem
listeners.api_gateway_https.tls.certfile = ${BONDY_ETC_DIR}/ssl/server/keycert.pem
listeners.api_gateway_https.tls.keyfile = ${BONDY_ETC_DIR}/ssl/server/key.pem

broker_bridge.config_file = ${BONDY_ETC_DIR}/broker_bridge_config.json
broker_bridge.kafka.enabled = off

# broker_bridge.kafka.clients.default.allow_topic_auto_creation = on
# broker_bridge.kafka.clients.default.auto_start_producers = on
# broker_bridge.kafka.clients.default.endpoints = [{"127.0.0.1", 9092}]
# broker_bridge.kafka.clients.default.max_metadata_sock_retry = 5
