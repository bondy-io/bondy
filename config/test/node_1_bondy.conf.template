# broker_bridge.kafka.clients.default.restart_delay_seconds = 10s

# broker_bridge.kafka.topics.wamp_events = com.leapsight.wamp.events

cluster.automatic_leave = off
cluster.parallelism = 1
#cluster.listen_addrs = 192.168.50.174:18086
cluster.peer_port = 18086
cluster.peer_discovery.enabled = off

cluster.tls.enabled = off
## Loopback dev/test cluster: acknowledge the plaintext peer plane so the
## startup guard warns instead of refusing. Never use off a trusted network.
cluster.tls.allow_insecure = on
cluster.tls.server.cacertfile = ${BONDY_ETC_DIR}/ssl/server/cacert.pem
cluster.tls.server.certfile = ${BONDY_ETC_DIR}/ssl/server/keycert.pem
cluster.tls.server.keyfile = ${BONDY_ETC_DIR}/ssl/server/key.pem
cluster.tls.server.versions = 1.2,1.3
cluster.tls.server.verify = verify_none
cluster.tls.client.cacertfile = ${BONDY_ETC_DIR}/ssl/client/cacert.pem
cluster.tls.client.certfile = ${BONDY_ETC_DIR}/ssl/client/keycert.pem
cluster.tls.client.keyfile = ${BONDY_ETC_DIR}/ssl/client/key.pem
cluster.tls.client.versions = 1.2,1.3
cluster.tls.client.verify = verify_none

vm.async_thread.number = 64
## No vm.port.limit: the historical `erlang.max_ports = 65536` never reached
## the VM, and 65536 would cap total ports below the max_connections this file
## declares. The erts default is what this node has been running with.
load_regulation.router.pool.capacity = 1000000


oauth2.client_credentials_grant.duration = 15m
oauth2.code_grant.duration = 10m
oauth2.config_file = ${BONDY_ETC_DIR}/oauth2_config.json
oauth2.password_grant.duration = 15m
oauth2.refresh_token.duration = 30d
oauth2.refresh_token.length = 40
# platform_data_dir = ./data
# platform_etc_dir = ./etc
# platform_log_dir = ./log
# platform_tmp_dir = ./tmp
security.allow_anonymous_user = on
security.automatically_create_realms = off
security.config_file = ${BONDY_ETC_DIR}/security_config.json
shutdown.grace_period = 5s

listeners.wamp_tcp.transport = tcp
listeners.wamp_tcp.protocol = wamp_rawsocket
listeners.wamp_tcp.port = 18082

listeners.wamp_tcp.acceptors_pool_size = 200
listeners.wamp_tcp.backlog = 1024
listeners.wamp_tcp.keepalive = on
listeners.wamp_tcp.max_connections = 100000
listeners.wamp_tcp.nodelay = on
## Lingering off. Stated explicitly because the default is 1s: `-1` is the
## "do not linger" value, where `0` means abort the connection on close and
## discard anything unsent.
listeners.wamp_tcp.linger.timeout = -1

listeners.wamp_tls.transport = tls
listeners.wamp_tls.protocol = wamp_rawsocket
listeners.wamp_tls.port = 18085

listeners.wamp_tls.acceptors_pool_size = 200
listeners.wamp_tls.backlog = 1024
listeners.wamp_tls.tls.cacertfile = ${BONDY_ETC_DIR}/ssl/server/cacert.pem
listeners.wamp_tls.tls.certfile = ${BONDY_ETC_DIR}/ssl/server/keycert.pem
listeners.wamp_tls.tls.keyfile = ${BONDY_ETC_DIR}/ssl/server/key.pem
listeners.wamp_tls.keepalive = on
listeners.wamp_tls.max_connections = 100000
listeners.wamp_tls.nodelay = on
listeners.wamp_tls.tls.versions = 1.2,1.3
listeners.wamp_tls.tls.verify = verify_none




listeners.admin.websocket.compression_enabled = on
listeners.admin_api_https.websocket.compression_enabled = on
listeners.api_gateway_http.websocket.compression_enabled = on
listeners.api_gateway_https.websocket.compression_enabled = on

listeners.bridge_relay_tcp.transport = tcp
listeners.bridge_relay_tcp.protocol = bridge_relay
listeners.bridge_relay_tcp.port = 18092
listeners.bridge_relay_tcp.enabled = off

listeners.bridge_relay_tls.transport = tls
listeners.bridge_relay_tls.protocol = bridge_relay
listeners.bridge_relay_tls.port = 18093

listeners.bridge_relay_tls.tls.cacertfile = ${BONDY_ETC_DIR}/ssl/server/cacert.pem
listeners.bridge_relay_tls.tls.certfile = ${BONDY_ETC_DIR}/ssl/server/keycert.pem
listeners.bridge_relay_tls.tls.keyfile = ${BONDY_ETC_DIR}/ssl/server/key.pem
listeners.bridge_relay_tls.idle_timeout = 30s



listeners.wamp_tcp.proxy_protocol = off
listeners.wamp_tcp.proxy_protocol.mode = relaxed
listeners.api_gateway_http.proxy_protocol = on
listeners.api_gateway_http.proxy_protocol.mode = relaxed

listeners.admin.proxy_protocol = on
listeners.admin.proxy_protocol.mode = relaxed


vm.io.dirty_scheduler.number = 128


security.ticket.max_expiry_time = 30d
security.ticket.expiry_time = 30d
security.ticket.scope.local.persistence = on
security.ticket.scope.sso.persistence = on
security.ticket.scope.client_local.persistence = on
security.ticket.scope.client_sso.persistence = on
security.ticket.allow_not_found = on
security.ticket.authmethods = all

security.oidc.providers.oidc-mock.client_id=${OIDC_CLIENT_ID}
security.oidc.providers.oidc-mock.client_secret=${OIDC_CLIENT_SECRET}
security.oidc.providers.oidc-mock.redirect_path=/oidc/oidc-mock/callback
security.oidc.providers.oidc-mock.login_path=/oidc/login


## Distributed tracing: export spans to the monitoring stack Tempo
## (monitoring/docker-compose.yml, OTLP/HTTP on the schema default
## endpoint http://localhost:4318) and mint a W3C trace context at the
## router boundary for CALLs whose caller attached none.
tracing.otlp.enabled = on
tracing.mint.enabled = on
tracing.service_name = bondy-connect-node1
