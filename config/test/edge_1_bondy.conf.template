log.handlers.default.level = debug

## `admin` is the reserved name for the node's administrable listener: an
## operator declares it under this name rather than the historical
## `admin_api_http`, or the manager injects its own default in its place.
listeners.admin.transport = tcp
listeners.admin.protocol = http
listeners.admin.port = 19081
listeners.admin.start_phase = early
listeners.admin.services = admin_api, wamp_ws, admin, metrics
listeners.admin.acceptors_pool_size = 200
listeners.admin.max_connections = 250000

## Socket options go directly on `listeners.admin.*`, Cowboy ones under
## `listeners.admin.http.*`.
##
## `http.idle_timeout` and `http.active_n` are stated explicitly because
## Cowboy's own defaults differ from the values this listener has always run
## with: 60s rather than 15s, and `active_n` 1 rather than 100
## (`cowboy_http.erl:214,336`).
listeners.admin.backlog = 1024
listeners.admin.keepalive = off
listeners.admin.nodelay = on
listeners.admin.http.idle_timeout = 15s
listeners.admin.http.active_n = 100

listeners.admin_api_https.transport = tls
listeners.admin_api_https.protocol = http
listeners.admin_api_https.port = 19084
listeners.admin_api_https.start_phase = early
listeners.admin_api_https.services = admin_api, wamp_ws, admin, metrics
listeners.admin_api_https.enabled = off

listeners.admin_api_https.acceptors_pool_size = 200
listeners.admin_api_https.keepalive = off
listeners.admin_api_https.max_connections = 250000
## No certificate: a disabled listener is not checked for one. Uncomment these
## and point them at a real certificate before setting `enabled = on`.
# listeners.admin_api_https.tls.cacertfile = ${BONDY_ETC_DIR}/ssl/server/cacert.pem
# listeners.admin_api_https.tls.certfile = ${BONDY_ETC_DIR}/ssl/server/keycert.pem
# listeners.admin_api_https.tls.keyfile = ${BONDY_ETC_DIR}/ssl/server/key.pem

