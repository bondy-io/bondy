listeners.wamp_tls.port = 18085

## The same `ssl/server/` material the two HTTPS listeners above use. This
## listener previously pointed at `${BONDY_ETC_DIR}/ssl/{cacert,cert,key}.pem`,
## which does not exist in this template's certificate layout.
listeners.wamp_tls.tls.cacertfile = ${BONDY_ETC_DIR}/ssl/server/cacert.pem
listeners.wamp_tls.tls.certfile = ${BONDY_ETC_DIR}/ssl/server/keycert.pem
listeners.wamp_tls.tls.keyfile = ${BONDY_ETC_DIR}/ssl/server/key.pem
listeners.wamp_tls.acceptors_pool_size = 200
listeners.wamp_tls.backlog = 1024
listeners.wamp_tls.keepalive = on
listeners.wamp_tls.max_connections = 100000
listeners.wamp_tls.nodelay = on


## Every key here lands in etc/generated/vm.generated.args, which vm.args
## pulls in with -args_file.
vm.time_correction = on
vm.time_correction.warp_mode = multi_time_warp
vm.process.limit = 2000000
## No vm.port.limit: the historical `erlang.max_ports = 65536` never reached
## the VM, and 65536 would cap total ports below the max_connections this file
## declares. The erts default is what this node has been running with.
vm.async_thread.number = 64
vm.distribution.buffer_size = 32MB
vm.io.dirty_scheduler.number = 160
# vm.cpu.scheduler.busy_wait_threshold = none